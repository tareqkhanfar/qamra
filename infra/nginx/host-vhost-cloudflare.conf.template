# Host nginx site for Qamra behind Cloudflare (installed by infra/scripts/setup-cloudflare.sh; __DOMAIN__,
# __PORT__ and __CERT_DIR__ are replaced). Cloudflare holds the public certificate. It reaches this server on
# port 80 (SSL mode "Flexible") or on 443 with the self-signed origin certificate below (mode "Full"; for
# "Full (strict)" install a Cloudflare Origin Certificate in __CERT_DIR__ instead).

# The scheme the visitor used: Cloudflare sends X-Forwarded-Proto (https); without it, this connection's own.
map $http_x_forwarded_proto $qamra_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Requests on 443 for any other host name are refused at the handshake: the other sites on this server
# don't serve HTTPS, and must not start showing Qamra.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;  # nginx 1.24 on the server: the older form of `http2 on`
    listen [::]:443 ssl http2;
    server_name __DOMAIN__ www.__DOMAIN__;
    server_tokens off;

    ssl_certificate __CERT_DIR__/origin.crt;
    ssl_certificate_key __CERT_DIR__/origin.key;

    # The visitor's real address: Cloudflare puts it in CF-Connecting-IP, and only Cloudflare's own ranges may
    # set it (https://www.cloudflare.com/ips/). The Qamra edge's per-IP rate limits depend on it.
__CF_RANGES__
    real_ip_header CF-Connecting-IP;

    client_max_body_size 20m;  # child photos and drawings

    if ($host = www.__DOMAIN__) {
        return 301 https://__DOMAIN__$request_uri;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;  # the Qamra edge container, bound to localhost only
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite, never append: clients can't spoof it
        proxy_set_header X-Forwarded-Proto $qamra_proto;
        proxy_read_timeout 120s;
    }
}
