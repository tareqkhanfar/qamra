# Host nginx site for Qamra (installed by infra/scripts/setup-https.sh; __DOMAIN__ is replaced).
# certbot --nginx adds the TLS server block and the HTTP→HTTPS redirect to this file.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;
    client_max_body_size 20m;  # child photos and drawings

    location / {
        proxy_pass http://127.0.0.1:__PORT__;  # the Qamra edge container, bound to localhost only
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite, never append: clients can't spoof it
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
