{
  "name": "qamra",
  "brand": {
    "nameAr": "قمرة",
    "nameLatin": "Qamra",
    "tagline": "حكاية طفلك… تحت ضوء القمر",
    "logoDefault": "a-crescent-page",
    "logoFiles": "logo/qamra-mark-*.svg, logo/qamra-lockup-*.svg",
    "note": "amber-* tokens are the moon-gold family; alias moon-* = amber-* (same hex)"
  },
  "direction": "rtl",
  "moon": {
    "gold": "#F2B33D",
    "glow": "#FCEFD2",
    "night": "#22306A",
    "phaseComponent": "Moon(size, p 0..1, lit, dark) — waxing, lit side on the right",
    "createFlowProgress": "p = step / 12",
    "phases": {"new": 0, "crescent": 0.15, "quarter": 0.35, "half": 0.5, "gibbous": 0.75, "full": 1}
  },
  "companion": {
    "crayonPalette": ["#9B6FD1", "#F28C28", "#2FA597", "#FFD23F", "#C0265B"],
    "illustratedPalette": {"blob": "#A99BD6", "cat": "#F4A259", "robot": "#7FC4BB"},
    "keepsakeFrame": "#9A620A"
  },
  "color": {
    "light": {
      "night-950": "#0E1530",
      "night-900": "#16204A",
      "night-800": "#22306A",
      "night-700": "#33458F",
      "night-500": "#5B6FC0",
      "night-100": "#E4E8F7",
      "amber-700": "#9A620A",
      "amber-600": "#DB9A1F",
      "amber-500": "#F2B33D",
      "amber-300": "#F5C465",
      "amber-100": "#FCEFD2",
      "paper": "#FBF6EC",
      "paper-raised": "#FFFDF8",
      "paper-sunk": "#F3EAD8",
      "line": "#E4D6BC",
      "ink": "#1C2140",
      "ink-muted": "#585C72",
      "ink-faint": "#8A8DA0",
      "sage-700": "#3E6B4D",
      "sage-300": "#A9C7B1",
      "coral-700": "#A7432D",
      "coral-300": "#F4B3A2",
      "lav-700": "#5A4A9C",
      "lav-300": "#CBC1EA",
      "success": "#2E7A52",
      "success-bg": "#DDEFE3",
      "danger": "#B3261E",
      "danger-bg": "#F8DEDB",
      "warning": "#9A620A",
      "warning-bg": "#FCEFD2",
      "info": "#33458F",
      "info-bg": "#E4E8F7"
    },
    "dark": {
      "bg": "#0E1530",
      "surface": "#16204A",
      "surface-2": "#22306A",
      "line": "#2B3872",
      "ink": "#F6EFDF",
      "ink-muted": "#B9BEDA",
      "primary": "#F2B33D",
      "on-primary": "#0E1530",
      "accent-text": "#F5C465"
    },
    "semantic": {
      "bg": "paper",
      "surface": "paper-raised",
      "surface-sunk": "paper-sunk",
      "text": "ink",
      "text-muted": "ink-muted",
      "cta": "amber-500",
      "on-cta": "night-950",
      "primary": "night-900",
      "on-primary": "paper",
      "focus-ring": "amber-100"
    }
  },
  "contrast": {
    "ink/paper": 14.5,
    "ink-muted/paper": 6.1,
    "amber-700/paper": 4.7,
    "paper/night-900": 14.6,
    "night-950/amber-500": 9.7,
    "dark ink/bg": 15.7,
    "dark ink-muted/surface": 8.5
  },
  "font": {
    "display": ["Baloo Bhaijaan 2", "Tajawal", "system-ui", "sans-serif"],
    "body": ["IBM Plex Sans Arabic", "Segoe UI", "Tahoma", "sans-serif"],
    "mono": ["ui-monospace", "Menlo", "monospace"],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Baloo+Bhaijaan+2:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
  },
  "typeScale": {
    "display-xl": {"size": 64, "lineHeight": 1.15, "weight": 800, "family": "display"},
    "display-l": {"size": 48, "lineHeight": 1.2, "weight": 800, "family": "display"},
    "h1": {"size": 36, "lineHeight": 1.25, "weight": 700, "family": "display"},
    "h2": {"size": 28, "lineHeight": 1.3, "weight": 700, "family": "display"},
    "h3": {"size": 22, "lineHeight": 1.35, "weight": 700, "family": "display"},
    "body-l": {"size": 18, "lineHeight": 1.75, "weight": 400, "family": "body"},
    "body": {"size": 16, "lineHeight": 1.7, "weight": 400, "family": "body"},
    "small": {"size": 14, "lineHeight": 1.6, "weight": 500, "family": "body"},
    "caption": {"size": 13, "lineHeight": 1.5, "weight": 600, "family": "body"}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": {"sm": 12, "md": 16, "lg": 20, "xl": 24, "2xl": 28, "pill": 9999, "book": "16px 4px 4px 16px"},
  "shadow": {
    "1": "0 1px 2px rgba(22,32,74,0.06), 0 2px 8px rgba(22,32,74,0.06)",
    "2": "0 8px 24px rgba(22,32,74,0.12)",
    "book": "0 16px 40px rgba(22,32,74,0.18)",
    "lamp": "0 8px 28px rgba(242,179,61,0.45)"
  },
  "size": {"tap-min": 44, "button-lg": 56, "button-md": 48, "input": 52, "mobile-gutter": 16},
  "motion": {"twinkle": "2.4s ease-in-out infinite", "float": "3.2s ease-in-out infinite", "skeleton": "1.4s ease-in-out infinite", "reduced": "disable all loops under prefers-reduced-motion"},
  "print": {"trimMm": 210, "bleedMm": 3, "safeMm": 10, "artboardPx": 816, "trimInsetPx": 11, "safeInsetPx": 49, "dpi": 300}
}
