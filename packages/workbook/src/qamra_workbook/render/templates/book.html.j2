<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><title>{{ book.title_ar }}</title>
<style>
{% include "_base.css.j2" %}
{% include "_pages.css.j2" %}
{% if book.product == 'foundation' %}{% include "_workbook.css.j2" %}{% include "_workbook_cover.css.j2" %}{% endif %}
{% if book.product == 'journey' %}{% include "_workbook.css.j2" %}{% include "_journey.css.j2" %}{% endif %}
{% if book.product == 'family' %}{% include "_family.css.j2" %}{% include "family-book.css.j2" %}{% endif %}
{% if book.product == 'islamic' %}{% include "islamic-book.css.j2" %}{% endif %}
{% if book.product in ('journey', 'islamic') %}{% include "_stickers.css.j2" %}{% endif %}
{% if book.product in ('foundation', 'journey', 'family', 'islamic') %}{% include "_cover.css.j2" %}{% endif %}
</style></head>
<body data-names='{{ names|default([])|tojson }}'>
{% for p in pages %}
{% include "_page.html.j2" %}
{% endfor %}
</body></html>
