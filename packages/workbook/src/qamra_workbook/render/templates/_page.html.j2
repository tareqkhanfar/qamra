{% import "_ui.html.j2" as ui with context %}
{% set d = p.built.data %}
<section class="page type-{{ p.spec.type }} side-{{ p.side }} frame-{{ p.kind.frame }}{% if book.product == 'family' %} fam{% endif %}" dir="{{ p.spec.dir }}" lang="{{ p.spec.lang }}"
         data-page="{{ p.spec.id }}" style="--c: {{ p.style.color }}; --tint: {{ p.style.tint }}; --deep: {{ p.style.deep }};">
  {% if p.kind.frame == 'mission' %}{{ ui.wash(p, g) }}{% endif %}
  {%+ if p.kind.frame != 'sheet' %}{{ ui.tab(p, g) }}{% endif +%}
  <div class="safe">
    {% if p.kind.frame == 'mission' %}{{ ui.header(p) }}{% endif %}
    <main class="work">{% include p.kind.template %}</main>
    {% if p.parent %}{{ ui.parent_box(p) }}{% endif %}
    {%+ if p.kind.frame != 'sheet' %}{{ ui.footer(p) }}{% endif +%}
  </div>
</section>
