/* ==== «مغامراتي مع عائلتي», the whole book (W7): the front and back pages, adventures 3–12 and the insert
   sheets. Loaded after _family.css.j2 for family books only; scoped to .fam pages. ==== */

/* ---- the passport: 12 adventure stamps and the 7 badges */
.fam .pass { gap: 2.5mm; }
.fam .pass-body { padding: 2.5mm 5mm 2mm; }
.fam .pass-photo { width: 28mm; height: 31mm; }
.fam .pass-photo img { width: 40mm; top: 1.4mm; }
.fam .pass-fields { gap: 1.2mm 5mm; }
.fam .pf dd { font-size: 14pt; }
.fam .pf.sign dd { height: 6mm; }
.fam .pass-strip { height: 5mm; }
.fam .stamps-card { padding: 3mm 4mm 2mm; gap: 1mm; }
.fam .stamps-card .label { font-size: 11.5pt; }
.stamps-count { margin-inline-start: auto; font: 800 10pt var(--title); color: var(--muted); }
.fam .stamps { flex: none; gap: 0.6mm 1mm; align-content: start; }
.fam .stamps.adv { grid-template-columns: repeat(6, 1fr); }
.fam .stamps.badges { grid-template-columns: repeat(7, 1fr); }
.fam .slot { position: relative; }
.fam .stamps.adv .slot .seal { width: 19.5mm; height: 19.5mm; }
.fam .stamps.badges .slot .seal { width: 18.5mm; height: 18.5mm; }
.fam .slot-label { font-size: 7.5pt; max-width: 27mm; }
.slot-n { position: absolute; top: 0; inset-inline-start: 2.2mm; min-width: 5mm; height: 5mm; border-radius: 2.5mm; color: #FFFFFF;
          font: 800 8pt/5mm var(--title); text-align: center; padding: 0.3mm 1mm 0; z-index: 1; }
.badges-head { margin-top: 1.2mm; padding-top: 1.6mm; border-top: 0.4mm dashed var(--line); }

/* ---- the title page */
.type-title-page .foot { position: relative; z-index: 2; }
.tp { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; }
.tp-art { position: absolute; top: calc(-1 * var(--inset)); left: calc(-1 * var(--inset)); width: {{ g.page_w }}mm; height: {{ g.page_h }}mm; }
.tp-art > svg { width: 100%; height: 100%; }
.tp-top { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5mm; padding-top: 22mm; width: 100%; }
.tp-brand { display: inline-flex; align-items: center; gap: 1.8mm; height: 9mm; padding-inline: 2mm 4.5mm; border-radius: 4.5mm; background: #FFFFFF;
            box-shadow: 0 0 0 0.45mm var(--tint), 0 0.8mm 0 var(--tint); font: 800 13pt/1 var(--title); color: var(--deep); }
.tp-brand .mascot { width: 7.5mm; height: 7.5mm; }
.tp-brand i { width: 1.3mm; height: 1.3mm; border-radius: 50%; background: var(--c); opacity: .5; }
.tp-brand small { font: 600 10pt var(--body); color: var(--muted); }
.tp-title { font: 800 46pt/1.12 var(--title); color: var(--night); text-align: center; max-width: 172mm; text-shadow: 0 1.3mm 0 #FFFFFF; }
.tp-name { display: inline-block; max-width: 172mm; white-space: nowrap; overflow: hidden; color: #F08A3E; padding-inline: 2.5mm; vertical-align: bottom; }
.tp-sub { max-width: 172mm; white-space: nowrap; overflow: hidden; background: #FFFFFF; border-radius: 7mm; padding: 2.6mm 8mm 3mm;
          font: 600 15pt/1.5 var(--body); color: var(--ink); box-shadow: 0 1.2mm 0 var(--tint), 0 0 0 0.6mm var(--tint); }
.tp-adv { display: flex; flex-direction: column; align-items: center; gap: 2mm; }
.tp-count { font: 800 12.5pt/1 var(--title); color: var(--deep); }
.tp-dots { display: flex; gap: 1.8mm; }
.tp-dots span { width: 10mm; height: 10mm; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #FFFFFF;
                box-shadow: 0 0 0 0.6mm #FFFFFF, 0 0.8mm 0 0.6mm rgba(28,33,64,0.1); }
.tp-dots .ico { width: 5.8mm; height: 5.8mm; }
.tp-family { position: absolute; left: 0; right: 0; bottom: 19mm; height: 118mm; }
.tp-family > svg { position: absolute; inset: 0; width: 100%; height: 100%; }

/* ---- the contents map */
.tocpg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.map-card { flex: 1; display: flex; align-items: center; justify-content: center; padding: 4mm 0 2mm; min-height: 0;
            background: linear-gradient(#FFFFFF, #FBF6EA); overflow: visible; }
.map { position: relative; width: 185mm; flex: none; }
.map > svg { position: absolute; left: 0; top: 0; width: 186mm; height: 100%; }
.map-start { position: absolute; display: inline-flex; align-items: center; gap: 1mm; font: 700 8.5pt var(--body); color: var(--deep); white-space: nowrap; }
.map-start .ico { width: 4.2mm; height: 4.2mm; color: var(--c); }
.stop { position: absolute; width: 0; height: 0; }
.stop-ico { position: absolute; left: -4.2mm; top: -4.2mm; width: 8.4mm; height: 8.4mm; color: #FFFFFF; }
.stop-ico .ico { width: 100%; height: 100%; }
.stop-k { position: absolute; left: 5.6mm; top: -12.4mm; min-width: 6.4mm; height: 6.4mm; border-radius: 3.2mm; background: #FFFFFF; color: var(--sd);
          box-shadow: 0 0 0 0.5mm var(--sc); font: 800 9pt/6.4mm var(--title); text-align: center; padding: 0.3mm 1mm 0; }
.stop-star { position: absolute; left: -15.5mm; top: -10mm; }
.stop-star-svg { width: 7.5mm; height: 7.5mm; }
.stop-title { position: absolute; top: 11.6mm; left: -26mm; width: 52mm; text-align: center; white-space: nowrap; overflow: hidden;
              font: 800 10.5pt/1.3 var(--title); color: var(--sd); }
.stop-page { display: inline-block; height: 5.2mm; padding: 0 2mm; border-radius: 2.6mm; background: var(--tint); color: var(--deep);
             font: 700 8.5pt/5.2mm var(--body); white-space: nowrap; }
.stop .stop-page { position: absolute; top: 17.6mm; left: 0; transform: translateX(-50%); background: #FFFFFF; box-shadow: 0 0 0 0.35mm var(--sc); color: var(--sd); }
.toc-extras { flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; }
.toc-extra { display: flex; flex-direction: column; align-items: center; gap: 1.2mm; padding: 2.6mm 2mm 2.4mm; min-width: 0; }
.toc-extra b { font: 700 10pt/1.25 var(--body); color: var(--ink); white-space: nowrap; overflow: hidden; max-width: 100%; }
.tx-ico { width: 10mm; height: 10mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.tx-ico .ico { width: 6mm; height: 6mm; }

/* ---- «عائلتي»: a portrait for everyone in the house */
.fhouse { position: relative; flex: 1; display: flex; flex-direction: column; min-height: 0; }
.fh-roof { flex: none; width: 100%; height: 30mm; margin-bottom: -0.6mm; }
.fh-sign { position: absolute; top: 15.5mm; left: 50%; transform: translateX(-50%); height: 9.4mm; max-width: 112mm; padding: 0 6mm;
           border-radius: 4.7mm; background: #FFFFFF; font: 800 13pt/9.8mm var(--title); color: var(--deep); white-space: nowrap; overflow: hidden;
           box-shadow: 0 0.8mm 0 rgba(28,33,64,0.14); }
.fh-body { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(var(--cols), 1fr); grid-template-rows: repeat(var(--rows), 1fr);
           gap: 4mm 4.5mm; padding: 5mm 5mm 4.5mm; background: #FFFCF4; border-radius: 0 0 6mm 6mm; }
.portrait { display: flex; flex-direction: column; align-items: center; gap: 1.8mm; min-height: 0; }
.pt-frame { flex: 1; width: 100%; min-height: 0; display: flex; padding: 2.6mm; border-radius: 5mm; background: #FFFFFF;
            border: 1.5mm solid var(--fc); box-shadow: inset 0 0 0 0.6mm #FFFFFF, inset 0 0 0 1mm var(--fc), 0 1mm 0 rgba(28,33,64,0.1); }
.pt-face { flex: 1; border-radius: 50%; border: 0.5mm dashed #D8CBB0; display: flex; align-items: flex-end; justify-content: center; }
.pt-face small { font: 600 8pt var(--body); color: #B5A88A; margin-bottom: 3mm; }
.pt-plate { flex: none; width: 92%; min-height: 12.5mm; display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 0.2mm; background: #FFFFFF; border-radius: 3mm; box-shadow: 0 0 0 0.5mm var(--fc); padding: 1mm 2mm; }
/* the name printed light, for the child to write over (text stroke would print as a Type 3 font) */
.pt-name { font: 800 15pt/1.2 var(--title); color: color-mix(in srgb, var(--fc) 52%, #FFFFFF); white-space: nowrap; overflow: hidden;
           max-width: 100%; }
.pt-role { font: 600 8pt/1.75 var(--body); color: var(--muted); white-space: nowrap; overflow: hidden; max-width: 100%; }  /* 1.75: the clip kept the dots of a final ي («سيدي» printed «سيدى») */
.portrait.me .pt-frame { border-width: 1.9mm; }
.portrait.more .pt-frame { border-style: dashed; border-width: 0.8mm; box-shadow: none; }
.portrait.more .pt-plate .write-line { width: 80%; height: 6mm; }

/* ---- drawing frames */
.portrait-frame { position: relative; flex: 1; min-height: 0; margin: 2mm 8mm 0; padding: 7mm; border-radius: 4mm;
                  background: linear-gradient(135deg, #F7D774, #E9A62B 45%, #F7D774 55%, #D99A26);
                  box-shadow: 0 1.4mm 0 #B27A0C, inset 0 0 0 1.2mm rgba(255,255,255,0.45); }
.pf-inner { width: 100%; height: 100%; border-radius: 2mm; background: #FFFFFF; box-shadow: inset 0 0 0 0.6mm #D99A26, inset 0 0 0 2.4mm #FFF7E3; }
.pf-star { position: absolute; width: 11mm; height: 11mm; }
.pf-star svg { width: 100%; height: 100%; }
.pf-star.tl { left: -3mm; top: -3mm; } .pf-star.tr { right: -3mm; top: -3mm; }
.pf-star.bl { left: -3mm; bottom: -3mm; } .pf-star.br { right: -3mm; bottom: -3mm; }
.pf-plate { flex: none; align-self: center; margin-top: -8mm; position: relative; height: 13mm; min-width: 70mm; max-width: 140mm; padding: 0 9mm;
            border-radius: 3mm; background: var(--c); color: #FFFFFF; display: flex; align-items: center; justify-content: center;
            box-shadow: 0 1mm 0 var(--deep); }
.pf-plate b { font: 800 22pt/1 var(--title); white-space: nowrap; overflow: hidden; padding-top: 1.4mm; }
.pf-lines { flex: none; display: flex; gap: 6mm; }
.pf-line { flex: 1; display: flex; align-items: flex-end; gap: 2mm; }
.pf-line .label { white-space: nowrap; }
.pf-line .write-line { flex: 1; }

.cup-row { flex: 1; min-height: 0; display: flex; gap: 4mm; }
.cup-card { flex: 1.4; display: flex; align-items: center; justify-content: center; padding: 4mm; }
.cup-art { height: 100%; aspect-ratio: 90 / 120; max-width: 100%; }
.cup-art svg { width: 100%; height: 100%; }
.cup-side { flex: 1; display: flex; flex-direction: column; gap: 3mm; }
.cup-level { display: flex; align-items: center; gap: 2.4mm; padding: 3mm 4mm; }
.cup-level .stars { height: 5mm; width: auto; }
.cup-level b { font: 800 14pt var(--title); color: var(--deep); }
.cup-level.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.cup-ideas { flex: 1; padding: 3.5mm 4mm; display: flex; flex-direction: column; gap: 3mm; }
.cup-swatches { display: flex; flex-wrap: wrap; gap: 2.4mm; }
.cup-swatches span { width: 11mm; height: 11mm; border-radius: 50%; border: 0.5mm solid #D8CBB0; }

.art-frame { display: flex; align-items: stretch; justify-content: stretch; padding: 4mm; overflow: hidden; }
.frame-art { flex: 1; min-height: 0; }
.frame-art svg { width: 100%; height: 100%; }
.frame-landscape .draw-kid { height: 40mm; }
.room-things { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 3mm; padding: 3mm 4.5mm; }
.room-things .label .stars { height: 4.4mm; width: auto; }
.thing-slots { display: flex; gap: 3mm; }
.thing-slots span { width: 17mm; height: 17mm; border-radius: 50%; border: 0.5mm dashed #D8CBB0; background: #FFFFFF; }

.word-cards { flex: 1; min-height: 0; display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: 1fr 1fr; gap: 4mm; }
.word-card { display: flex; flex-direction: column; align-items: stretch; gap: 2mm; padding: 3mm 3.5mm; min-height: 0; }  /* stretch: the base .word-card centres, which left the drawing box 0 wide */
.word-card.lvl1 { grid-row: 1 / 3; }
.word-card.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.wc-head { display: flex; align-items: center; justify-content: space-between; }
.wc-head .stars { height: 4.6mm; width: auto; }
.wc-draw { position: relative; flex: 1; border-radius: 4mm; background: #FFFFFF; border: 0.4mm dashed #EADFC8; }
.wc-line { display: flex; align-items: flex-end; gap: 2mm; }
.wc-line small { font: 700 10pt var(--body); color: var(--muted); white-space: nowrap; }
.wc-line .write-line { flex: 1; }

.frame-rules .draw-card { flex: 1.5; }
.rules-card { flex: none; padding: 3mm 4.5mm; display: flex; flex-direction: column; gap: 0.5mm; }
.rule-line { display: flex; align-items: flex-end; gap: 2mm; }
.rule-line .label { white-space: nowrap; }
.rule-line .label .stars { height: 4.2mm; width: auto; }
.rule-line .write-line { flex: 1; }
.draw-caption .label .stars { height: 4.2mm; width: auto; }

.idcard { flex: 1; min-height: 0; display: flex; flex-direction: column; border-radius: 7mm; overflow: hidden; background: #FFFFFF;
          border: 0.7mm solid var(--c); box-shadow: 0 1.4mm 0 var(--tint); }
.id-band { flex: none; height: 16mm; display: flex; align-items: center; gap: 3mm; padding-inline: 6mm; background: var(--c); color: #FFFFFF; }
.id-band .ico { width: 8mm; height: 8mm; }
.id-band b { font: 800 18pt/1 var(--title); padding-top: 1.4mm; }
.id-band span { margin-inline-start: auto; font: 600 10pt var(--body); opacity: 0.9; }
.id-body { flex: 1; min-height: 0; display: flex; gap: 6mm; padding: 6mm; }
.id-photo { width: 78mm; flex: none; border-radius: 5mm; border: 0.6mm dashed var(--c); background: #FBF9FE; display: flex; align-items: flex-end;
            justify-content: center; padding-bottom: 3mm; }
.id-photo small { display: inline-flex; align-items: center; gap: 1mm; font: 700 9pt var(--body); color: var(--deep); }
.id-photo .ico { width: 4.4mm; height: 4.4mm; }
.id-fields { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 3mm; min-width: 0; }
.id-field { display: flex; flex-direction: column; gap: 1mm; }
.id-field small { display: inline-flex; align-items: center; gap: 1.2mm; font: 700 10pt var(--body); color: var(--muted); }
.id-field small .stars { height: 4mm; width: auto; }
.id-field b { font: 800 20pt/1.3 var(--title); color: var(--night); white-space: nowrap; overflow: hidden; border-bottom: 0.45mm solid var(--line); }

/* ---- sequence cards: the day, a story from pictures, a chain of moves */
.seqpg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.daybar { flex: none; display: flex; align-items: center; gap: 3mm; padding: 0 2mm; font: 800 12pt var(--title); color: var(--deep); }
.daybar span { display: inline-flex; align-items: center; gap: 1.5mm; white-space: nowrap; }
.daybar .ico { width: 7mm; height: 7mm; color: var(--c); }
.daybar i { flex: 1; height: 2.4mm; border-radius: 1.2mm; background: linear-gradient(to left, #F7D774, #F5B06B, #8C6CCB, #3C468F); }
.daycards { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 7mm 4mm; padding-top: 3mm; }
.daycards.n4 { grid-template-columns: repeat(2, 1fr); }
.daycard { position: relative; display: flex; flex-direction: column; align-items: center; gap: 1.5mm; padding: 8mm 3mm 3mm; min-height: 0; }
.daycard.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.dc-level { position: absolute; top: 2.5mm; inset-inline-start: 3mm; }
.dc-level .stars { height: 4.4mm; width: auto; }
.dc-pic { flex: 1; min-height: 0; width: 100%; display: flex; align-items: center; justify-content: center; }
.dc-pic svg { height: 100%; max-height: 40mm; width: auto; aspect-ratio: 1; }
.daycard b { font: 700 12.5pt/1.3 var(--body); color: var(--ink); text-align: center; }
.panels { flex: 1.5; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; padding-top: 3mm; }
.panel { position: relative; display: flex; flex-direction: column; gap: 1mm; padding: 8mm 3mm 3mm; min-height: 0; }
.panel-pic { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; background: #F7FBFE; border-radius: 4mm; }
.panel-pic svg { width: 100%; height: 100%; max-height: 52mm; }
.panel .write-line { height: 8mm; }
.ending { flex: 1; display: flex; flex-direction: column; gap: 2mm; padding: 3mm 4.5mm; min-height: 0; }
.ending .label .stars { height: 4.4mm; width: auto; }
.ending-draw { flex: 1; border-radius: 4mm; border: 0.4mm dashed #EADFC8; background: #FFFFFF; }
.fcard.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.moves { flex: 1; min-height: 0; display: flex; flex-wrap: wrap; align-content: space-evenly; justify-content: center; gap: 4mm 2mm; }
.move { width: 43mm; height: 58mm; display: flex; flex-direction: column; align-items: center; gap: 1mm; padding: 3mm; }
.move-head { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.move-head .stars { height: 4.2mm; width: auto; }
.move-pic { flex: 1; min-height: 0; width: 100%; display: flex; align-items: center; justify-content: center; }
.move-pic svg { height: 100%; width: auto; aspect-ratio: 40 / 50; }
.move b { font: 800 13pt/1.2 var(--title); color: var(--deep); text-align: center; }
.move.mine { border-style: dashed; }
.move-pic.draw-here { border: 0.4mm dashed #EADFC8; border-radius: 4mm; }
.move-arrow { display: none; }

/* ---- the routine builder */
.routinepg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.routine-parts { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }
.rpart { display: flex; flex-direction: column; gap: 2mm; padding: 3mm 4mm 4mm; min-height: 0; }
.rpart.morning { background: linear-gradient(#FFF7DC, #FFFFFF 40%); }
.rpart.evening { background: linear-gradient(#E8EAF8, #FFFFFF 40%); }
.rpart-head { display: flex; align-items: center; gap: 2mm; }
.rpart-head b { font: 800 15pt var(--title); color: var(--ink); }
.rpart-ico { width: 10mm; height: 10mm; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #F2B33D; }
.evening .rpart-ico { background: #3C468F; }
.rpart-ico .ico { width: 6.4mm; height: 6.4mm; }
.rslots { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 2mm 3mm; align-content: space-evenly; justify-items: center; }
.rslot { position: relative; display: flex; flex-direction: column; align-items: center; }
.rslot-n { position: absolute; top: -2mm; inset-inline-start: -2.5mm; width: 7.5mm; height: 7.5mm; border-radius: 50%; background: var(--c); color: #FFFFFF;
           font: 800 11pt/7.5mm var(--title); text-align: center; padding-top: 0.5mm; z-index: 1; }
.rslot-box { border-radius: 4mm; border: 0.6mm dashed var(--c); background: #FFFFFF; display: flex; align-items: flex-end; justify-content: center;
             padding-bottom: 1.2mm; flex: none; }
.rslot-box small { font: 600 7pt var(--body); color: #B5A88A; }
.rslot.lvl2 .rslot-box { border-color: #E8C77F; }
.rslot-lvl { position: absolute; bottom: -2mm; inset-inline-end: -3mm; background: #FFFFFF; border-radius: 2mm; padding: 0 0.6mm; }
.rslot-lvl .stars { height: 4.2mm; width: auto; }
.rweek { flex: none; padding: 3mm 4mm; display: flex; flex-direction: column; gap: 2.5mm; }
.rweek-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2mm; }
.rday { display: flex; flex-direction: column; align-items: center; gap: 1.2mm; }
.rday small { font: 700 9pt var(--body); color: var(--ink-2); }
.rtick { width: 10mm; height: 10mm; border-radius: 50%; border: 0.5mm solid #F2B33D; color: #F2B33D; display: flex; align-items: center; justify-content: center; }
.rtick.moon { border-color: #8E96CF; color: #8E96CF; }
.rtick .ico { width: 5.5mm; height: 5.5mm; opacity: 0.5; }

/* ---- the chore chart */
.chorepg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.chart { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 2.5mm; padding: 3.5mm 4mm; }
.chart-title { display: flex; align-items: center; gap: 2mm; color: var(--deep); }
.chart-title .ico { width: 7mm; height: 7mm; color: var(--c); }
.chart-title b { font: 800 15pt var(--title); white-space: nowrap; overflow: hidden; max-width: 150mm; }
.chart-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: 44mm repeat(var(--days), 1fr); grid-auto-rows: auto; gap: 1.5mm; align-content: stretch; }
.ch-head { font: 700 9.5pt var(--body); color: var(--deep); text-align: center; padding: 1.4mm 0; background: var(--tint); border-radius: 2.5mm; }
.ch-head.task { text-align: start; padding-inline: 3mm; }
.ch-task { display: flex; align-items: center; gap: 1.5mm; padding: 1.5mm 2mm; border-radius: 3mm; background: #FFFCF6; border: 0.4mm solid var(--line); min-height: 26mm; }
.ch-task .stars { height: 4mm; width: auto; flex: none; }
.ch-draw { flex: 1; align-self: stretch; border-radius: 2.5mm; border: 0.4mm dashed #D8CBB0; background: #FFFFFF; }
.ch-cell { display: flex; align-items: center; justify-content: center; border-radius: 3mm; background: #FFFFFF; border: 0.4mm solid var(--line-soft); }
.ch-task.lvl2, .ch-cell.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.ch-slot { border-radius: 50%; border: 0.5mm dashed #E0CFA8; display: flex; align-items: center; justify-content: center; }
.ch-star { width: 70%; height: 70%; }
.ideas { flex: none; display: flex; flex-direction: column; gap: 2mm; padding: 3mm 4mm; }
.idea-row { display: flex; justify-content: space-between; gap: 2mm; }
.idea { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.8mm; }
.idea-pic { width: 14mm; height: 14mm; }
.idea small { font: 700 8.5pt/1.2 var(--body); color: var(--ink-2); text-align: center; }
.chore-reward { flex: none; display: flex; align-items: flex-end; gap: 3mm; padding: 3mm 4.5mm; background: #FFF8E6; border-color: #F3C75E; }
.reward-ico.small { width: 11mm; height: 11mm; }
.reward-ico.small .ico { width: 7mm; height: 7mm; }
.chore-reward .label { white-space: nowrap; }
.chore-reward .write-line { flex: 1; }

/* ---- nature bingo */
.bingopg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.bingo-legend { flex: none; display: flex; align-items: center; justify-content: center; gap: 5mm; padding: 2.4mm 4mm; }
.bingo-legend span { display: inline-flex; align-items: center; gap: 1.5mm; font: 700 10.5pt var(--body); color: var(--ink-2); }
.bingo-legend .stars { height: 4.4mm; width: auto; }
.bl-sep { width: 0.4mm; height: 6mm; background: var(--line); }
.bl-ico .ico { width: 5.5mm; height: 5.5mm; color: var(--c); }
.bingo-cards { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }
.bingo { display: flex; flex-direction: column; gap: 2mm; padding: 3mm; min-height: 0; }
.bingo.mine { border-color: var(--c); border-width: 0.7mm; }
.bingo-head { display: flex; align-items: center; justify-content: space-between; gap: 2mm; padding-inline: 1mm; }
.bingo-head b { font: 800 17pt/1 var(--title); color: var(--c); }
.bingo-head span { font: 700 10.5pt var(--body); color: var(--deep); white-space: nowrap; overflow: hidden; max-width: 50mm; }
.bingo-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); grid-template-rows: repeat(var(--n), 1fr); gap: 1.5mm; }
.bcell { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5mm; border-radius: 3mm;
         border: 0.45mm solid var(--line); background: #FFFFFF; padding: 1.5mm 1mm 1mm; min-height: 0; }
.bpic { width: 17mm; height: 17mm; }
.bcell small { font: 700 8pt/1.1 var(--naskh); color: var(--ink-2); white-space: nowrap; }
.bmark { position: absolute; top: 1mm; inset-inline-start: 1mm; width: 4.4mm; height: 4.4mm; color: var(--c); opacity: 0.7; }
.bmark .ico { width: 100%; height: 100%; }
.bcell.free { background: var(--tint); border-color: transparent; }
.free-star { width: 13mm; height: 13mm; }
.bcell.free small { font: 800 9pt var(--title); color: var(--deep); }

/* ---- picture talk */
.talkpic { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.ba-head { flex: none; display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 3mm; }
.ba-tag { justify-self: center; display: inline-flex; align-items: center; gap: 1.4mm; height: 7.6mm; padding: 0 3.5mm; border-radius: 3.8mm;
          background: var(--tint); color: var(--deep); font: 800 11.5pt/1 var(--title); }
.ba-tag .stars { height: 4mm; width: auto; } .ba-tag .ico { width: 5mm; height: 5mm; }
.ba-tag.now { background: var(--c); color: #FFFFFF; }
.ba-row { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 3mm; }
.ba-box { display: flex; align-items: flex-end; justify-content: center; padding: 2mm; border-style: dashed; min-height: 0; }
.ba-box small { display: inline-flex; align-items: center; gap: 1mm; font: 600 8.5pt var(--body); color: #B5A88A; }
.ba-box small .ico { width: 4mm; height: 4mm; }
.ba-now { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1mm; padding: 2mm; background: #F7FBFE; min-height: 0; overflow: hidden; }
.ba-pic { flex: 1; min-height: 0; width: 100%; display: flex; justify-content: center; }
.ba-pic svg { height: 100%; max-height: 38mm; width: auto; aspect-ratio: 1; }
.ba-now b { font: 700 10.5pt var(--body); color: var(--ink); }
.ba-why { flex: none; display: flex; align-items: flex-end; gap: 2mm; }
.ba-why .label .stars, .sentences .label .stars, .kind-act .label .stars, .spart .label .stars, .feel-row .label .stars,
.second-end .label .stars { height: 4.2mm; width: auto; }
.ba-why .write-line { flex: 1; }
.scene-card { flex: 1; min-height: 0; padding: 3mm; display: flex; }
.scene-card > svg { inset: 3mm; width: calc(100% - 6mm); height: calc(100% - 6mm); }  /* the base rule positions it absolutely: stay inside the card (RTL) */
.qchips { flex: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 2.5mm; }
.qchip { display: inline-flex; align-items: center; gap: 1.6mm; height: 9.5mm; padding-inline: 1.4mm 4mm; border-radius: 4.75mm; background: #FFFFFF;
         box-shadow: 0 0 0 0.45mm var(--c); font: 700 12pt var(--body); color: var(--ink); }
.qchip i { width: 7mm; height: 7mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.qchip i .ico { width: 4.4mm; height: 4.4mm; }
.sentences { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 3mm; padding: 3mm 4.5mm; }
.sent-stars { display: flex; gap: 2mm; direction: rtl; }
.sent-stars span { position: relative; display: flex; }
.sent-star { width: 11mm; height: 11mm; }
.sent-stars small { position: absolute; left: 50%; top: 56%; transform: translate(-50%, -50%); font: 800 8pt var(--title); color: #E2A32A; }
.bubbles { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 1fr; gap: 4mm; }
.bub { display: flex; flex-direction: column; gap: 2mm; padding: 3mm; min-height: 0; }
.bub-say { position: relative; flex: 1; min-height: 0; border-radius: 7mm; border: 0.6mm solid var(--c); background: #FFFFFF; display: flex;
           flex-direction: column; justify-content: flex-end; gap: 1mm; padding: 3mm 5mm 4mm; }
.bub-say::after { content: ""; position: absolute; bottom: -3.2mm; inset-inline-start: 12mm; width: 5mm; height: 5mm; background: #FFFFFF;
                  border-right: 0.6mm solid var(--c); border-bottom: 0.6mm solid var(--c); transform: rotate(45deg); }
.bub-line { height: 7mm; border-bottom: 0.45mm dashed #CDBF9F; }
.bub-who { flex: none; display: flex; align-items: center; gap: 2mm; }
.bub-art { width: 22mm; height: 22mm; flex: none; }
.bub-art svg { width: 100%; height: 100%; }
.bub-who b { font: 800 12.5pt/1.2 var(--title); color: var(--deep); }
.bub-who .stars { height: 4.2mm; width: auto; }
.kind-act { flex: 0.8; min-height: 0; display: flex; flex-direction: column; gap: 2mm; padding: 3mm 4.5mm; }
.kind-draw, .spart-draw { flex: 1; border-radius: 4mm; border: 0.4mm dashed #EADFC8; background: #FFFFFF; }
.roles-pick { flex: none; padding: 3mm 4mm; display: flex; flex-direction: column; gap: 2mm; }
.role-thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2mm; }
.role-thumb { display: flex; flex-direction: column; align-items: center; gap: 0.8mm; background: #FFFCF6; border-radius: 4mm; padding: 1.5mm 1mm 2mm; }
.rt-art { width: 22mm; height: 25.7mm; }
.rt-art svg { width: 100%; height: 100%; }
.role-thumb b { font: 700 9pt/1.2 var(--body); color: var(--ink); text-align: center; }
.role-thumb .check-box { width: 5.5mm; height: 5.5mm; border-radius: 50%; }
.places { flex: none; display: flex; align-items: center; gap: 3mm; padding: 3mm 4mm; }
.places .label { white-space: nowrap; }
.place-chips { flex: 1; display: flex; flex-wrap: wrap; gap: 2mm; }
.place-chips span { display: inline-flex; align-items: center; gap: 1.2mm; height: 8mm; padding-inline: 1.2mm 3mm; border-radius: 4mm; background: var(--tint);
                    font: 700 10pt var(--body); color: var(--deep); }
.place-chips .check-box { width: 5.4mm; height: 5.4mm; border-radius: 50%; }
.scene-parts { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; }
.spart { display: flex; flex-direction: column; gap: 2mm; padding: 3mm; min-height: 0; }

/* ---- feelings faces and matching */
.facespg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.face-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 4mm; }
.fface { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5mm; padding: 3mm; min-height: 0; }
.ff-level { position: absolute; top: 2.5mm; inset-inline-start: 3mm; }
.ff-level .stars { height: 4.2mm; width: auto; }
.ff-svg { flex: 1; min-height: 0; display: flex; justify-content: center; }
.ff-svg svg { height: 100%; max-height: 36mm; width: auto; aspect-ratio: 1; }
.fface b { font: 800 15pt/1.2 var(--title); color: var(--deep); }
.ff-mirror { display: inline-flex; align-items: center; gap: 1.2mm; font: 600 9pt var(--body); color: var(--muted); }
.ff-mirror .check-box { width: 5.4mm; height: 5.4mm; }
.ff-mirror .ico { width: 4.4mm; height: 4.4mm; color: var(--c); }
.my-face { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 3mm 6mm; }
.mf-circle { width: 30mm; height: 30mm; border-radius: 50%; border: 0.6mm dashed var(--c); background: #FFFFFF; }
.matchpg { flex: 1; display: flex; min-height: 0; }
.match-left { width: 88mm; flex: none; display: flex; flex-direction: column; gap: 2.5mm; }
.sit { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; gap: 2.5mm; padding: 2mm 3mm; }
.sit-level { position: absolute; top: 1.5mm; inset-inline-start: 2mm; }
.sit-level .stars { height: 3.8mm; width: auto; }
.sit-pic { height: 100%; max-height: 24mm; aspect-ratio: 1; flex: none; }
.sit-pic svg { width: 100%; height: 100%; }
.sit b { font: 700 11pt/1.35 var(--body); color: var(--ink); }
.sit .sort-dot { inset-inline-end: -2.5mm; }
.match-right { width: 56mm; flex: none; display: flex; flex-direction: column; justify-content: space-between; gap: 2.5mm; }
.mface { position: relative; flex: 1; min-height: 0; max-height: 36mm; display: flex; align-items: center; gap: 3mm; padding: 2mm 4mm; }
.mface .sort-dot { inset-inline-start: -2.5mm; }
.mf-svg { height: 100%; max-height: 24mm; aspect-ratio: 1; }
.mf-svg svg { width: 100%; height: 100%; }
.mface b { font: 800 13pt var(--title); color: var(--deep); }

/* ---- finish the story / the sentence */
.finishpg { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.fs-row { flex: 1; min-height: 0; display: flex; align-items: stretch; gap: 3mm; padding: 3mm 4mm; }
.fs-face { width: 22mm; flex: none; display: flex; align-items: center; }
.fs-face svg { width: 22mm; height: 22mm; }
.fs-body { flex: 1; display: flex; flex-direction: column; gap: 1.5mm; min-width: 0; }
.fs-body b { font: 800 13pt/1.3 var(--title); color: var(--deep); }
.fs-draw { flex: 1; border-radius: 3.5mm; border: 0.4mm dashed #EADFC8; background: #FFFFFF; }
.fs-level .stars { height: 4.4mm; width: auto; }
.story-card { position: relative; flex: none; padding: 4mm 6mm 4mm 22mm; background: #FFFCF4; }
.story-moon { position: absolute; left: 3mm; top: 3mm; width: 15mm; height: 15mm; }
.story-text p { font: 600 13pt/1.7 var(--naskh); color: var(--ink); }
.story-strip { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 3mm; }
.story-panel { position: relative; display: flex; flex-direction: column; padding: 3mm; min-height: 0; }
.story-panel .pill-num { position: absolute; top: 2mm; inset-inline-start: 2mm; z-index: 1; }
.sp-pic { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; background: #F7FBFE; border-radius: 3.5mm; }
.sp-pic svg { width: 100%; height: 100%; max-height: 50mm; }
.story-panel.end { border-style: dashed; border-color: var(--c); }
.sp-draw { flex: 1; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 2mm; }
.sp-draw small { display: inline-flex; align-items: center; gap: 1mm; font: 700 9pt var(--body); color: var(--deep); }
.sp-draw .ico { width: 4.4mm; height: 4.4mm; }
.second-end { flex: none; padding: 3mm 4.5mm; display: flex; flex-direction: column; gap: 0.5mm; }
.feel-row { flex: none; display: flex; align-items: center; gap: 5mm; padding: 3mm 4.5mm; }
.feel-row .label { white-space: nowrap; }
.feel-who { display: flex; align-items: center; gap: 1.5mm; }
.feel-who b { font: 800 11pt var(--title); color: var(--deep); margin-inline-end: 1mm; }
.fw-face svg { width: 10mm; height: 10mm; }

/* ---- the interview */
.interview { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.iv-top { flex: none; display: flex; gap: 3.5mm; height: 46mm; }
.iv-portrait { width: 52mm; flex: none; display: flex; flex-direction: column; gap: 1.5mm; padding: 2.5mm; }
.iv-face { flex: 1; border-radius: 50% 50% 4mm 4mm; border: 0.5mm dashed var(--c); background: #FBF9FE; display: flex; align-items: flex-end;
           justify-content: center; padding-bottom: 1.5mm; }
.iv-face small { display: inline-flex; align-items: center; gap: 1mm; font: 600 8pt var(--body); color: var(--deep); }
.iv-face .ico { width: 4mm; height: 4mm; }
.iv-portrait b { font: 800 12pt var(--title); color: var(--deep); text-align: center; white-space: nowrap; overflow: hidden; }
.iv-mic { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2mm; background: var(--tint); border-color: transparent; }
.iv-mic-ico { width: 18mm; height: 18mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.iv-mic-ico .ico { width: 11mm; height: 11mm; }
.iv-mic b { font: 800 18pt var(--title); color: var(--deep); }
.iv-mic small { font: 700 11pt var(--body); color: var(--ink-2); white-space: nowrap; overflow: hidden; max-width: 110mm; }
.iv-questions { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 3mm; }
.iv-q { display: flex; flex-direction: column; gap: 1.5mm; padding: 2.5mm 3mm; min-height: 0; }
.iv-q-head { display: flex; align-items: center; gap: 1.5mm; }
.iv-q-head b { flex: 1; font: 700 11pt/1.3 var(--body); color: var(--ink); }
.iv-q-ico { width: 6.5mm; height: 6.5mm; color: var(--c); flex: none; }
.iv-q-ico .ico { width: 100%; height: 100%; }
.iv-level .stars { height: 3.8mm; width: auto; }
.iv-answer { flex: 1; border-radius: 3mm; border: 0.4mm dashed #EADFC8; background: #FFFFFF; }

/* ---- family game night */
.gamespg { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.howto { flex: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; }
.how { display: flex; align-items: center; gap: 2mm; padding: 2.5mm 3mm; font: 700 10.5pt/1.35 var(--body); color: var(--ink); }
.deck { flex: none; display: flex; align-items: center; gap: 4mm; padding: 3mm 4mm; }
.deck-cards { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2mm; }
.mcard { aspect-ratio: 1; border-radius: 3mm; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5mm; }
.mcard.back { background: var(--c); background-image: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.25) 0 18%, transparent 19%); }
.mcard.back .mascot { width: 55%; height: 55%; }
.mcard.face { background: #FFFFFF; box-shadow: inset 0 0 0 0.6mm var(--c); }
.mc-pic { width: 60%; height: 60%; }
.mcard small { font: 700 8pt var(--naskh); color: var(--ink-2); }
.deck-levels { width: 50mm; flex: none; display: flex; flex-direction: column; gap: 2mm; }
.dl { display: inline-flex; align-items: center; gap: 1.5mm; font: 800 12pt var(--title); color: var(--deep); }
.dl .stars { height: 4.6mm; width: auto; }
.dl.note { font: 600 9pt var(--body); color: var(--muted); }
.dl .ico { width: 4.6mm; height: 4.6mm; color: var(--c); }
.tally { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-evenly; gap: 1.5mm; padding: 3mm 4mm; }
.tally-row { display: flex; align-items: center; gap: 3mm; }
.tally-row b { width: 30mm; flex: none; font: 800 11.5pt var(--title); color: var(--ink); white-space: nowrap; overflow: hidden; }
.tally-row.me b { color: var(--c); }
.tally-boxes { flex: 1; display: flex; flex-wrap: wrap; gap: 1.2mm; }
.tally-boxes span { width: 8.4mm; height: 8.4mm; flex: none; border-radius: 2mm; border: 0.45mm solid var(--c); background: #FFFFFF; }
.tally-boxes span.lvl2 { border-style: dashed; border-color: #E8C77F; }
/* a family of 6 and the child: 7 rows still fit the 21 × 28 page */
.tally.many { gap: 0.8mm; padding: 2.4mm 4mm; }
.tally.many .tally-boxes span { width: 6.6mm; height: 6.6mm; border-radius: 1.6mm; }
.tally.many .tally-row b { font-size: 10.5pt; }
.score { flex: 1; min-height: 0; display: grid; grid-template-columns: 34mm repeat(var(--rounds), 1fr) 22mm; grid-auto-rows: auto; gap: 1.5mm;
         align-content: space-evenly; padding: 3.5mm 4mm; }
.sc-head { font: 700 9.5pt var(--body); color: var(--deep); text-align: center; background: var(--tint); border-radius: 2.5mm; padding: 1.4mm 0;
           display: flex; align-items: center; justify-content: center; gap: 1mm; }
.sc-head.name { justify-content: flex-start; padding-inline: 3mm; }
.sc-head .stars { height: 3.8mm; width: auto; }
.sc-name { display: flex; align-items: center; padding-inline: 2mm; border-radius: 3mm; background: #FFFCF6; min-height: 16mm; }
.sc-name b { font: 800 12pt var(--title); color: var(--ink); white-space: nowrap; overflow: hidden; }
.sc-name.me b { color: var(--c); }
.sc-cell { display: flex; align-items: center; justify-content: center; border-radius: 3mm; border: 0.4mm solid var(--line-soft); background: #FFFFFF; }
.sc-star { width: 10mm; height: 10mm; }
.sc-total { border-radius: 3mm; border: 0.5mm dashed #E8C77F; background: #FFFCF4; }
.cheer { flex: none; display: flex; align-items: center; justify-content: center; gap: 3mm; padding: 3mm; background: #FFF8E6; border-color: #F3C75E; }
.cheer .ico { width: 7mm; height: 7mm; color: var(--c); }
.cheer b { font: 800 13pt var(--title); color: var(--deep); }

/* ---- conversation cards with a face or an icon */
.talk-cards { grid-auto-rows: 1fr; gap: 4mm; min-height: 0; }
.talk-card { padding: 3.5mm 4.5mm; min-height: 0; }
.talk-card.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.tc-head { display: flex; align-items: center; gap: 2mm; }
.tc-face svg { width: 11mm; height: 11mm; }
.tc-ico { width: 9mm; height: 9mm; border-radius: 50%; background: var(--tint); color: var(--c); display: flex; align-items: center; justify-content: center; }
.tc-ico .ico { width: 5.5mm; height: 5.5mm; }
.tc-level { margin-inline-start: auto; }
.tc-level .stars { height: 4.2mm; width: auto; }
.talk-card p { font-size: 13.5pt; line-height: 1.45; }
.talk-card .write-line { margin-top: auto; }

/* ---- the checklist hunt (nature, the neighbourhood) */
.checkhunt { gap: 3.5mm; }
.hunt-safety { flex: none; display: flex; align-items: center; gap: 2.5mm; padding: 2mm 4mm; border-radius: 4mm; background: #FFF3EF;
               border: 0.5mm solid #F5B7AC; font: 700 10pt/1.4 var(--body); color: #7A2A20; }
.hunt-safety > span:last-child { flex: 1; max-height: 12mm; overflow: hidden; }
.hs-ico { width: 8mm; height: 8mm; border-radius: 50%; background: #E4675A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; flex: none; }
.hs-ico .ico { width: 5mm; height: 5mm; }
.check-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; gap: 3mm; }
.check-grid.n5, .check-grid.n6 { grid-template-columns: repeat(3, 1fr); }
.citem { position: relative; display: flex; flex-direction: column; align-items: center; gap: 1mm; padding: 3mm 2mm 2.5mm; min-height: 0; }
.ci-level { position: absolute; top: 2mm; inset-inline-start: 2.5mm; }
.ci-level .stars { height: 4mm; width: auto; }
.ci-pic { flex: 1; min-height: 0; display: flex; justify-content: center; }
.ci-pic svg { height: 100%; max-height: 28mm; width: auto; aspect-ratio: 1; }
.citem b { font: 700 11pt/1.2 var(--naskh); color: var(--ink); text-align: center; }
.ci-foot { display: flex; align-items: center; gap: 2mm; }
.ci-count { display: inline-flex; align-items: center; gap: 1mm; }
.ci-count small { font: 600 8pt var(--body); color: var(--muted); }
.ci-count i { width: 8mm; height: 7mm; border-radius: 2mm; border: 0.5mm dashed var(--c); background: #FFFFFF; }
.hunt-bottom { flex: none; display: flex; gap: 3mm; }
.compare { flex: 1; display: flex; flex-direction: column; gap: 2mm; padding: 3mm 4mm; }
.compare .label .stars { height: 4mm; width: auto; }
.compare-boxes { display: flex; align-items: center; gap: 3mm; }
.compare-boxes span { flex: 1; height: 20mm; border-radius: 3mm; border: 0.4mm dashed #EADFC8; background: #FFFFFF; }
.compare-boxes b { font: 800 11pt var(--title); color: var(--deep); }
.found { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 2mm; padding: 3mm 4mm; background: var(--tint); border-color: transparent; }
.found-nums { display: flex; flex-wrap: wrap; gap: 1.6mm; direction: rtl; }
.found-nums:has(> span:nth-child(7)) { gap: 1mm; } .found-nums:has(> span:nth-child(7)) span { width: 7.6mm; height: 7.6mm; }  /* 8 finds stay on one row */
.found-nums span { width: 9mm; height: 9mm; border-radius: 50%; background: #FFFFFF; border: 0.5mm solid var(--c); display: flex; align-items: center;
                   justify-content: center; font: 800 12pt/1 var(--title); color: var(--deep); padding-top: 0.8mm; }

/* ---- counting: pictures, things, the family table, money, change */
.countpg.mode-pictures, .countpg.mode-money, .countpg.mode-change { gap: 3mm; }
.pc-row { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; gap: 4mm; padding: 3mm 5mm 3mm 4mm; }
.pc-art { width: 64mm; height: 100%; max-height: 30mm; flex: none; }
.pc-art svg { width: 100%; height: 100%; }
.pc-circles { flex: 1; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.6mm; direction: rtl; }
.pc-circles span { aspect-ratio: 1; max-height: 9mm; border-radius: 50%; border: 0.6mm solid var(--c); background: #FFFFFF; }
.pc-row.lvl1 .pc-circles span:nth-child(n+6) { display: none; }
.pc-hint { flex: none; align-self: center; display: inline-flex; align-items: center; gap: 1.5mm; font: 700 11pt var(--body); color: var(--deep); }
.pc-hint .ico { width: 5mm; height: 5mm; color: var(--c); }
.tally-card.things .tally-squares span { width: 16mm; height: 9.4mm; }
.thing-pic { width: 15mm; height: 15mm; }
.dining { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 6mm; }
.dtable { position: absolute; inset: 26mm 12mm; border-radius: 12mm; background: #E7B070; box-shadow: inset 0 0 0 2.4mm #C98A4B; }
.seats { position: relative; width: 100%; height: 100%; display: flex; flex-wrap: wrap; justify-content: center; align-content: space-between;
         gap: 4mm 5mm; }
.seats .seat { flex: 0 0 30%; }
.seats.n2 .seat, .seats.n3 .seat, .seats.n4 .seat { flex-basis: 40%; }
.seats.n2 { flex-direction: column; align-items: center; justify-content: space-between; flex-wrap: nowrap; }
.seats.n2 .seat { flex-basis: auto; width: 46mm; }
.seat { display: flex; flex-direction: column; align-items: center; gap: 1.5mm; background: #FFFFFF; border-radius: 5mm; padding: 2mm 2.5mm 2.5mm;
        box-shadow: 0 0 0 0.45mm var(--line), 0 1mm 0 rgba(28,33,64,0.1); max-width: 52mm; }
.seat b { font: 800 11pt var(--title); color: var(--ink); white-space: nowrap; overflow: hidden; max-width: 40mm; }
.seat.me b { color: var(--c); }
.setting { display: flex; align-items: center; gap: 1.5mm; }
.plate-spot { width: 20mm; height: 20mm; border-radius: 50%; border: 0.6mm dashed var(--c); background: #FFFFFF; }
.lvl2-spot { width: 9mm; height: 9mm; border-radius: 2.5mm; border: 0.5mm dashed #E8C77F; color: #E8C77F; display: flex; align-items: center; justify-content: center; }
.lvl2-spot .ico { width: 5.5mm; height: 5.5mm; opacity: 0.6; }
.table-legend { flex: none; display: flex; justify-content: center; gap: 6mm; font: 700 10.5pt var(--body); color: var(--ink-2); }
.table-legend span { display: inline-flex; align-items: center; gap: 1.2mm; }
.table-legend .stars { height: 4.2mm; width: auto; }
.mode-table .tally-q { display: flex; align-items: center; justify-content: space-between; }
.purse { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; gap: 3mm; padding: 3mm 5mm 3mm 4mm; }
.purse-pieces, .chg-pieces { flex: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 2mm; }
.purse-pieces .coin, .chg-pieces .coin { width: 17mm; height: 17mm; }
.purse-pieces .note, .chg-pieces .note { width: 26mm; height: 16mm; }
.chg-pieces.outline .coin { width: 12mm; height: 12mm; }
.chg-pieces.outline .note { width: 19mm; height: 9.5mm; }
.piece-num { font: 800 15px var(--title); }
.purse-eq { font: 800 20pt var(--title); color: var(--deep); }
.purse-total { display: flex; flex-direction: column; align-items: center; gap: 1mm; }
.purse-total small { font: 700 8.5pt var(--body); color: var(--muted); white-space: nowrap; }
.purse-total i { width: 16mm; height: 13mm; border-radius: 3mm; border: 0.6mm solid var(--c); background: #FFFFFF; }
.chg { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; gap: 3mm; padding: 3mm 4mm; }
.chg-item { width: 30mm; flex: none; display: flex; flex-direction: column; align-items: center; gap: 1mm; }
.chg-pic { width: 18mm; height: 18mm; }
.chg-price { height: 6.4mm; padding: 0 2.4mm; border-radius: 3.2mm; background: var(--c); color: #FFFFFF; font: 700 9pt/6.4mm var(--body); white-space: nowrap; }
.chg-paid, .chg-back { display: flex; flex-direction: column; gap: 1mm; }
.chg-paid small, .chg-back small { font: 700 8.5pt var(--body); color: var(--muted); }
.chg-back { flex: 1; border-inline-start: 0.5mm dashed var(--line); padding-inline-start: 3mm; }

/* ---- sorting: more groups (paint, weather, busts, toy boxes), ⭐⭐ groups, budget and choice */
.group-pic { width: 26mm; height: 26mm; }
.sortpg.n4 .group-pic { width: 19mm; height: 19mm; }
.sortpg.n4 .sort-group { gap: 0.5mm; }
.group-chip { width: 100%; height: 100%; }
.group-bust { width: 20mm; height: 23.3mm; }
.group-level .stars { height: 4mm; width: auto; }
.sort-item.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.sortpg.n5 .sort-group, .sortpg.n6 .sort-group { flex-direction: row; gap: 2mm; justify-content: flex-start; padding-inline: 3mm; }
.sortpg.n5 .sort-group b, .sortpg.n6 .sort-group b { font-size: 12pt; }
.sortpg.n5 .sort-mark svg, .sortpg.n6 .sort-mark svg { width: 20mm; height: 20mm; }
.budgetpg, .choicepg { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.wallets { flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; }
.wallet { position: relative; display: flex; align-items: center; gap: 2.5mm; padding: 5mm 3mm 3mm; }
.w-ico { width: 10mm; height: 10mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center; justify-content: center; flex: none; }
.w-ico .ico { width: 6mm; height: 6mm; }
.w-body { display: flex; flex-direction: column; }
.w-body small { font: 600 8.5pt var(--body); color: var(--muted); }
.w-body b { font: 800 12pt var(--title); color: var(--deep); white-space: nowrap; }
.wallet .purse-pieces .coin { width: 12mm; height: 12mm; } .wallet .purse-pieces .note { width: 19mm; height: 12mm; }
.shelf { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 3mm; padding: 4mm;
         background: linear-gradient(transparent calc(50% - 1mm), #E7B070 calc(50% - 1mm), #E7B070 calc(50% + 0.6mm), transparent calc(50% + 0.6mm)); }
.shelf-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5mm; }
.shelf-pic { width: 26mm; height: 26mm; }
.circle-me { position: absolute; inset: 1mm 8mm; border-radius: 50%; border: 0.5mm dashed #E0CFA8; }
.bought { flex: none; display: flex; align-items: flex-end; gap: 3mm; padding: 3mm 4mm; }
.bought .label { white-space: nowrap; }
.bought .label .stars { height: 4.2mm; width: auto; }
.bought .write-line { flex: 1; }
.situation { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 2.5mm; padding: 3.5mm 4.5mm; }
.sit-top { flex: 1; min-height: 0; display: flex; align-items: center; gap: 4mm; }
.sit-scene { height: 100%; max-height: 42mm; aspect-ratio: 1; flex: none; background: #F7FBFE; border-radius: 4mm; }
.sit-scene svg { width: 100%; height: 100%; }
.sit-top b { font: 800 15pt/1.35 var(--title); color: var(--deep); }
.options { flex: none; display: flex; flex-wrap: wrap; gap: 2.5mm; }
.option { display: inline-flex; align-items: center; gap: 1.5mm; height: 10mm; padding-inline: 1.5mm 4mm; border-radius: 5mm; background: #FFFCF6;
          box-shadow: 0 0 0 0.45mm var(--line); font: 700 11.5pt var(--body); color: var(--ink); }
.option .check-box { width: 6mm; height: 6mm; border-radius: 50%; }
.opt-ico { width: 7mm; height: 7mm; border-radius: 50%; background: var(--tint); color: var(--c); display: flex; align-items: center; justify-content: center; }
.opt-ico .ico { width: 4.4mm; height: 4.4mm; }
.my-solution { flex: none; display: flex; align-items: flex-end; gap: 2mm; }
.my-solution .label { white-space: nowrap; }
.my-solution .label .stars { height: 4mm; width: auto; }
.my-solution .write-line { flex: 1; }

/* ---- recipe variants */
.pieces { display: flex; flex-wrap: wrap; gap: 1mm; max-width: 30mm; }
.piece-dot { width: 4.2mm; height: 4.2mm; border-radius: 50%; border: 0.5mm solid var(--c); background: #FFFFFF; }
.ing-row.n4 .ing-pic { width: 12mm; height: 12mm; }
.ing-row.n4 .ing { padding: 1.6mm 1.6mm; gap: 1.2mm; }
.ing-row.n4 .ing-text b { font-size: 10.5pt; }
.layers-card { flex: 1 1 0; min-height: 0; display: flex; gap: 5mm; padding: 4mm 5mm; overflow: hidden; }
.layers-cup { height: 100%; aspect-ratio: 90 / 120; flex: none; }
.layers-cup svg { width: 100%; height: 100%; }
.layer-rows { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 2mm; }
.layer-row { display: flex; align-items: center; gap: 2mm; padding: 1.4mm 3mm; border-radius: 4mm; background: #FFFCF6; border: 0.45mm solid var(--line); }
.layer-row.lvl2 { border-style: dashed; border-color: #E8C77F; }
.layer-row .stars { height: 4.2mm; width: auto; }
.layer-chips { display: flex; gap: 2mm; margin-inline-start: auto; }
.layer-chip { width: 13mm; height: 13mm; border-radius: 50%; border: 0.45mm dashed #D8CBB0; padding: 1.4mm; background: #FFFFFF; }
.layer-chip .mini { width: 100%; height: 100%; }
.safety-items { flex-wrap: wrap; }
.safety-item { min-width: 48mm; }

/* ---- the journal: how-to steps, one big entry, day labels */
.jr-how { flex: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5mm; }
.jr-step { display: flex; align-items: center; gap: 1.5mm; padding: 2mm 2.5mm; font: 700 9.5pt/1.3 var(--body); color: var(--ink); }
.jr-step-ico { width: 7mm; height: 7mm; color: var(--c); flex: none; }
.jr-step-ico .ico { width: 100%; height: 100%; }
.jr-big { flex: 1; min-height: 0; display: flex; gap: 4mm; align-items: stretch; }
.lens-wrap { position: relative; flex: 1.2; min-width: 0; display: flex; align-items: center; justify-content: center; }
.lens { width: min(100%, 104mm); aspect-ratio: 1; border-radius: 50%; background: #FFFFFF; border: 3.4mm solid var(--c);
        box-shadow: inset 0 0 0 1.4mm var(--tint), 0 1.4mm 0 var(--deep); }
.lens-handle { position: absolute; left: 4mm; bottom: 6mm; width: 12mm; height: 34mm; border-radius: 6mm; background: var(--deep); transform: rotate(40deg); }
.jr-notes { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 2mm; padding: 3mm 4mm; }
.jr-note { display: flex; flex-direction: column; gap: 0.5mm; }
.jr-note .label .stars { height: 4mm; width: auto; }
.jr-day { font: 800 11pt var(--title); color: var(--deep); }
.jr-water { display: inline-flex; align-items: center; gap: 0.8mm; margin-inline-start: 2mm; color: #4A95D3; }
.jr-water .check-box { width: 5.4mm; height: 5.4mm; }
.jr-water .ico { width: 4.4mm; height: 4.4mm; }

/* ---- my own shop (blank price tags) */
.myshop { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.shop-sign { position: relative; flex: none; align-self: center; min-width: 90mm; max-width: 150mm; padding: 8mm 8mm 3mm; border-radius: 4mm;
             background: var(--c); color: #FFFFFF; text-align: center; overflow: hidden; box-shadow: 0 1mm 0 var(--deep); }
.shop-sign .awning { position: absolute; left: 0; right: 0; top: 0; height: 5mm; background: repeating-linear-gradient(90deg, #FFFFFF 0 6mm, #F2B33D 6mm 12mm); }
.shop-sign b { display: block; font: 800 18pt/1.2 var(--title); white-space: nowrap; overflow: hidden; }
.shop-shelves { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 3mm 4mm; padding: 4mm;
                background: repeating-linear-gradient(transparent 0, transparent calc(50% - 1.2mm), #E7B070 calc(50% - 1.2mm), #E7B070 50%); }
.spot { display: flex; flex-direction: column; align-items: center; gap: 1.5mm; min-height: 0; }
.spot-draw { flex: 1; width: 100%; min-height: 0; border-radius: 4mm; border: 0.45mm dashed #D8CBB0; background: #FFFFFF; display: flex; align-items: flex-end; justify-content: flex-end; padding: 1.5mm; }
.spot-draw small .ico { width: 4.4mm; height: 4.4mm; color: #D8CBB0; }
.tag-blank { position: relative; display: flex; align-items: center; gap: 1.5mm; height: 10mm; padding: 0 3mm 0 5mm; border-radius: 2mm 5mm 5mm 2mm;
             background: #FFF6D8; border: 0.5mm solid #E8C77F; }
.tag-hole { position: absolute; left: 1.6mm; top: 50%; width: 2mm; height: 2mm; margin-top: -1mm; border-radius: 50%; border: 0.4mm solid #E8C77F; background: #FFFFFF; }
.tag-blank i { width: 12mm; height: 7mm; border-bottom: 0.45mm dashed #B27A0C; }
.tag-blank small { font: 700 8.5pt var(--body); color: #8A5A08; }
.shop-levels { flex: none; display: flex; justify-content: center; gap: 6mm; font: 700 10.5pt var(--body); color: var(--ink-2); }
.shop-levels span { display: inline-flex; align-items: center; gap: 1.2mm; }
.shop-levels .stars { height: 4.2mm; width: auto; }
.rank { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 3mm; padding: 3mm 4.5mm; }
.rank .label .stars { height: 4.2mm; width: auto; }
.rank-boxes { display: flex; align-items: center; gap: 2mm; }
.rank-boxes span { width: 20mm; height: 14mm; border-radius: 3mm; border: 0.45mm dashed #D8CBB0; background: #FFFFFF; }
.rank-boxes b { font: 800 14pt var(--title); color: var(--deep); }

/* ---- the sticker sheet: one sticker per passport slot (sizes match the slots), stars and routine icons */
.stickers .st-group { gap: 2mm; }
.st-stamps { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.5mm 2mm; justify-items: center; }
.st-rosettes { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1.5mm; justify-items: center; }
.stickers .st-badge { display: flex; flex-direction: column; align-items: center; gap: 0.6mm; min-width: 0; }
.stickers .st-badge > span { font: 700 7pt/1.2 var(--body); white-space: nowrap; overflow: hidden; max-width: 28mm; text-align: center; }
.stickers .st-seal { position: relative; width: 21.5mm; height: 21.5mm; }
.stickers .st-seal .seal, .stickers .st-seal .cut { position: absolute; inset: 0; width: 100%; height: 100%; }
.st-n { position: absolute; top: 0.2mm; inset-inline-start: 1.2mm; min-width: 4.6mm; height: 4.6mm; border-radius: 2.3mm; color: #FFFFFF;
        font: 800 7.5pt/4.6mm var(--title); text-align: center; padding: 0.2mm 0.8mm 0; box-shadow: 0 0 0 0.4mm #FFFFFF; }
.st-rosette { position: relative; width: 21.5mm; height: 21.5mm; }
.st-rosette svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.st-chores { display: flex; flex-wrap: wrap; gap: 1.6mm 2.2mm; justify-content: center; }
.st-chore { width: 12mm; height: 12mm; }
.st-chore svg { width: 100%; height: 100%; }
.stickers .st-days { display: flex; justify-content: center; gap: 4mm; }
.stickers .st-routine { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3.2mm 3mm; justify-items: center; }
.stickers .st-rt { width: 19mm; height: 19mm; }
.stickers .st-rt .rt-ico { width: 8.6mm; height: 8.6mm; }
.stickers .st-rt .rt-ico .ico { width: 5.8mm; height: 5.8mm; }
.stickers .st-rt b { font-size: 7pt; max-width: 17mm; }
.stickers .rt-cut { inset: -0.8mm; border-radius: 5mm; }

/* ---- card stock: cards with a printed guide and, on the die layer, the cut line (1.5 mm inside the color) */
.cutline { position: absolute; inset: 1.5mm; border: 0.3mm solid #EC008C; border-radius: 3.5mm; pointer-events: none; }
.guide { position: absolute; inset: 1.5mm; border: 0.35mm dashed #8E93AB; border-radius: 3.5mm; pointer-events: none; }
.note-cell .cutline { inset: -0.35mm; border-radius: 6mm; }
.coin-cell { position: relative; }
.coin-cell .cutline { inset: -0.35mm; border-radius: 50%; }
.ptag-cell { position: relative; }
.ptag-cell .cutline { inset: -0.35mm; border-radius: 4.5mm; }
.sheet.cards { gap: 3mm; }
.card-grid { flex: 1; min-height: 0; display: grid; gap: 1mm; }
.ccard { position: relative; display: flex; flex-direction: column; align-items: center; gap: 1mm; padding: 3.5mm 3mm 3mm; min-height: 0;
         background: color-mix(in srgb, var(--cc, #F2B33D) 14%, #FFFFFF); border-radius: 4.5mm; }
.card-grid.recipes { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; }
.cc-band { width: 100%; height: 6.4mm; border-radius: 3.2mm; background: var(--cc); color: #FFFFFF; display: flex; align-items: center;
           justify-content: center; padding: 0 2mm; }
.cc-band span { font: 700 8pt/1 var(--body); white-space: nowrap; overflow: hidden; max-width: 100%; }
.cc-pic { flex: 1; min-height: 0; width: 100%; display: flex; align-items: center; justify-content: center; background: #FFFFFF; border-radius: 3mm; }
.cc-pic svg { height: 100%; max-height: 30mm; width: auto; aspect-ratio: 1; }
.card-grid.recipes .ccard { padding: 3mm 2.6mm 2.4mm; }
.card-grid.recipes .cc-text { font-size: 9pt; min-height: 0; }
.cc-text { font: 700 10pt/1.3 var(--body); color: var(--ink); text-align: center; min-height: 8mm; }
.card-grid.memory { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(6, 1fr); }
.ccard.mem { --cc: #4F79D9; padding-top: 3mm; }
.ccard.mem.lvl2 { --cc: #F2B33D; }
.mem-level { position: absolute; top: 3mm; inset-inline-start: 3.4mm; }
.mem-level .stars { height: 3.8mm; width: auto; }
.cc-word { font: 700 9.5pt/1.2 var(--naskh); color: var(--ink); }
.card-grid.questions { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; }
.qcard { --cc: #2E9FD6; justify-content: center; gap: 2.5mm; padding: 5mm; }
.qcard.lvl2 { --cc: #F2B33D; }
.q-ico { width: 13mm; height: 13mm; border-radius: 50%; background: var(--cc); color: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.q-ico .ico { width: 8mm; height: 8mm; }
.q-text { font: 800 13pt/1.4 var(--title); color: var(--ink); text-align: center; }
.qcard .mem-level { top: auto; bottom: 3.4mm; }
.card-grid.roles { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 3mm; }
.ccard.role { padding: 4mm 4mm 3.5mm; gap: 1.5mm; }
.role-art { flex: 1; min-height: 0; width: 100%; display: flex; justify-content: center; background: var(--tint, #F3E4F6);  /* a white coat shows */ border-radius: 4mm; padding-top: 2mm; }
.role-art svg { height: 100%; max-height: 52mm; width: auto; aspect-ratio: 60 / 80; }  /* room above the head for a hat */
.role-name { font: 800 16pt/1.2 var(--title); color: var(--ink); }
.role-says { display: flex; flex-direction: column; gap: 1mm; width: 100%; }
.role-says span { font: 600 9.5pt/1.35 var(--body); color: var(--ink-2); background: #FFFFFF; border-radius: 3mm; padding: 1mm 2.5mm; text-align: center; }
.role-prop { display: flex; align-items: center; gap: 1.5mm; }
.rp-pic { width: 10mm; height: 10mm; }
.role-prop small { font: 600 8pt var(--body); color: var(--muted); }
.puppet-grid { flex: 1; display: flex; flex-wrap: wrap; justify-content: center; align-content: space-evenly; gap: 8mm 6mm; }
.puppet { position: relative; flex: none; }
.puppet > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.pp-head { position: absolute; left: 50%; top: 11mm; width: 30mm; height: 30mm; transform: translateX(-50%); }
.pp-band { position: absolute; left: 2mm; right: 2mm; display: flex; align-items: center; gap: 2mm; }
/* the label sits on the light glue strip (the band's left end, under the cut line's inside) */
.pp-glue { order: 2; width: 10mm; flex: none; align-self: stretch; display: flex; align-items: center; justify-content: center; font: 700 7pt/1.15 var(--body);
           color: var(--muted); text-align: center; }
.pp-band b { flex: 1; text-align: center; font: 800 12pt var(--title); color: var(--deep); }
.card-grid.memory .ccard { padding: 2.6mm 2.4mm 2.2mm; gap: 0.6mm; }
.card-grid.memory .cc-pic svg { max-height: 21mm; }
.card-grid.questions .ccard, .card-grid.roles .ccard, .card-grid.recipes .ccard { overflow: hidden; }
.cut-note .stars { height: 4mm; width: auto; }
svg.bust, svg.group-bust { overflow: hidden; }

