{# The page frame: section tab, header wash, mission header, footer; for the family book also the activity
   tags and the parent box (Addendum 7 §5). #}

{% macro tab(p, g) -%}
{% set top = tab_top(p.style, g.trim_h, g.bleed) %}
{% set uid = p.spec.id %}
{% if p.side == 'left' %}
  {% set shape = 'M0 0 L10.5 0 A4 4 0 0 1 14.5 4 L14.5 22 A4 4 0 0 1 10.5 26 L0 26 Z' %}{% set cx = g.bleed + 5.75 %}
{% else %}
  {% set shape = 'M14.5 0 L4 0 A4 4 0 0 0 0 4 L0 22 A4 4 0 0 0 4 26 L14.5 26 Z' %}{% set cx = 14.5 - g.bleed - 5.75 %}
{% endif %}
<div class="tab {{ p.side }}" style="top: {{ top }}mm">
  <svg viewBox="0 0 14.5 26" aria-hidden="true">
    <defs>
      <pattern id="tp-{{ uid }}" width="6" height="6" patternUnits="userSpaceOnUse">{{ patterns[p.style.pattern]|safe }}</pattern>
      <clipPath id="tc-{{ uid }}"><path d="{{ shape }}"/></clipPath>
    </defs>
    <path d="{{ shape }}" fill="{{ p.style.color }}"/>
    <rect x="0" y="0" width="14.5" height="26" fill="url(#tp-{{ uid }})" clip-path="url(#tc-{{ uid }})" opacity="0.55"/>
    <circle cx="{{ cx }}" cy="13" r="4.5" fill="#FFFFFF"/>
    <svg x="{{ cx - 3.2 }}" y="9.8" width="6.4" height="6.4" viewBox="0 0 24 24">{{ icon(p.style.icon, 'ico', 2.4) }}</svg>
  </svg>
</div>
{%- endmacro %}

{% macro wash(p, g) -%}
<div class="wash" aria-hidden="true">
  <svg viewBox="0 0 {{ g.page_w }} 86" preserveAspectRatio="none">
    <path d="M0 0 L{{ g.page_w }} 0 L{{ g.page_w }} 58 C{{ g.page_w * 0.78 }} 74 {{ g.page_w * 0.62 }} 50 {{ g.page_w * 0.44 }} 62 C{{ g.page_w * 0.27 }} 73 {{ g.page_w * 0.12 }} 56 0 66 Z" fill="{{ p.style.tint }}" opacity="0.75"/>
    <circle cx="{{ g.page_w * 0.9 }}" cy="14" r="1.6" fill="{{ p.style.color }}" opacity="0.35"/>
    <circle cx="{{ g.page_w * 0.1 }}" cy="22" r="1.2" fill="{{ p.style.color }}" opacity="0.35"/>
    <circle cx="{{ g.page_w * 0.8 }}" cy="40" r="1" fill="{{ p.style.color }}" opacity="0.3"/>
    {% if book.product == 'family' %}{{ confetti(p, g) }}{% endif %}
  </svg>
</div>
{%- endmacro %}

{# a few cheerful sprinkles in the header corners, clear of the title (family book) #}
{% macro confetti(p, g) -%}
{% set w = g.page_w %}
{% for x, y, r, kind in [(0.06, 30, 2.6, 's'), (0.95, 36, 2.2, 's'), (0.16, 12, 1.4, 'd'), (0.86, 10, 1.6, 'd'), (0.04, 52, 1.2, 'd'), (0.97, 58, 1.3, 'd'), (0.2, 44, 1.1, 'r'), (0.8, 47, 1.2, 'r')] %}
  {% if kind == 's' %}<path d="M{{ w * x }} {{ y - r }} L{{ w * x + r * 0.32 }} {{ y - r * 0.32 }} L{{ w * x + r }} {{ y }} L{{ w * x + r * 0.32 }} {{ y + r * 0.32 }} L{{ w * x }} {{ y + r }} L{{ w * x - r * 0.32 }} {{ y + r * 0.32 }} L{{ w * x - r }} {{ y }} L{{ w * x - r * 0.32 }} {{ y - r * 0.32 }} Z" fill="#F2B33D"/>
  {% elif kind == 'd' %}<circle cx="{{ w * x }}" cy="{{ y }}" r="{{ r }}" fill="{{ p.style.color }}" opacity="0.55"/>
  {% else %}<circle cx="{{ w * x }}" cy="{{ y }}" r="{{ r }}" fill="none" stroke="{{ p.style.color }}" stroke-width="0.5" opacity="0.7"/>{% endif %}
{% endfor %}
{%- endmacro %}

{% macro chip(p) -%}
<div class="chip" dir="rtl">{{ icon(p.style.icon) }}<span>{{ p.section_name or p.style.name_ar }}</span>{% if p.spec.stage %}<span class="sep"></span><span>المحطة {{ book.num(p.spec.stage) }}</span>{% elif book.product == 'family' and 0 < p.style.slot < p.style.slots - 1 %}<span class="sep"></span><span>المغامرة {{ book.num(p.style.slot) }}</span>{% endif %}</div>
{%- endmacro %}

{# the activity icons (A7 §5): at home or outside, with the family, minutes, ⭐ / ⭐⭐ #}
{% macro tags(p) -%}
{% set a = p.spec.activity %}
<div class="tags" dir="rtl">
  {% if a.where == 'outside' %}<span class="tag t-out"><i>{{ icon('tree') }}</i>في الخارج</span>{% else %}<span class="tag t-home"><i>{{ icon('home') }}</i>في البيت</span>{% endif %}
  {% if a.together %}<span class="tag t-fam"><i>{{ icon('family') }}</i>مع العائلة</span>{% endif %}
  {% if a.minutes %}<span class="tag t-time"><i>{{ icon('clock') }}</i>{{ minutes_ar(a.minutes, book.numerals) }}</span>{% endif %}
  <span class="tag t-level">{{ stars(1) }}{% if a.challenge %}<span class="or"></span>{{ stars(2) }}{% endif %}</span>
</div>
{%- endmacro %}

{# «للأهل» / «هيا نفعلها معاً!»: 1–3 short lines for the grown-up (A7 §5) #}
{% macro parent_box(p) -%}
{% set together = p.spec.activity and p.spec.activity.together %}
<aside class="parent-box{{ ' together' if together }}" dir="rtl" lang="ar">
  <div class="pb-tag"><span class="pb-ico">{{ icon('family' if together else 'heart') }}</span><span>{{ 'هيا نفعلها معاً!' if together else 'للأهل' }}</span></div>
  {% if together %}<span class="pb-for">للأهل</span>{% endif %}
  <ul data-fit="8.5">{% for line in p.parent %}<li>{{ line }}</li>{% endfor %}</ul>
</aside>
{%- endmacro %}

{% macro header(p) -%}
<header class="head">
  {%+ if p.spec.activity %}<div class="head-row">{{ chip(p) }}{{ tags(p) }}</div>{% else %}{{ chip(p) }}{% endif +%}
  <h1 class="title">{{ p.title }}</h1>
  <div class="say">
    {{ mascot('mascot', p.spec.dir == 'rtl') }}
    <div class="bubble">{% if p.instruction_en %}{{ p.instruction_en }}<span class="second" dir="rtl" lang="ar">{{ p.instruction }}</span>{% else %}{{ p.instruction }}{% endif %}</div>
  </div>
</header>
{%- endmacro %}

{% macro footer(p) -%}
<footer class="foot" dir="rtl">
  {% if p.skill %}<div class="skill" lang="ar">{{ icon('target') }}<span>{{ p.skill }}</span></div>{% endif %}
  <div class="folio">{{ p.folio }}</div>
  <div class="brand" lang="ar">{{ mascot('mascot') }}<span>قمرة</span></div>
</footer>
{%- endmacro %}

{% macro example_tag(label='مثال') -%}
<span class="example-tag">{{ icon('star') }}{{ label }}</span>
{%- endmacro %}

{% macro qr_card(p, title='امسح واسمع', note='') -%}
<div class="qr-card">
  <div class="qr">{{ p.qr }}</div>
  <div class="label">{{ icon('speaker') }}<span>{{ title }}</span>{% if note %}<small>{{ note }}</small>{% endif %}</div>
</div>
{%- endmacro %}
