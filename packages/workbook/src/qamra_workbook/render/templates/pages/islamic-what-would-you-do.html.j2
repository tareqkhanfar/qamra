{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, false, true) }}
  <div class="isl-body wy">
    <section class="wy-scenario"><p>{{ d.scenario }}</p></section>
    <figure class="wy-scene">{{ d.scene }}</figure>
    <section class="wy-choices">
      {% for ch in d.choices %}
      <article class="card wy-choice"><span class="tick"></span><div><p class="wy-t">{{ ch.text }}</p><p class="wy-f">{{ icon('heart' if ch.ok else 'wind', 'ico', 2.2) }}<span>{{ ch.feedback }}</span></p></div></article>
      {% endfor %}
    </section>
    {{ isl.sacred(d.quote, c) }}
    <section class="wy-role"><span class="pill">{{ icon('mask', 'ico', 2.2) }}{{ d.labels.role }}</span><p>{{ d.role_play }}</p></section>
    {{ isl.refs(c, d.refs) }}
  </div>
  {{ isl.foot(p, c) }}
</div>
