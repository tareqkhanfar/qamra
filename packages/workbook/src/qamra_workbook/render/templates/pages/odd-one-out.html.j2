<div class="odd">
{% for row in d.rows %}
  <div class="odd-row{% if row.example %} is-example{% endif %}{% if row.pics|length > 4 %} five{% endif %}{% if row.hint %} has-hint{% endif %}">
    {% if row.hint %}<span class="odd-hint">{{ row.hint }}</span>{% endif %}
    <div class="row-mark">{% if row.example %}{{ ui.example_tag() }}{% else %}<span class="num">{{ p.num(row.n) }}</span>{% endif %}</div>
    <div class="odd-cells">
    {% for pic in row.pics %}
      <div class="odd-cell">{{ pic }}{% if loop.index0 == row.odd and (row.example or solved) %}{{ d.ring('example' if row.example else 'answer') }}{% endif %}</div>
    {% endfor %}
    </div>
  </div>
{% endfor %}
</div>
