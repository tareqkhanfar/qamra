<div class="talkpg">
  {% if d.roles %}
  <div class="roles">
    {% for r in d.roles %}
    <div class="role fcard">
      <div class="role-head"><div class="role-pic">{{ r.pic }}</div><b>{{ r.name }}</b><span class="role-ico">{{ icon(r.icon) }}</span></div>
      <div class="role-lines">
        {% for line in r.lines %}<div class="say-line">{{ line }}</div>{% endfor %}
        {% for line in r.challenge %}<div class="say-line lvl2">{{ stars(2) }}<span>{{ line }}</span></div>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% if d.swap %}<div class="swap">{{ icon('talk') }}<b>{{ d.swap }}</b>{{ icon('talk') }}</div>{% endif %}
  {% else %}
  <div class="talk-cards n{{ d.cards|length }}">{% for c in d.cards %}<div class="talk-card fcard lvl{{ c.level }}">
    <div class="tc-head"><span class="pill-num">{{ book.num(loop.index) }}</span>{% if c.face %}<span class="tc-face">{{ c.face }}</span>{% elif c.icon %}<span class="tc-ico">{{ icon(c.icon) }}</span>{% endif %}{% if c.level == 2 %}<span class="tc-level">{{ stars(2) }}</span>{% endif %}</div>
    <p>{{ c.text }}</p>{% if d.answers %}<div class="write-line"></div>{% endif %}</div>{% endfor %}</div>
  {% endif %}
</div>
