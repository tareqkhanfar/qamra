<div class="interview">
  <div class="iv-top">
    <div class="iv-portrait fcard"><div class="iv-face"><small>{{ icon('crayon') }}{{ 'ارْسُمي' if book.child.gender == 'f' else 'ارْسُمِ' }} {{ d.guest }}</small></div><b data-fit="9">{{ d.who }}</b></div>
    <div class="iv-mic fcard"><span class="iv-mic-ico">{{ icon('mic') }}</span><b>مُقابَلَةٌ صَحَفِيَّةٌ</b><small data-fit="8">{{ d.reporter }}</small></div>
  </div>
  <div class="iv-questions">
    {% for q in d.questions %}
    <div class="iv-q fcard lvl{{ q.level }}">
      <div class="iv-q-head"><span class="pill-num">{{ q.n }}</span><span class="iv-q-ico">{{ icon(q.icon) }}</span><b>{{ q.text }}</b><span class="iv-level">{{ stars(q.level) }}</span></div>
      <div class="iv-answer"></div>
    </div>
    {% endfor %}
  </div>
</div>
