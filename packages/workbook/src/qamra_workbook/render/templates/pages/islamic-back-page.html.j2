{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, false, true) }}
  <div class="isl-body bp">
    <div class="bp-cast-box">{{ d.cast }}</div>
    <section class="wy-scenario bp-msg"><p>{{ d.message }}</p></section>
    {% if d.next %}<p class="bp-next"><span class="pill">{{ icon('book', 'ico', 2.2) }}{{ d.next }}</span></p>{% endif %}
    <div class="ic-top bp-series"><span>{{ d.star }}</span><b>{{ d.series }}</b><span>{{ d.star }}</span></div>
  </div>
  {{ isl.foot(p, c) }}
</div>
