{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl ic" {{ isl.container(c) }}>
  <div class="ic-frame" aria-hidden="true"><i class="ic-line a"></i><i class="ic-line b"></i>
    <span class="ic-corner tl">{{ d.star }}</span><span class="ic-corner tr">{{ d.star }}</span><span class="ic-corner bl">{{ d.star }}</span><span class="ic-corner br">{{ d.star }}</span></div>
  <div class="ic-body">
    <div class="ic-top"><span>{{ d.star }}</span><b>{{ d.labels.series }}</b><span>{{ d.star }}</span></div>
    <h1 class="ic-title" data-fit="20">{{ p.title }}</h1>
    <p class="ic-give">{{ d.labels.give }}</p>
    <div class="ic-name"><span data-fit="22">{{ d.name }}</span></div>
    <div class="ic-hero"><i class="ic-ring"></i>{% if d.character %}<img src="{{ d.character }}" alt="">{% endif %}</div>
    <p class="ic-statement" data-fit="14">{{ d.statement }}</p>
    {% if d.credit %}<p class="ic-credit">{{ d.credit }}</p>{% endif %}
    <div class="ic-sign">
      <div><span class="ic-label">{{ d.labels.date }}</span><span class="ic-value">{{ d.date }}</span></div>
      <div><span class="ic-label">{{ d.labels.sign }}</span><span class="ic-value blank"></span></div>
    </div>
  </div>
</div>
