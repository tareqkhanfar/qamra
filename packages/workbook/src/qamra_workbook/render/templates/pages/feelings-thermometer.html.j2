<div class="feel">
  <div class="feel-main">
    <div class="thermo-card fcard">
      <div class="label">{{ icon('heart') }}ما حَجْمُ شُعوري الآنَ؟</div>
      <div class="thermo-wrap" style="height: {{ d.thermo_mm }}mm">
        <div class="thermo-svg">{{ d.thermo }}</div>
        <div class="levels">
          {% for l in d.levels %}<div class="level" style="top: {{ l.top }}mm"><span class="lv-face">{{ l.face }}</span><span class="lv-label" style="--lc: {{ l.color }}">{{ l.label }}</span></div>{% endfor %}
        </div>
      </div>
    </div>
    <div class="feel-side">
      <div class="when fcard">
        <div class="label">{{ icon('talk') }}عِنْدَما يَزورُني…</div>
        <div class="faces">{% for f in d.feelings %}<div class="face-opt">{{ f.face }}<span>{{ f.label }}</span></div>{% endfor %}</div>
      </div>
      <div class="can fcard">
        <div class="label">{{ icon('star') }}أَسْتَطيعُ أَنْ…</div>
        <div class="strategies">{% for s in d.strategies %}<div class="strat"><span class="strat-ico">{{ icon(s.icon) }}</span><span data-fit="8.5">{{ s.text }}</span></div>{% endfor %}</div>
        <div class="my-idea"><span class="idea-label">{{ stars(2) }}فِكْرَتي:</span><div class="write-line"></div></div>
      </div>
    </div>
  </div>
  <div class="feel-note">{{ icon('heart') }}<span>كُلُّ المَشاعِرِ مَقْبولَةٌ، وَنَحْنُ {{ 'مَعَكِ' if book.child.gender == 'f' else 'مَعَكَ' }} دائِمًا</span>{{ icon('heart') }}</div>
</div>
