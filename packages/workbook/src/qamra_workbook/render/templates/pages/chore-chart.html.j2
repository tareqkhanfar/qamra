<div class="chorepg">
  <div class="chart fcard">
    <div class="chart-title">{{ icon('check-list') }}<b data-fit="11">{{ d.owner }}</b></div>
    <div class="chart-grid" style="--days: {{ d.week|length }}">
      <div class="ch-head task">المَهَمَّةُ</div>
      {% for day in d.week %}<div class="ch-head">{{ day }}</div>{% endfor %}
      {% for r in d.rows %}
      <div class="ch-task lvl{{ r.level }}"><span class="pill-num">{{ r.n }}</span>{% if r.level == 2 %}{{ stars(2) }}{% endif %}<div class="ch-draw"></div></div>
      {% for day in d.week %}<div class="ch-cell lvl{{ r.level }}"><span class="ch-slot" style="width: {{ d.slot_mm }}mm; height: {{ d.slot_mm }}mm">{{ stars(1, 'ch-star', '#FFFFFF', '#E8D9B8') }}</span></div>{% endfor %}
      {% endfor %}
    </div>
  </div>
  {% if d.ideas %}
  <div class="ideas fcard">
    <span class="label">{{ icon('bulb') }}أَفْكارٌ لِمَهامَّ صَغيرَةٍ</span>
    <div class="idea-row">{% for i in d.ideas %}<div class="idea"><div class="idea-pic">{{ i.pic }}</div><small>{{ i.text }}</small></div>{% endfor %}</div>
  </div>
  {% endif %}
  <div class="chore-reward fcard"><span class="reward-ico small">{{ icon('gift') }}</span><span class="label">{{ d.reward }}</span><div class="write-line"></div></div>
</div>
