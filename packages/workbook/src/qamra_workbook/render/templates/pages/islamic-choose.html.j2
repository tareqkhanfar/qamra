{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, true, true) }}
  <div class="isl-body ch n{{ d.questions|length }}">
    {% if d.scene %}<figure class="ch-scene">{{ d.scene }}</figure>{% endif %}
    {% for q in d.questions %}
    <section class="card ch-q">
      <div class="ch-top"><span class="tf-n">{{ q.n }}</span><p class="ur-q">{{ q.text }}</p>{% if q.pic %}<span class="ch-pic-box">{{ q.pic }}</span>{% endif %}</div>
      <div class="ch-choices k{{ q.choices|length }}">{% for ch in q.choices %}<div class="ur-choice"><span class="tick"></span><span class="ur-ct">{% if ch.placeholder %}<span class="hole">{{ ch.notice }}</span>{% else %}{{ ch.text }}{% endif %}</span>{% if ch.tag %}<i class="opt-tag">{{ ch.tag }}</i>{% endif %}</div>{% endfor %}</div>
    </section>
    {% endfor %}
    {{ isl.refs(c, d.refs) }}
  </div>
  {{ isl.foot(p, c) }}
</div>
