{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, true, true) }}
  <div class="isl-body dr">
    <section class="wy-scenario"><p>{{ d.prompt }}</p></section>
    {% if d.hints %}<section class="dr-hints"><span class="pill">{{ icon('bulb', 'ico', 2.2) }}{{ d.labels.hints }}</span>{% for h in d.hints %}<span class="dr-hint">{{ h }}</span>{% endfor %}</section>{% endif %}
    <section class="dr-boxes n{{ d.boxes|length }}">{% for b in d.boxes %}<div class="dr-box">{% if b %}<span class="pill">{{ b }}</span>{% endif %}</div>{% endfor %}</section>
    {% for l in d.lines %}<div class="write-line"></div>{% endfor %}
  </div>
  {{ isl.foot(p, c) }}
</div>
