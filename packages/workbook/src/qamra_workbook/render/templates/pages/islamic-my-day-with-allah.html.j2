{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, true, true) }}
  <div class="isl-body dy{{ ' dense' if d.dense }}">
    {% for m in d.moments %}
    <article class="dy-row"><span class="dy-n">{{ m.n }}</span><div class="dy-pic-box">{{ m.pic }}</div><div class="dy-t"><b>{{ m.when }}</b><p>{{ m.text }}</p></div>{% if d.tick %}<span class="tick"></span>{% endif %}</article>
    {% endfor %}
    {% if d.closing %}<section class="hn-close card"><p{{ ' class=ai' if d.closing.ai }}>{{ d.closing.text }}</p></section>{% endif %}
  </div>
  {{ isl.foot(p, c) }}
</div>
