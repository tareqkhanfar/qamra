<div class="own">
  <div class="own-kicker">{{ d.level_title }}</div>
  <h1 class="own-title">هذا الكتاب لـ</h1>
  <div class="own-name"><span{% if d.long %} class="long"{% endif %} data-fit="16">{{ d.name }}</span></div>
  <div class="own-vol">{{ d.volume_title }}</div>
  <div class="own-mid">
    <div class="own-hand">
      <svg viewBox="0 0 110 132" aria-hidden="true"><path d="M33 128 L28 92 C27 80 23 67 23 57 C23 48 36 48 36 57 L37 73 L38 38 C38 27 50 27 50 38 L50.5 70 L51 31 C51 20 63 20 63 31 L63 70 L64 40 C64 29 76 29 76 40 L76.5 84 C80 77 86 68 91 62 C96 56 104 61 99 70 C94 80 87 92 81 104 L77 128" fill="none" stroke="#C9B994" stroke-width="1.3" stroke-dasharray="3 2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{{ 'ضع كفّك هنا وارسم حولها' if book.child.gender == 'm' else 'ضعي كفّك هنا وارسمي حولها' }}</span>
    </div>
    {% if d.character %}<img class="own-child" src="{{ d.character }}" alt="">{% endif %}
  </div>
  <div class="own-lines">{% for line in d.lines %}<div class="own-line"><span>{{ line }}:</span><i></i></div>{% endfor %}</div>
</div>
