{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, false, true) }}
  <div class="isl-body hu">
    {% for s in d.steps %}
    <section class="pg-card hu-step"><div class="pg-ico">{{ icon(s.icon, 'ico', 2.2) }}</div><div class="pg-text"><p class="hu-t">{{ s.text }}</p></div><span class="hu-n">{{ s.n }}</span></section>
    {% endfor %}
    <aside class="pg-care hu-care"><div class="pg-care-ico">{{ icon('book', 'ico', 2) }}</div><div><b>{{ d.labels.care }}</b><p>{{ d.care }}</p></div></aside>
  </div>
  {{ isl.foot(p, c) }}
</div>
