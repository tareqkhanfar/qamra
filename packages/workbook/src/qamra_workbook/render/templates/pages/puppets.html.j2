<div class="sheet cards">
  <header class="sheet-head">
    <div class="sheet-title">{{ mascot('mascot') }}<div><h1>{{ p.title }}</h1><p>{{ p.instruction }}</p></div></div>
    <div class="sheet-owner"><small>دمى الأصابع</small><b data-fit="11">{{ d.owner }}</b></div>
  </header>
  <div class="puppet-grid">
    {% for pp in d.puppets %}
    <div class="puppet" style="width: {{ d.size[0] }}mm; height: {{ d.size[1] }}mm">
      {{ pp.back }}
      <div class="pp-head">{{ pp.pic }}</div>
      <div class="pp-band" style="top: {{ d.band[0] }}mm; height: {{ d.band[1] - d.band[0] }}mm"><span class="pp-glue">ألصق هنا</span><b>{{ pp.word }}</b></div>
      {{ pp.outline }}
    </div>
    {% endfor %}
  </div>
  <footer class="sheet-foot"><span class="cut-note">{{ d.scissors }}قصّوا الدمية، ولفّوا الشريط حول الإصبع، وألصقوه عند «ألصق هنا»</span><span class="sheet-brand">{{ mascot('mascot') }}قمرة · بطاقات القصّ</span></footer>
</div>
