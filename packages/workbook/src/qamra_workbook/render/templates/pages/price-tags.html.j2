{% if d.mode == 'blank' %}
<div class="myshop">
  <div class="shop-sign"><span class="awning" aria-hidden="true"></span><b data-fit="12">{{ d.sign }}</b></div>
  <div class="shop-shelves fcard">
    {% for sp in d.spots %}
    <div class="spot"><div class="spot-draw"><small>{{ icon('crayon') }}</small></div><div class="tag-blank"><span class="tag-hole"></span><i></i></div></div>
    {% endfor %}
  </div>
  <div class="shop-levels"><span>{{ stars(1) }}{{ d.levels[0] }}</span><span>{{ stars(2) }}{{ d.levels[1] }}</span></div>
  <div class="rank fcard lvl2"><span class="label">{{ stars(2) }}{{ d.order }}</span><div class="rank-boxes"><span></span><b>&lt;</b><span></span><b>&lt;</b><span></span></div></div>
</div>
{% else %}
<div class="pricepg">
  {% for row in d.rows %}
  <div class="price-row fcard lvl{{ row.level }}">
    <span class="row-level">{{ stars(row.level) }}</span>
    <div class="price-items">
      {% for it in row['items'] %}
      {% if not loop.first %}<span class="price-plus">+</span>{% endif %}
      <div class="price-item"><div class="price-pic">{{ it.pic }}</div><span class="tag-price"><i></i>{{ it.price }}</span></div>
      {% endfor %}
      {% if row['items']|length > 1 %}<span class="price-plus">=</span><span class="price-total"><i></i></span>{% endif %}
    </div>
    <span class="price-arrow" aria-hidden="true">{{ icon('crayon') }}</span>
    <div class="purse">{% for piece in row.pieces %}{{ piece }}{% endfor %}</div>
  </div>
  {% endfor %}
</div>
{% endif %}
