{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, false, true) }}
  <div class="isl-body pg uc{{ ' uc-roomy' if d.parts <= 2 }}">
    {% if d.learned %}<section class="pg-card"><div class="pg-ico">{{ icon('check', 'ico', 2.4) }}</div><div class="pg-text"><h2>{{ d.labels.learned }}</h2>
      <ul class="uc-list">{% for t in d.learned %}<li>{{ icon('star', 'star-outline', 1.5) }}<span>{{ t }}</span></li>{% endfor %}</ul></div></section>{% endif %}
    {% if d.apply %}<section class="pg-card"><div class="pg-ico">{{ icon('target', 'ico', 2.2) }}</div><div class="pg-text"><h2>{{ d.labels.apply }}</h2><p>{{ d.apply }}</p>
      {% if d.apply_choices %}<div class="uc-choices">{% for t in d.apply_choices %}<div class="ur-choice"><span class="tick"></span><span class="ur-ct">{{ t }}</span></div>{% endfor %}</div>{% endif %}</div></section>{% endif %}
    {% if d.dhikr %}<section class="uc-dhikr"><div class="dk-say-l">{{ d.labels.dhikr }}</div>{{ isl.sacred(d.dhikr, c) }}{% if d.dhikr_when %}<p class="uc-when">{{ icon('clock', 'ico', 2.2) }}{{ d.dhikr_when }}</p>{% endif %}</section>{% endif %}
    {% if d.challenge %}<section class="pg-card"><div class="pg-ico">{{ icon('family', 'ico', 2.2) }}</div><div class="pg-text"><h2>{{ d.labels.challenge }}</h2><p>{{ d.challenge }}</p>
      <div class="dk-days">{% for n in d.days %}<span>{{ icon('star', 'star-outline', 1.5) }}<i>{{ n }}</i></span>{% endfor %}</div></div></section>{% endif %}
    {{ isl.refs(c, d.refs) }}
  </div>
  {{ isl.foot(p, c) }}
</div>
