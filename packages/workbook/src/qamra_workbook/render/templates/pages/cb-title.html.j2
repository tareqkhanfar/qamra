{#- «دفاتر التلوين والرسم»: the title page (render/pages/coloring.py cb_title). -#}
<div class="cb-sheet cb-titlepage">
  <p class="cb-booktitle" style="text-shadow: {{ d.hollow_big }}" data-fit="30">{{ d.title }}</p>
  <div class="cb-art">{{ d.art }}</div>
  <p class="cb-owner">{{ d.owner }}</p>
  <p class="cb-name" style="text-shadow: {{ d.hollow_big }}" data-fit="26">{{ d.name }}</p>
</div>
