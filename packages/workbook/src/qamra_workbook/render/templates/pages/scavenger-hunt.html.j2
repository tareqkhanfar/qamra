{% if d.mode == 'checklist' %}
<div class="hunt checkhunt">
  {% if d.safety %}<div class="hunt-safety"><span class="hs-ico">{{ icon('shield') }}</span><span data-fit="8">{{ d.safety }}</span></div>{% endif %}
  <div class="check-grid n{{ d.finds|length }}">
    {% for it in d.finds %}
    <div class="citem fcard lvl{{ it.level }}">
      <span class="ci-level">{{ stars(it.level) }}</span>
      <div class="ci-pic">{{ it.pic }}</div>
      <b>{{ it.word }}</b>
      <div class="ci-foot"><span class="check-box"></span>{% if d.count %}<span class="ci-count"><small>كم مرة؟</small><i></i></span>{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  <div class="hunt-bottom">
    {% if d.compare %}<div class="compare fcard lvl2"><span class="label">{{ stars(2) }}{{ d.compare }}</span><div class="compare-boxes"><span></span><b>أم</b><span></span></div></div>{% endif %}
    <div class="found fcard"><span class="label">{{ icon('magnifier') }}{{ d.found_q }}</span><div class="found-nums">{% for n in d.total %}<span>{{ n }}</span>{% endfor %}</div></div>
  </div>
</div>
{% elif d.mode == 'colors' %}
<div class="hunt colorhunt">
  <div class="hunt-top fcard">
    <div class="hunt-kid">{% if d.character %}<img src="{{ d.character }}" alt="">{% endif %}</div>
    <div class="hunt-target">
      <div class="label">{{ icon('star') }}{{ d.lead }}</div>
      <div class="hunt-row">{% for c in d.columns %}<span class="swatch lvl{{ c.level }}" style="--pc: {{ c.paint }}"><i></i>{{ c.name }}</span>{% endfor %}</div>
    </div>
    <div class="hunt-basket">{{ d.basket }}</div>
  </div>
  <div class="color-cols">
    {% for c in d.columns %}
    <div class="color-col fcard lvl{{ c.level }}" style="--pc: {{ c.paint }}">
      <div class="color-head"><span class="blob"></span><b>{{ c.name }}</b><span class="color-hint">{{ c.hint }}</span>{% if c.level == 2 %}<span class="find-level">{{ stars(2) }}</span>{% endif %}</div>
      {% for n in d.boxes %}<div class="color-box"><span class="check-box"></span></div>{% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
{% else %}
<div class="hunt">
  <div class="hunt-top fcard">
    <div class="hunt-kid">{% if d.character %}<img src="{{ d.character }}" alt="">{% endif %}<span class="hunt-mag">{{ icon('magnifier') }}</span></div>
    <div class="hunt-target">
      <div class="label">{{ icon('magnifier') }}نبحث عن أشياء {{ d.shape_ar }}</div>
      <div class="hunt-row">
        <div class="hunt-shape">{{ d.shape }}</div>
        <span class="hunt-like">مثل:</span>
        {% for x in d.examples %}<div class="hunt-ex"><div class="hunt-ex-pic">{{ x.pic }}</div><small>{{ x.word }}</small></div>{% endfor %}
      </div>
    </div>
  </div>
  <div class="hunt-grid">
    {% for c in d.cards %}
    <div class="find fcard lvl{{ c.level }}">
      <div class="find-head"><span class="check-box"></span><span class="pill-num">{{ c.n }}</span><span class="find-level">{{ stars(c.level) }}</span></div>
      <div class="find-draw">{{ icon('pencil', 'ico find-hint') }}</div>
      <div class="write-line"></div>
    </div>
    {% endfor %}
    <div class="find count fcard">
      <div class="label">{{ d.found_q }}</div>
      <div class="count-dots">{% for n in d.count %}<span>{{ n }}</span>{% endfor %}</div>
      <div class="count-hint">{{ icon('crayon') }}<span>{{ 'لوّني العدد' if book.child.gender == 'f' else 'لوّن العدد' }}</span></div>
    </div>
  </div>
</div>
{% endif %}
