{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, false) }}
  <div class="isl-body pg pg-parent">
    {% for s in d.sections %}
    <section class="pg-card">
      <div class="pg-ico">{{ icon(s.icon, 'ico', 2.2) }}</div>
      <div class="pg-text"><h2>{{ s.label }}</h2><p{% if s.ai %} class="ai"{% endif %}>{{ s.text }}</p></div>
    </section>
    {% endfor %}
    <aside class="pg-care"><div class="pg-care-ico">{{ icon('book', 'ico', 2) }}</div><p>{{ d.care }}</p></aside>
    {{ isl.refs(c, d.refs) }}
  </div>
  {{ isl.foot(p, c) }}
</div>
