<div class="finger-page">
  <div class="finger-card">
    <div class="finger-hint">{{ icon('hand') }}<span>ابدأ من النقطة الخضراء</span></div>
    {{ d.letter }}
  </div>
  <div class="finger-bottom">
    <div class="word-card">
      <div class="word-pic">{{ d.pic }}</div>
      <div class="word-text">{{ d.word }}</div>
    </div>
    {{ ui.qr_card(p, 'اسمع صوت الحرف', 'امسحوا الرمز ليسمع الطفل «' ~ d.char ~ '» والكلمة.') }}
  </div>
</div>
