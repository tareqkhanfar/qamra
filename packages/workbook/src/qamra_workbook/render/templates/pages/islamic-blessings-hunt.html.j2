{% import "pages/_islamic.html.j2" as isl with context %}
{% set c = d.chrome %}
<div class="isl" {{ isl.container(c) }}>
  {{ isl.start(p, g, c) }}
  {{ isl.head(p, c, true, true) }}
  <div class="isl-body hn">
    <figure class="hn-scene">{{ d.scene }}{% if solved %}{{ d.rings }}{% endif %}</figure>
    <section class="hn-list">{% for it in d.finds %}<div class="hn-item card">{{ it.art }}<span>{{ it.word }}</span><i class="tick"></i></div>{% endfor %}</section>
    <section class="hn-close card"><p{{ ' class=ai' if d.closing.ai }}>{{ d.closing.text }}</p></section>
    <section class="hn-draw"><span class="pill">{{ icon('crayon', 'ico', 2.2) }}{{ d.draw_box }}</span><div class="hn-box"></div></section>
    {{ isl.refs(c, d.refs) }}
  </div>
  {{ isl.foot(p, c) }}
</div>
