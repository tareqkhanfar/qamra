<div class="fhouse">
  <svg class="fh-roof" viewBox="0 0 186 34" preserveAspectRatio="none" aria-hidden="true">
    <rect x="140" y="2" width="12" height="22" rx="1.5" fill="#E7B070"/>
    <path d="M6 33 L93 3 L180 33 Z" fill="var(--c)" stroke="#FFFFFF" stroke-width="1.2" stroke-linejoin="round"/>
    <path d="M22 33 L93 9 L164 33" fill="none" stroke="#FFFFFF" stroke-width="0.6" stroke-dasharray="2 2" opacity="0.7"/>
  </svg>
  <div class="fh-sign"><span data-fit="10">{{ d.house }}</span></div>
  <div class="fh-body fcard" style="--cols: {{ d.columns }}; --rows: {{ d.rows }}">
    {% for f in d.frames %}
    <div class="portrait{{ ' me' if f.child }}{{ ' more' if not f.name and not f.child }}" style="--fc: {{ f.color }}">
      <div class="pt-frame"><div class="pt-face">{% if loop.first %}<small>{{ d.face_hint }}</small>{% endif %}</div></div>
      <div class="pt-plate">
        {% if f.name %}<b class="pt-name" data-fit="9">{{ f.name }}</b>{% else %}<span class="write-line"></span>{% endif %}
        {% if f.role %}<small class="pt-role" data-fit="7">{{ f.role }}</small>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>
