<div class="fcert">
  <svg class="fcert-border" viewBox="0 0 186 244" preserveAspectRatio="none" aria-hidden="true">
    <rect x="1.5" y="1.5" width="183" height="241" rx="11" fill="#FFFFFF" stroke="#D9486B" stroke-width="2.4"/>
    <rect x="6.2" y="6.2" width="173.6" height="231.6" rx="7.5" fill="none" stroke="#F2B33D" stroke-width="0.8" stroke-dasharray="1.6 1.8"/>
  </svg>
  <svg class="fcert-confetti" viewBox="0 0 186 244" aria-hidden="true">
    {% for x, y, r, c in [(16,18,5.5,'#F2B33D'),(170,19,5,'#F2B33D'),(12,112,4,'#E4769D'),(174,104,4.6,'#2E9FD6'),(15,226,5,'#2FA36B'),(171,228,5.5,'#F2B33D'),(30,48,3,'#8C6CCB'),(157,50,3.2,'#F08A3E'),(152,232,3.2,'#E4769D'),(176,166,3.6,'#F2B33D'),(10,170,3.6,'#F08A3E'),(36,234,3,'#2E9FD6')] %}
    <path d="{{ d.star(x, y, r) }}" fill="{{ c }}" stroke="#FFFFFF" stroke-width="0.6" stroke-linejoin="round"/>
    {% endfor %}
  </svg>
  <div class="fcert-body">
    <div class="fcert-ribbon">
      <svg viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true"><path d="M0 4 L10 4 L10 18 L0 18 L5 11 Z M120 4 L110 4 L110 18 L120 18 L115 11 Z" fill="#A8304F"/><path d="M8 1 L112 1 L112 17 L8 17 Z" fill="#D9486B"/></svg>
      <span>{{ p.title }}</span>
    </div>
    <p class="fcert-line">{{ d.line }}</p>
    <div class="fcert-hero">
      <svg class="fcert-burst" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="48" fill="#FDEBD2"/>
        {% for i in range(16) %}<path d="M50 50 L{{ d.ray(i, 0) }} L{{ d.ray(i, 1) }} Z" fill="#F9D9A0" opacity="0.7"/>{% endfor %}
        <circle cx="50" cy="50" r="30" fill="#FFF5E6"/>
      </svg>
      {% if d.character %}<img class="fcert-child" src="{{ d.character }}" alt="">{% endif %}
      <div class="fcert-medal">{{ d.medal }}</div>
    </div>
    <div class="fcert-name"><span data-fit="18">{{ d.name }}</span></div>
    <div class="fcert-family">{{ icon('heart') }}<span data-fit="13">عائِلَةُ {{ d.family }}</span>{{ icon('heart') }}</div>
    <div class="fcert-members" data-fit="9">{{ d.members }}</div>
    <div class="fcert-badges">{% for b in d.badges %}{{ b }}{% endfor %}</div>
    <div class="fcert-sign">
      <div><span class="fcert-label">التّاريخُ</span><span class="fcert-value{% if not d.date %} blank{% endif %}">{{ d.date }}</span></div>
      <div><span class="fcert-label">تَوْقيعُ العائِلَةِ</span><span class="fcert-value blank"></span></div>
    </div>
    <div class="say fcert-say">{{ mascot('mascot', true) }}<div class="bubble">{{ p.instruction }}</div></div>
  </div>
</div>
