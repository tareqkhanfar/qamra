{#- «أُلَوِّنُ حُروفي»: my name to colour and a frame to draw myself (cb_me). -#}
<div class="cb-sheet cb-me">
  <p class="cb-lead">{{ d.lead }}</p>
  <p class="cb-name" style="text-shadow: {{ d.hollow }}" data-fit="26">{{ d.name }}</p>
  <div class="cb-box"><p class="cb-boxlabel">{{ d.prompt }}</p></div>
  <div class="cb-folio">{{ p.folio }}</div>
</div>
