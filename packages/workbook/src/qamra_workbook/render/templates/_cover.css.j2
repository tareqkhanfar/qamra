/* The activity series' covers (render/covers.py, _cover.html.j2): no tab, no page number, no footer; the
   panels are placed on the page by their boxes (mm) and the scene runs into the bleed. */
.type-workbook-cover-front .foot, .type-workbook-cover-back .foot, .type-journey-cover-front .foot,
.type-journey-cover-back .foot, .type-cover-front .foot, .type-cover-back .foot, .type-islamic-cover-front .foot,
.type-islamic-cover-back .foot, .type-islamic-cover-wrap .foot,
.type-workbook-cover-front .tab, .type-workbook-cover-back .tab, .type-journey-cover-front .tab,
.type-journey-cover-back .tab, .type-cover-front .tab, .type-cover-back .tab, .type-islamic-cover-front .tab,
.type-islamic-cover-back .tab, .type-islamic-cover-wrap .tab { display: none; }
.cv-root { position: absolute; left: calc(-1 * var(--inset)); top: calc(-1 * var(--inset)); width: {{ g.page_w }}mm;
           height: {{ g.page_h }}mm; overflow: hidden; z-index: 0; }
.cv { position: absolute; top: 0; overflow: hidden; }
.cv-scene { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.cv-noscene { background: linear-gradient(to bottom, #CFE9FA, #FFF6E2 62%, #CFE6BE); }
.cv-veil { position: absolute; inset: 0;
           background: linear-gradient(to bottom, rgba(255, 255, 255, .22), rgba(255, 255, 255, 0) 34%),
                       linear-gradient(to top, rgba(18, 20, 40, .28), rgba(18, 20, 40, 0) 13%); }
.cv-islamic .cv-veil { background: linear-gradient(to bottom, rgba(8, 20, 40, .18), rgba(8, 20, 40, 0) 34%),
                                   linear-gradient(to top, rgba(8, 20, 30, .32), rgba(8, 20, 30, 0) 13%); }

/* the brand and the age, on white pills at the top */
.cv-brand { position: absolute; display: flex; align-items: center; gap: 1.3mm; height: 9.5mm; padding: 0 3.6mm 0 2.2mm;
            border-radius: 4.75mm; background: #FFFFFF; box-shadow: 0 .7mm 1.8mm rgba(20, 24, 60, .22);
            font: 800 13pt/1 var(--title); color: var(--night); z-index: 3; }
.cv-brand .mascot { width: 7.4mm; height: 7.4mm; }
.cv-age { position: absolute; display: flex; align-items: center; gap: 1.4mm; height: 9.5mm; padding: 0 3.6mm 0 3mm;
          border-radius: 4.75mm; background: #FFFFFF; box-shadow: 0 .7mm 1.8mm rgba(20, 24, 60, .22);
          font: 700 11.5pt/1 var(--body); z-index: 3; }
.cv-age .ico { width: 4.6mm; height: 4.6mm; color: #F2B33D; }

/* the title panel: the series' shape (svg), the pills, the lettering, the subtitle */
.cv-panel { position: absolute; z-index: 2; }
.cv-panel .cvp-svg { position: absolute; left: -1mm; top: -2mm; }
.cv-pills { position: absolute; left: 0; right: 0; display: flex; justify-content: center; gap: 2mm; }
.cv-pill { display: inline-flex; align-items: center; height: 9mm; padding: 0 4.2mm .4mm; border-radius: 4.5mm;
           font: 800 12.5pt/1 var(--title); white-space: nowrap; }
.cv-pill b { font-weight: 800; }
.cv-pill.small { height: 7.4mm; padding: 0 3.2mm .3mm; font-size: 10.5pt; border-radius: 3.7mm; }
.cv-title { position: absolute; left: 7mm; right: 7mm; }
.cv-title svg, .cvk-title svg { display: block; overflow: visible; }
.cv-sub { position: absolute; left: 9mm; right: 9mm; display: flex; align-items: center; justify-content: center;
          text-align: center; font: 700 13.5pt/1.6 var(--naskh); overflow: hidden; }

/* the ribbon with the child's name */
.cv-ribbon { position: absolute; z-index: 3; filter: drop-shadow(0 .8mm 1.2mm rgba(10, 14, 40, .3)); }
.cv-ribbon svg { position: absolute; left: 0; top: 0; }
.cv-ribbon > span { position: absolute; left: 13mm; right: 13mm; top: 0; height: 100%; display: flex; align-items: center;
                    justify-content: center; font: 800 24pt/1 var(--title); white-space: nowrap; overflow: hidden;
                    padding-bottom: .6mm; }

/* the child, the blocks, the family */
.cv-floor { position: absolute; z-index: 1; }
.cv-hero { position: absolute; z-index: 2; display: block; }
.cv-block { position: absolute; z-index: 3; }
.cv-block svg { display: block; overflow: visible; }
.cv-group { position: absolute; z-index: 2; }
.cv-group > svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* the info badges along the bottom */
.cv-badges { position: absolute; height: 9.5mm; display: flex; justify-content: center; gap: 2.4mm; z-index: 3; }
.cv-badge { display: inline-flex; align-items: center; gap: 1.6mm; height: 9.5mm; padding: 0 3.4mm 0 1.4mm;
            border-radius: 4.75mm; background: #FFFFFF; box-shadow: 0 .7mm 1.8mm rgba(10, 14, 40, .25);
            font: 700 10.5pt/1 var(--body); white-space: nowrap; }
.cv-badge i { width: 6.8mm; height: 6.8mm; border-radius: 50%; display: flex; align-items: center; justify-content: center;
              color: #FFFFFF; flex: none; }
.cv-badge .ico { width: 4.2mm; height: 4.2mm; }
.cv-badge > span { display: block; max-width: 66mm; overflow: hidden; }

/* ---- the back ------------------------------------------------------------------------------------------- */
.cvk-band { position: absolute; left: 0; right: 0; top: 0; overflow: hidden; }
.cvk-band img { width: 100%; height: 100%; display: block; object-fit: cover; }
.cvk-wave { position: absolute; left: 0; width: 100%; }
.cvk-hero { position: absolute; z-index: 3; display: block; }
.cvk-body { position: absolute; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 4.6mm;
            overflow: hidden; }
.cvk-body > * { flex: none; }
.cvk-head { display: flex; flex-direction: column; align-items: flex-start; gap: 1.6mm; min-height: 24mm; padding-top: 6mm; }
.cvk-pills { display: flex; gap: 1.6mm; flex-wrap: wrap; }
.cvk-blurb p { font: 500 13pt/1.75 var(--body); }
.cvk-blurb p + p { margin-top: 1.4mm; font-size: 11.5pt; opacity: .78; }
.cvk-mid { display: flex; gap: 6mm; align-items: flex-start; }
.cvk-inside { flex: 1; min-width: 0; }
.cvk-mid.no-thumbs .cvk-inside { flex: 1 1 100%; }
.cvk-body h3 { display: flex; align-items: center; gap: 2mm; font: 800 15pt/1.2 var(--title); margin-bottom: 2.8mm; }
.cvk-body h3 i { width: 2.4mm; height: 5.4mm; border-radius: 1.2mm; }
.cvk-inside ul { list-style: none; display: grid; gap: 2.8mm 5mm; }
.cvk-inside ul.cols-2 { grid-template-columns: 1fr 1fr; gap: 2mm 3mm; }
.cvk-inside ul.cols-2 li { font-size: 11pt; gap: 1.8mm; }
.cvk-inside ul.cols-2 .cvk-ico { width: 7.6mm; height: 7.6mm; }
.cvk-inside ul.cols-2 .cvk-ico .ico, .cvk-inside ul.cols-2 .cvk-ico svg { width: 4.4mm; height: 4.4mm; }
.cvk-inside li { display: flex; align-items: center; gap: 2.4mm; font: 600 12.5pt/1.35 var(--body); }
.cvk-ico { width: 9mm; height: 9mm; border-radius: 50%; display: flex; align-items: center; justify-content: center;
           color: #FFFFFF; flex: none; }
.cvk-ico .ico, .cvk-ico svg { width: 5mm; height: 5mm; }
.cvk-thumbs { position: relative; flex: none; width: 80mm; height: 74mm; }
.cvk-thumbs img { position: absolute; width: 44mm; border-radius: 1.6mm; background: #FFFFFF;
                  box-shadow: 0 1mm 2.6mm rgba(20, 24, 60, .28), 0 0 0 .5mm #FFFFFF; }
.cvk-thumbs img.t1 { right: 1.5mm; top: 5mm; transform: rotate(4deg); z-index: 1; }
.cvk-thumbs img.t2 { right: 18mm; top: 1mm; transform: rotate(-2deg); z-index: 2; }
.cvk-thumbs img.t3 { right: 33mm; top: 6mm; transform: rotate(-5deg); z-index: 3; }
.cvk-chips { display: flex; flex-wrap: wrap; gap: 2mm 2.4mm; }
.cvk-chip { display: inline-flex; align-items: center; gap: 1.8mm; height: 9.6mm; padding: 0 3.8mm 0 1.4mm; border-radius: 4.8mm;
            background: #FFFFFF; box-shadow: 0 0 0 .35mm rgba(20, 24, 60, .12); font: 600 11.5pt/1 var(--body); white-space: nowrap; }
.cvk-chip i { width: 7mm; height: 7mm; border-radius: 50%; display: flex; align-items: center; justify-content: center;
              color: #FFFFFF; flex: none; }
.cvk-chip .ico { width: 3.9mm; height: 3.9mm; }
.cvk-books > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4mm; }
.cvk-books span { padding: .9mm 2mm 1.3mm; border-radius: 3mm; background: #FFFFFF; box-shadow: 0 0 0 .35mm rgba(20, 24, 60, .14);
                  font: 600 8.5pt/1.3 var(--naskh); text-align: center; white-space: nowrap; overflow: hidden; }
.cv-islamic .cvk-chip, .cv-family .cvk-chip { font-size: 10.5pt; height: 8.8mm; }
.cv-islamic .cvk-body { gap: 2.8mm; }
.cv-islamic .cvk-head { min-height: 21mm; padding-top: 4mm; }
.cvk-care { font: 500 9.5pt/1.5 var(--body); opacity: .8; }
.cvk-org { position: absolute; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 1.2mm;
           max-width: 64mm; padding: 2.4mm 3.2mm 2mm; border-radius: 4mm; background: #FFFFFF;
           box-shadow: 0 .7mm 1.8mm rgba(20, 24, 60, .22); }
.cvk-org img { display: block; object-fit: contain; }
.cvk-org span { display: block; max-width: 58mm; font: 700 9pt/1.3 var(--body); color: var(--ink-2); white-space: nowrap;
                overflow: hidden; }
.cvk-foot { display: flex; flex-direction: column; gap: 2.2mm; padding-top: 2.6mm; border-top: .35mm solid rgba(20, 24, 60, .14); }
.cvk-foot-row { display: flex; align-items: center; justify-content: space-between; gap: 3mm; }
.cvk-made { display: flex; align-items: center; gap: 1.4mm; min-width: 0; font: 700 10.5pt/1.25 var(--body); }
.cvk-made span { white-space: nowrap; overflow: hidden; min-width: 0; flex: 1; }
.cvk-made .ico { width: 4.6mm; height: 4.6mm; }
.cvk-facts { display: flex; gap: 1.4mm; flex: none; }
.cvk-facts span { padding: 1mm 2.6mm 1.4mm; border-radius: 3mm; background: rgba(20, 24, 60, .06); font: 600 9pt/1.2 var(--body); white-space: nowrap; }
.cvk-site { display: flex; align-items: center; gap: 1.2mm; flex: none; }
.cvk-site .mascot { width: 7mm; height: 7mm; }
.cvk-site b { font: 800 12pt/1 var(--title); color: var(--night); }
.cvk-site small { font: 700 10pt/1 var(--title); color: var(--muted); }

/* ---- the spine (perfect-bound) -------------------------------------------------------------------------- */
.cv-spine { position: absolute; top: 0; height: 100%; overflow: hidden; z-index: 4; }
.cv-spine-text { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%) rotate(90deg); white-space: nowrap;
                 display: flex; align-items: center; gap: 2.4mm; font-family: var(--title); font-weight: 800; color: #FFF8E6; line-height: 1; }
.cv-spine-text .nm { color: #F6C35A; }
.cv-spine-text .dot { width: 1.1mm; height: 1.1mm; border-radius: 50%; background: #F6C35A; display: inline-block; }
.cv-spine-moon { position: absolute; left: 50%; bottom: calc(var(--bleed) + 10mm); transform: translateX(-50%); }
.cv-spine-moon .mascot { width: 5mm; height: 5mm; display: block; }
