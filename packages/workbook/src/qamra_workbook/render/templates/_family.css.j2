/* ==== «مغامراتي مع عائلتي» (Addendum 7): the family adventure book. Scoped to .fam pages. ==== */
.fam { --sun: #F2B33D; --sun-deep: #B27A0C; --sun-glow: #FFF4D6; --pb: #FFF8E6; --pb-edge: #F3C75E; }

/* header: chip and activity tags on one row, a big friendly title, the moon guide */
.fam .head { gap: 3.4mm; margin-bottom: 4mm; }  /* a title's hamza and sukun («كَأْسَكِ») clear the tag row */
.fam .head-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 3mm; }
.fam .chip { height: 7.6mm; font-size: 9.5pt; }
.fam .title { font-size: 32pt; line-height: 1.12; }
.fam .bubble { font-size: 16pt; }

.tags { display: flex; gap: 1.5mm; align-items: center; }
.tag { display: inline-flex; align-items: center; gap: 1.2mm; height: 7.6mm; padding-inline: 1.1mm 2.6mm; border-radius: 3.8mm;
       background: var(--card); box-shadow: 0 0 0 0.35mm var(--line); font: 600 9pt var(--body); color: var(--ink-2);
       white-space: nowrap; }
.tag i { width: 5.6mm; height: 5.6mm; border-radius: 50%; display: flex; align-items: center; justify-content: center;
         color: #FFFFFF; flex: none; }
.tag i .ico { width: 3.7mm; height: 3.7mm; }
.t-home i { background: #F08A3E; } .t-out i { background: #5DAF4A; }
.t-fam i { background: #E4769D; } .t-time i { background: #2E9FD6; }
.t-level { padding-inline: 2.2mm; gap: 0; }
.t-level .stars { height: 4.4mm; width: auto; }
.t-level .or { width: 0.35mm; height: 4.2mm; background: var(--line); margin: 0 1.8mm; border-radius: 0.2mm; }

/* the parent box: one warm color through the whole book, so grown-ups learn to look for it */
.parent-box { position: relative; flex: none; margin-top: 7mm; padding: 5.4mm 5.5mm 3.2mm; border-radius: 5mm;
              background: var(--pb); border: 0.6mm solid var(--pb-edge); box-shadow: 0 0.9mm 0 #F7E2B0; }
.pb-tag { position: absolute; top: -4.5mm; inset-inline-start: 5mm; height: 9mm; display: inline-flex; align-items: center;
          gap: 1.8mm; padding-inline: 1.2mm 4mm; border-radius: 4.5mm; background: var(--sun); color: #FFFFFF;
          font: 800 12.5pt/1 var(--title); box-shadow: 0 0.7mm 0 var(--sun-deep); }
.pb-tag > span:last-child { padding-top: 0.8mm; }
.pb-ico { width: 6.8mm; height: 6.8mm; border-radius: 50%; background: #FFFFFF; color: var(--sun-deep); display: flex;
          align-items: center; justify-content: center; }
.pb-ico .ico { width: 4.8mm; height: 4.8mm; }
.pb-for { position: absolute; top: 1.6mm; inset-inline-end: 4.5mm; font: 700 8.5pt var(--body); color: var(--sun-deep);
          letter-spacing: 0; opacity: 0.85; }
.parent-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.9mm; font: 500 11pt/1.42 var(--body);
                 color: var(--ink); max-height: 23mm; overflow: hidden; }
.parent-box li { position: relative; padding-inline-start: 4.6mm; }
.parent-box li::before { content: ""; position: absolute; inset-inline-start: 0.4mm; top: 0.62em; width: 2.1mm; height: 2.1mm;
                         border-radius: 50%; background: var(--sun); }

/* shared family pieces */
.fcard { background: var(--card); border: 0.5mm solid var(--line); border-radius: 6mm; box-shadow: 0 0.9mm 0 var(--line-soft); }
.label { font: 700 12pt/1.3 var(--body); color: var(--deep); display: flex; align-items: center; gap: 1.8mm; }
.label .ico { width: 5.6mm; height: 5.6mm; color: var(--c); flex: none; }
.write-line { border-bottom: 0.45mm dashed #CDBF9F; height: 9mm; }
.check-box { width: 7mm; height: 7mm; border: 0.6mm solid var(--c); border-radius: 2mm; background: #FFFFFF; flex: none; }
.pill-num { min-width: 8mm; height: 8mm; border-radius: 4mm; background: var(--c); color: #FFFFFF; display: inline-flex;
            align-items: center; justify-content: center; font: 800 12pt/1 var(--title); padding: 0.8mm 1.8mm 0; }

/* ---- passport */
.pass { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.pass-card { position: relative; border-radius: 6mm; background: #FFFFFF; border: 0.6mm solid #C9CFEA; overflow: hidden;
             box-shadow: 0 1.2mm 0 #DDE1F3; }
.pass-band { height: 13mm; background: var(--c); display: flex; align-items: center; gap: 3mm; padding-inline: 4mm; color: #FFFFFF; }
.pass-band .mascot { width: 10mm; height: 10mm; }
.pass-band-text { display: flex; flex-direction: column; line-height: 1.15; }
.pass-band-text b { font: 800 14pt/1.1 var(--title); color: #FFE7A3; }
.pass-band-text span { font: 600 8.5pt var(--body); opacity: 0.85; }
.pass-emblem { margin-inline-start: auto; width: 9.5mm; height: 9.5mm; border-radius: 50%; background: rgba(255,255,255,0.14);
               display: flex; align-items: center; justify-content: center; }
.pass-emblem .ico { width: 6mm; height: 6mm; color: #FFE7A3; }
.pass-body { display: flex; gap: 5mm; padding: 4mm 5mm 3.5mm; }
.pass-photo { position: relative; width: 34mm; height: 42mm; flex: none; border-radius: 4mm; overflow: hidden;
              background: linear-gradient(#E3E6F5, #F5F6FC); border: 0.6mm solid #C9CFEA; }
.pass-photo img { position: absolute; left: 50%; top: 2.2mm; width: 50mm; transform: translateX(-50%); }
.pass-photo-stamp { position: absolute; left: 1.6mm; bottom: 1.6mm; width: 8mm; height: 8mm; border-radius: 50%; background: #F2B33D;
                    color: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 0.6mm #FFFFFF; }
.pass-photo-stamp .ico { width: 5mm; height: 5mm; }
.pass-fields { flex: 1; min-width: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2.4mm 5mm; align-content: start; }
.pf { display: flex; flex-direction: column; gap: 0.6mm; min-width: 0; }
.pf dt { font: 600 8.5pt var(--body); color: var(--muted); }
.pf dd { font: 800 16pt/1.25 var(--title); color: var(--night); white-space: nowrap; overflow: hidden;
         border-bottom: 0.4mm solid var(--line); padding-bottom: 0.6mm; }
.pf:nth-child(3) dd, .pf:nth-child(4) dd { font: 700 12.5pt/1.5 var(--body); }
.pf.sign { grid-column: 1 / -1; }
.pf.sign dd { height: 8mm; border-bottom: 0.45mm dashed #B9BFDD; }
.pass-strip { height: 6mm; background: #F3F4FB; display: flex; align-items: center; justify-content: space-around; padding-inline: 4mm;
              border-top: 0.4mm dashed #C9CFEA; }
.pass-strip .ico { width: 3.6mm; height: 3.6mm; color: #9AA3D6; }
.stamps-card { flex: 1; min-height: 0; padding: 3.5mm 4mm 2.5mm; display: flex; flex-direction: column; gap: 1.5mm; }
.stamps { flex: 1; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1mm 1mm; align-content: space-evenly; }
.slot { display: flex; flex-direction: column; align-items: center; gap: 0.6mm; min-width: 0; }
.slot .seal { width: 27mm; height: 27mm; }
.slot-label { font: 700 8.5pt/1.2 var(--body); max-width: 29mm; white-space: nowrap; overflow: hidden; text-align: center; }

/* ---- the opening spread (the art is under the section tab and the footer) */
.fam .tab { z-index: 3; }
.frame-full.type-section-opener .foot { position: relative; z-index: 2; }
.spread { position: relative; flex: 1; }
.spread-art { position: absolute; top: calc(-1 * var(--inset)); }
.spread-art > svg { width: 100%; height: 100%; }
.op-text { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5mm; padding-top: 10mm; }
.op-adv { display: inline-flex; align-items: center; gap: 2mm; height: 10mm; padding-inline: 2mm 5mm; border-radius: 5mm;
          background: var(--c); color: #FFFFFF; font: 800 14pt/1 var(--title); box-shadow: 0 1mm 0 var(--deep); }
.op-adv .ico { width: 7mm; height: 7mm; padding: 1mm; border-radius: 50%; background: #FFFFFF; color: var(--c); }
.op-adv span { padding-top: 1mm; }
.op-title { font: 800 54pt/1.05 var(--title); color: var(--deep); text-align: center; text-shadow: 0 1.2mm 0 #FFFFFF;
            padding-top: 3mm; }  /* the marks above the first line clear the «المغامرة» pill */
.op-hook { position: relative; width: 150mm; background: #FFFFFF; border-radius: 8mm; padding: 6mm 9mm 6mm 8mm;
           box-shadow: 0 1.4mm 0 var(--tint), 0 0 0 0.6mm var(--tint); }
.op-hook p { font: 600 15pt/1.75 var(--body); color: var(--ink); text-align: center; }
.op-hook .mascot { position: absolute; left: -8mm; top: -9mm; width: 18mm; height: 18mm; }
.op-inside { width: 150mm; display: flex; flex-direction: column; align-items: center; gap: 2.5mm; }
.op-inside-head { font: 800 13pt var(--title); color: var(--deep); }
.op-items { width: 100%; display: flex; justify-content: space-between; gap: 3mm; }
.op-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1.5mm; background: rgba(255,255,255,0.9);
           border-radius: 5mm; padding: 3mm 2mm 2.5mm; font: 700 11pt/1.3 var(--body); color: var(--ink); text-align: center; }
.op-ico { width: 11mm; height: 11mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center;
          justify-content: center; }
.op-ico .ico { width: 6.5mm; height: 6.5mm; }
.op-stamp { position: relative; display: flex; align-items: center; gap: 5mm; margin: 6mm auto 0; width: 150mm; padding: 4mm 6mm;
            background: rgba(255,255,255,0.92); border-radius: 8mm; box-shadow: 0 1.2mm 0 var(--tint), 0 0 0 0.6mm var(--tint); }
.op-seal { width: 36mm; height: 36mm; flex: none; transform: rotate(-8deg); }
.op-seal .seal { width: 100%; height: 100%; }
.op-stamp-text { display: flex; flex-direction: column; gap: 1mm; min-width: 0; }
.op-stamp-text small { font: 600 10.5pt var(--body); color: var(--muted); }
.op-stamp-text b { font: 800 22pt/1.2 var(--title); color: var(--deep); white-space: nowrap; overflow: hidden; }
.op-stamp-text span { display: inline-flex; align-items: center; gap: 1.5mm; font: 600 10pt var(--body); color: var(--ink-2); }
.op-stamp-text .ico { width: 5mm; height: 5mm; color: var(--c); }
.op-family { position: absolute; left: 0; right: 0; bottom: 19mm; height: 140mm; }
.op-family > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.op-tag { position: absolute; transform: translateX(-50%); height: 7.4mm; padding: 0 2.6mm; border-radius: 3.7mm; background: #FFFFFF;
          font: 700 10.5pt/7.4mm var(--body); color: var(--ink); white-space: nowrap; overflow: hidden; text-align: center;
          box-shadow: 0 0 0 0.4mm var(--tint), 0 0.8mm 0 rgba(28,33,64,0.12); }
.op-tag.child { background: var(--c); color: #FFFFFF; font-weight: 800; }
.op-family-name { position: absolute; left: 50%; bottom: 6mm; transform: translateX(-50%); display: flex; align-items: center; gap: 2mm;
                  height: 10mm; padding-inline: 3mm 5mm; border-radius: 5mm; background: var(--deep); color: #FFFFFF;
                  font: 800 14pt/1 var(--title); max-width: 120mm; }
.op-family-name .ico { width: 6mm; height: 6mm; flex: none; }
.op-family-name span { white-space: nowrap; overflow: hidden; padding-top: 1mm; line-height: 1.5; }  /* room for the dots under «الزعبي» */

/* ---- treasure hunt */
.hunt { flex: 1; display: flex; flex-direction: column; gap: 4.5mm; }
.hunt-top { display: flex; align-items: stretch; gap: 3mm; padding: 3mm 5mm; height: 40mm; flex: none; }
.hunt-kid { position: relative; width: 26mm; flex: none; }
.hunt-kid img { position: absolute; bottom: -1mm; left: 50%; height: 40mm; transform: translateX(-50%); }
.hunt-mag { position: absolute; left: -3mm; top: 6mm; width: 12mm; height: 12mm; border-radius: 50%; background: #FFFFFF; color: var(--c);
            display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 0.5mm var(--c); }
.hunt-mag .ico { width: 8mm; height: 8mm; }
.hunt-target { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 2mm; }
.hunt-row { display: flex; align-items: center; gap: 3.5mm; }
.hunt-shape svg { width: 20mm; height: 20mm; }
.hunt-like { font: 700 11pt var(--body); color: var(--muted); }
.hunt-ex { display: flex; flex-direction: column; align-items: center; }
.hunt-ex-pic { width: 17mm; height: 17mm; }
.hunt-ex small { font: 600 8.5pt var(--naskh); color: var(--muted); }
.hunt-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 1.2fr 1fr; gap: 4mm; min-height: 0; }
.find { display: flex; flex-direction: column; padding: 2.5mm 3mm 3mm; gap: 1.5mm; min-height: 0; }
.find.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.find-head { display: flex; align-items: center; gap: 2mm; }
.find-level { margin-inline-start: auto; }
.find-level .stars { height: 4.6mm; width: auto; }
.find-draw { position: relative; flex: 1; border-radius: 4mm; background: #FFFFFF; border: 0.4mm dashed #EADFC8; }
.find-hint { position: absolute; bottom: 1.5mm; inset-inline-end: 1.5mm; width: 5mm; height: 5mm; color: #D8CBB0; }
.find .write-line { height: 7mm; }
.find.count { justify-content: center; align-items: center; gap: 3mm; background: var(--tint); border-color: transparent; }
.find.count .label { font-size: 12.5pt; text-align: center; }
.count-dots { display: grid; grid-template-columns: repeat(3, auto); gap: 2mm; justify-content: center; direction: rtl; }
.count-dots span { width: 11mm; height: 11mm; border-radius: 50%; background: #FFFFFF; border: 0.6mm solid var(--c); display: flex;
                   align-items: center; justify-content: center; font: 800 14pt/1 var(--title); color: var(--deep); padding-top: 1mm; }
.count-hint { display: flex; align-items: center; gap: 1.2mm; font: 600 8.5pt var(--body); color: var(--deep); }
.count-hint .ico { width: 4mm; height: 4mm; }

/* ---- shopping list */
.shop { flex: 1; display: flex; flex-direction: column; gap: 4.5mm; }
.shop-top { flex: 1; display: flex; gap: 4mm; min-height: 0; }
.notepad { position: relative; flex: 1; padding: 7mm 5mm 3mm; display: flex; flex-direction: column; gap: 2mm; background: #FFFFFF;
           background-image: linear-gradient(90deg, transparent 0, transparent calc(100% - 9mm), #F9D9D9 calc(100% - 9mm), #F9D9D9 calc(100% - 8.6mm), transparent calc(100% - 8.6mm)); }
.notepad-rings { position: absolute; top: -3.2mm; left: 8mm; right: 8mm; display: flex; justify-content: space-between; }
.notepad-rings span { width: 3.4mm; height: 7mm; border-radius: 1.7mm; background: #FFFFFF; border: 0.6mm solid #B9BFDD; }
.notepad-head { display: flex; align-items: center; justify-content: space-between; }
.notepad-count { font: 700 10pt var(--body); color: var(--muted); margin-inline-end: 4mm; }
.list-row { flex: 1; display: flex; align-items: center; gap: 2.5mm; border-bottom: 0.4mm solid #EFE5D2; min-height: 0; }
.list-row:last-child { border-bottom: 0; }
.list-draw { width: 16mm; height: 16mm; flex: none; border: 0.5mm dashed #D8CBB0; border-radius: 3.5mm; }
.list-write { flex: 1; }
.list-count { display: grid; grid-template-columns: repeat(3, 4.8mm); gap: 1mm; flex: none; direction: rtl; }
.list-count span { width: 4.8mm; height: 4.8mm; border-radius: 50%; border: 0.5mm solid var(--c); }
.shop-side { width: 58mm; flex: none; display: flex; flex-direction: column; gap: 3mm; }
.market-sign { position: relative; background: var(--c); color: #FFFFFF; border-radius: 4mm; padding: 6.5mm 2mm 2.2mm; text-align: center;
               box-shadow: 0 1mm 0 var(--deep); overflow: hidden; }
.market-sign .awning { position: absolute; left: 0; right: 0; top: 0; height: 4.5mm;
                       background: repeating-linear-gradient(90deg, #FFFFFF 0 5mm, #F2B33D 5mm 10mm); border-bottom-left-radius: 2mm; border-bottom-right-radius: 2mm; }
.market-sign b { display: block; font: 800 15pt/1.25 var(--title); white-space: nowrap; overflow: hidden; }
.shop-scene { position: relative; flex: 1; min-height: 0; }
.shop-kid { position: absolute; bottom: 0; right: 2mm; height: 92%; }
.shop-bag { position: absolute; bottom: 0; left: -1mm; width: 27mm; height: 27mm; }
.choose { flex: none; padding: 3.5mm 4.5mm 3mm; display: flex; flex-direction: column; gap: 2.5mm; }
.choose-head { display: flex; align-items: center; justify-content: space-between; gap: 3mm; }
.choose-head .label { font-size: 11.5pt; }
.legend { display: flex; gap: 2mm; }
.lg { display: inline-flex; align-items: center; gap: 1mm; font: 700 9pt var(--body); color: var(--ink-2); }
.lg i, .cc { width: 5.4mm; height: 5.4mm; border-radius: 50%; background: var(--cc); color: #FFFFFF; display: inline-flex;
             align-items: center; justify-content: center; flex: none; }
.lg .ico, .cc .ico { width: 3.6mm; height: 3.6mm; }
.products { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2.5mm; }
.product { display: flex; flex-direction: column; align-items: center; gap: 0.6mm; background: #FFFCF6; border-radius: 4mm; padding: 1.5mm 1mm 2mm; }
.product-pic { width: 15mm; height: 15mm; }
.product small { font: 700 9pt var(--naskh); color: var(--ink-2); white-space: nowrap; }
.chips { display: flex; gap: 1mm; }
.chips .cc { background: #FFFFFF; color: var(--cc); box-shadow: inset 0 0 0 0.45mm var(--cc); }

/* ---- recipe */
.recipe { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; }
.ingredients { flex: none; padding: 3mm 4.5mm 3.5mm; display: flex; flex-direction: column; gap: 2mm; }
.ing-row { display: flex; gap: 3mm; }
.ing { flex: 1; display: flex; align-items: center; gap: 1.6mm; background: #FFFCF6; border-radius: 4.5mm; padding: 2mm 2.2mm; }
.ing-pic { width: 15.5mm; height: 15.5mm; flex: none; }
.ing-text { flex: 1; display: flex; flex-direction: column; gap: 0.8mm; min-width: 0; }
.ing-text b { font: 700 11.5pt/1.2 var(--body); color: var(--ink); white-space: nowrap; }
.spoons { display: flex; flex-wrap: wrap; gap: 0; color: var(--c); }
.spoons { flex-wrap: nowrap; }
.spoons .ico { width: 5.2mm; height: 5.2mm; flex: none; }
.ing-box { display: flex; flex-direction: column; align-items: center; gap: 0.4mm; }
.ing-box small { font: 700 8pt var(--body); color: var(--muted); }
.ing-box .box { width: 10mm; height: 10mm; border: 0.6mm solid var(--c); border-radius: 2.5mm; background: #FFFFFF; display: flex;
                align-items: center; justify-content: center; font: 800 13pt var(--title); color: var(--answer); }
.steps-head { margin-top: 0.5mm; }
.steps { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3.5mm; min-height: 0; }
.step { position: relative; display: flex; flex-direction: column; align-items: center; padding: 8mm 2mm 3mm; gap: 2mm; }
.step-num { position: absolute; top: -3mm; left: 50%; transform: translateX(-50%); width: 11mm; height: 11mm; border-radius: 50%;
            background: #FFFFFF; border: 0.7mm dashed var(--c); display: flex; align-items: center; justify-content: center;
            font: 800 15pt/1 var(--title); color: var(--answer); padding-top: 1mm; }
.step-pic { flex: 1; width: 100%; min-height: 0; display: flex; align-items: center; justify-content: center;
            border-radius: 4.5mm; background: #FFF6F2; }
.step-pic svg { width: 39mm; height: 39mm; }
.step-text { font: 700 11.5pt/1.3 var(--body); color: var(--ink); text-align: center; min-height: 8mm; }
.safety { flex: none; position: relative; margin-top: 4mm; border-radius: 5mm; border: 0.6mm solid #EE8A7A; background: #FFF3EF;
          padding: 5.5mm 4mm 3mm; }
.safety-tag { position: absolute; top: -4.3mm; inset-inline-start: 5mm; height: 8.6mm; display: inline-flex; align-items: center; gap: 1.5mm;
              padding-inline: 2mm 4mm; border-radius: 4.3mm; background: #E4675A; color: #FFFFFF; font: 800 12pt/1 var(--title);
              box-shadow: 0 0.7mm 0 #962C22; }
.safety-tag .ico { width: 5.5mm; height: 5.5mm; }
.safety-tag span { padding-top: 0.8mm; }
.safety-items { display: flex; gap: 3mm; }
.safety-item { flex: 1; display: flex; align-items: center; gap: 2mm; font: 700 10pt/1.35 var(--body); color: #7A2A20; }
.safety-ico { width: 9mm; height: 9mm; border-radius: 50%; background: #FFFFFF; color: #E4675A; flex: none; display: flex;
              align-items: center; justify-content: center; box-shadow: 0 0 0 0.5mm #F5B7AC; }
.safety-ico .ico { width: 5.6mm; height: 5.6mm; }

/* ---- feelings thermometer */
.feel { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; }
.feel-main { flex: 1; display: flex; gap: 4mm; min-height: 0; }
.thermo-card { width: 84mm; flex: none; padding: 3.5mm 4mm; display: flex; flex-direction: column; gap: 2mm; }
.thermo-card { justify-content: space-between; }
.thermo-wrap { display: flex; gap: 1mm; flex: none; margin-bottom: 1mm; }
.thermo-svg { width: 30mm; flex: none; }
.thermo-svg svg { width: 30mm; height: 100%; }
.levels { position: relative; flex: 1; }
.level { position: absolute; top: 0; inset-inline: 0; display: flex; align-items: center; gap: 2mm; transform: translateY(-50%); }
.lv-face svg { width: 15mm; height: 15mm; }
.lv-label { font: 800 12pt/1.2 var(--title); color: var(--ink); border-bottom: 1mm solid var(--lc); padding-bottom: 0.3mm; }
.feel-side { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-width: 0; }
.when { padding: 3.5mm 4mm; display: flex; flex-direction: column; gap: 2.5mm; }
.faces { display: flex; justify-content: space-around; }
.face-opt { display: flex; flex-direction: column; align-items: center; gap: 1mm; font: 700 10.5pt var(--body); color: var(--ink-2); }
.face-opt svg { width: 19mm; height: 19mm; }
.can { flex: 1; padding: 3.5mm 4mm; display: flex; flex-direction: column; gap: 2.5mm; min-height: 0; }
.strategies { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5mm; align-content: space-evenly; }
.strat { display: flex; align-items: center; gap: 2mm; background: #FFFCF6; border: 0.45mm solid var(--line); border-radius: 5mm;
         padding: 1.6mm 2mm; min-width: 0; }
.strat > span:last-child { font: 700 10.5pt/1.25 var(--body); color: var(--ink); white-space: nowrap; overflow: hidden; }
.strat-ico { width: 9mm; height: 9mm; border-radius: 50%; background: var(--tint); color: var(--deep); display: flex;
             align-items: center; justify-content: center; flex: none; }
.strat-ico .ico { width: 5.6mm; height: 5.6mm; }
.my-idea { display: flex; align-items: flex-end; gap: 2mm; }
.idea-label { display: inline-flex; align-items: center; gap: 1mm; font: 700 10.5pt var(--body); color: var(--deep); white-space: nowrap; }
.idea-label .stars { height: 4mm; width: auto; }
.my-idea .write-line { flex: 1; height: 8mm; }
.feel-note { flex: none; align-self: center; display: inline-flex; align-items: center; gap: 2mm; padding: 1.8mm 6mm; border-radius: 6mm;
             background: var(--tint); color: var(--deep); font: 800 12.5pt var(--title); }
.feel-note .ico { width: 5mm; height: 5mm; color: var(--c); }

/* ---- memory page */
.memory { flex: 1; display: flex; flex-direction: column; gap: 4mm; }
.mem-top { flex: 1; display: flex; gap: 6mm; min-height: 0; padding-top: 2mm; }
.polaroid { position: relative; width: 88mm; flex: none; background: #FFFFFF; padding: 4mm 4mm 0; transform: rotate(-2.5deg);
            box-shadow: 0 0 0 0.4mm #E6DCC6, 0 1.6mm 2.4mm rgba(28,33,64,0.12); display: flex; flex-direction: column; }
.photo-slot { flex: 1; border-radius: 1.5mm; background: #F3EFE6; border: 0.5mm dashed #CDBF9F; display: flex; flex-direction: column;
              align-items: center; justify-content: center; gap: 2mm; color: #A99A7A; font: 700 11pt var(--body); }
.photo-slot .ico { width: 13mm; height: 13mm; }
.pol-caption { height: 13mm; }
.tape { position: absolute; width: 20mm; height: 7mm; background: rgba(242,179,61,0.45); top: -3mm; }
.tape.t1 { right: 8mm; transform: rotate(8deg); } .tape.t2 { left: 8mm; transform: rotate(-10deg); }
.mem-draw { flex: 1; padding: 3.5mm 4mm; display: flex; flex-direction: column; }
.mem-stars { flex: none; padding: 3mm 5mm; display: flex; align-items: center; justify-content: space-between; gap: 3mm; }
.stars-row { display: flex; gap: 2.5mm; direction: rtl; }
.st { position: relative; display: flex; }
.st .big-star { width: 15mm; height: 15mm; }
.st small { position: absolute; left: 50%; top: 55%; transform: translate(-50%, -50%); font: 800 9pt var(--title); color: #E2A32A; }
.mem-with { flex: none; padding: 3mm 5mm; display: flex; align-items: center; gap: 3mm; }
.mem-with .label { white-space: nowrap; }
.who { flex: 1; display: flex; flex-wrap: wrap; gap: 2mm; justify-content: flex-start; }
.who-chip { display: inline-flex; align-items: center; gap: 1.5mm; height: 9mm; padding-inline: 1.2mm 3mm; border-radius: 4.5mm;
            background: var(--tint); max-width: 34mm; }
.who-chip .check-box { width: 6mm; height: 6mm; border-radius: 1.6mm; }
.who-name { font: 700 10.5pt var(--body); color: var(--deep); white-space: nowrap; overflow: hidden; }
.mem-quote { position: relative; flex: none; padding: 3.5mm 5mm 3mm; display: flex; flex-direction: column; gap: 0.5mm; }
.mem-quote .write-line { height: 9.5mm; }
.date-line { display: flex; align-items: flex-end; gap: 2mm; width: 70mm; }
.date-line small { font: 700 9.5pt var(--body); color: var(--muted); }
.date-line .write-line { flex: 1; height: 8mm; }

/* ---- the 7-day challenge */
.week { flex: 1; display: flex; flex-direction: column; gap: 4mm; }
.board-wrap { position: relative; width: 186mm; height: 118mm; flex: none; margin-top: 1mm; }
.board-wrap > svg { position: absolute; inset: 0; }
.day-flag { position: absolute; transform: translateX(-50%); height: 6.2mm; padding: 0 2.4mm; border-radius: 3.1mm; background: var(--dc);
            color: #FFFFFF; font: 700 8.5pt/6.2mm var(--body); white-space: nowrap; }
.stone-cap { position: absolute; transform: translateX(-50%); width: 40mm; display: flex; flex-direction: column; align-items: center; gap: 0.8mm; }
.stone-cap b { font: 700 10.5pt/1.25 var(--body); color: var(--ink); white-space: nowrap; overflow: hidden; max-width: 40mm; text-align: center; }
.stone-cap .cap-star { width: 8mm; height: 8mm; }
.reward { flex: 1; display: flex; align-items: center; gap: 5mm; padding: 4mm 6mm; background: #FFF8E6; border-color: #F3C75E; }
.reward-ico { width: 24mm; height: 24mm; border-radius: 50%; background: #FFFFFF; color: var(--c); display: flex; align-items: center;
              justify-content: center; flex: none; box-shadow: 0 0 0 0.6mm #F3C75E; }
.reward-ico .ico { width: 15mm; height: 15mm; }
.reward-body { flex: 1; display: flex; flex-direction: column; gap: 1mm; }
.reward-body .label { font-size: 14pt; }
.reward-body small { font: 600 9.5pt var(--body); color: var(--muted); }

/* ---- the family certificate */
.fcert { position: relative; flex: 1; }
.fcert-border, .fcert-confetti { position: absolute; inset: 0; width: 100%; height: 100%; }
.fcert-body { position: absolute; inset: 9mm 12mm 7mm; display: flex; flex-direction: column; align-items: center; }
.fcert-ribbon { position: relative; width: 120mm; height: 21mm; display: flex; align-items: center; justify-content: center; }
.fcert-ribbon svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.fcert-ribbon span { position: relative; font: 800 20pt/1 var(--title); color: #FFFFFF; margin-top: -2.4mm; }
.fcert-line { font: 600 14pt/1.5 var(--body); color: var(--ink-2); margin-top: 4mm; text-align: center; }
.fcert-hero { position: relative; width: 120mm; height: 92mm; margin-top: 2mm; display: flex; justify-content: center; }
.fcert-burst { position: absolute; left: 50%; top: 0; width: 92mm; height: 92mm; transform: translateX(-50%); }
.fcert-child { position: relative; height: 88mm; margin-top: 3mm; }
.fcert-medal { position: absolute; left: 6mm; bottom: 6mm; width: 28mm; height: 36mm; }
.fcert-medal svg { width: 100%; height: 100%; }
.fcert-name { margin-top: -4mm; position: relative; z-index: 2; max-width: 150mm; padding: 1mm 14mm 2mm; border-radius: 9mm;
              background: var(--night); box-shadow: 0 1.2mm 0 #0E1530; display: flex; justify-content: center; }
.fcert-name span { font: 800 32pt/1.25 var(--title); color: #FFFFFF; white-space: nowrap; overflow: hidden; max-width: 122mm; }
.fcert-family { display: flex; align-items: center; justify-content: center; gap: 2.5mm; margin-top: 4mm; max-width: 150mm; }
.fcert-family span { font: 800 20pt/1.3 var(--title); color: #A8304F; white-space: nowrap; overflow: hidden; max-width: 128mm; }
.fcert-family .ico { width: 6mm; height: 6mm; color: #E4769D; flex: none; }
.fcert-members { font: 600 12pt/1.5 var(--body); color: var(--ink-2); max-width: 150mm; white-space: nowrap; overflow: hidden; margin-top: 0.5mm; }
.fcert-badges { display: flex; gap: 2mm; margin-top: 4mm; }
.fcert-badges .cert-seal { width: 14mm; height: 14mm; }
.fcert-sign { display: flex; gap: 12mm; margin-top: 5mm; width: 100%; justify-content: center; }
.fcert-sign > div { display: flex; flex-direction: column; align-items: center; gap: 1mm; min-width: 56mm; }
.fcert-label { font: 600 9.5pt var(--body); color: var(--muted); }
.fcert-value { font: 700 13.5pt var(--body); color: var(--ink); border-bottom: 0.4mm solid var(--line); min-width: 56mm; text-align: center;
               padding-bottom: 1mm; }
.fcert-value.blank { height: 9mm; }
.fcert-say { margin-top: auto; }
.fcert-say .mascot { width: 14mm; height: 14mm; }
.fcert-say .bubble { font-size: 12.5pt; padding: 1.5mm 5mm 2mm; }

/* ---- insert sheets (sticker paper, card stock): their own header and cut lines, no tab or page number */
.sheet { flex: 1; display: flex; flex-direction: column; gap: 4mm; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 4mm; padding-bottom: 2mm;
              border-bottom: 0.5mm dashed var(--line); }
.sheet-title { display: flex; align-items: center; gap: 3mm; min-width: 0; }
.sheet-title .mascot { width: 15mm; height: 15mm; }
.sheet-title h1 { font: 800 24pt/1.1 var(--title); color: var(--night); padding-top: 2.5mm; }  /* room for the tashkeel */
.sheet-title p { font: 600 11.5pt/1.4 var(--body); color: var(--ink-2); }
.sheet-owner { display: flex; flex-direction: column; align-items: center; padding: 1.5mm 5mm; border-radius: 5mm; background: var(--tint);
               max-width: 55mm; }
.sheet-owner small { font: 600 8.5pt var(--body); color: var(--deep); }
.sheet-owner b { font: 800 16pt/1.2 var(--title); color: var(--deep); white-space: nowrap; overflow: hidden; max-width: 45mm; }
.sheet-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 4mm; padding: 2.5mm 1.5mm 2mm;
              border-top: 0.5mm dashed var(--line); font: 600 8.5pt/1.5 var(--body); color: var(--muted); }
.sheet-brand { display: inline-flex; align-items: center; gap: 1.2mm; font: 800 9pt var(--title); }
.sheet-brand .mascot { width: 6mm; height: 6mm; }
.cut-key { display: inline-flex; align-items: center; gap: 1.5mm; }
.cut-key i { width: 8mm; height: 0; border-top: 0.35mm solid #EC008C; }
.st-group { display: flex; flex-direction: column; gap: 2mm; }
.st-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.2mm 0; }
.st-badges .st-badge { width: calc(100% / 6); }
.st-badge { display: flex; flex-direction: column; align-items: center; gap: 0.6mm; min-width: 0; }
.st-seal { position: relative; width: 27mm; height: 27mm; }
.st-seal .seal { position: absolute; inset: 1.5mm; width: 24mm; height: 24mm; }
.st-seal .cut { position: absolute; inset: 0; width: 27mm; height: 27mm; }
.st-badge > span { font: 700 8pt/1.2 var(--body); white-space: nowrap; overflow: hidden; max-width: 30mm; }
.st-rewards { display: flex; justify-content: space-between; }
.st-reward { position: relative; width: 26mm; height: 26mm; display: flex; align-items: center; justify-content: center; }
.st-reward .reward-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.st-reward b { position: relative; font: 800 10.5pt/1 var(--title); color: #FFFFFF; padding-top: 1mm; }
.st-reward.star b { font-size: 8.5pt; margin-top: 1.5mm; }
.st-routine { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0 3.4mm; padding-inline: 1.8mm; }
.st-rt { position: relative; height: 24mm; border-radius: 4.5mm; min-width: 0; background: var(--rc); color: #FFFFFF; display: flex;
         flex-direction: column; align-items: center; justify-content: center; gap: 1.2mm; box-shadow: 0 0 0 0.9mm #FFFFFF; }
.rt-cut { position: absolute; inset: -1.5mm; border-radius: 5.8mm; border: 0.35mm solid #EC008C; }
.rt-ico { width: 11mm; height: 11mm; border-radius: 50%; background: rgba(255,255,255,0.22); display: flex; align-items: center;
          justify-content: center; }
.rt-ico .ico { width: 7.5mm; height: 7.5mm; }
.st-rt b { font: 700 8.5pt/1.2 var(--body); white-space: nowrap; overflow: hidden; max-width: 21mm; }
.st-days { display: flex; justify-content: space-between; padding-inline: 2mm; }
.st-day { position: relative; width: 20mm; height: 20mm; display: flex; align-items: center; justify-content: center; }
.st-day .day-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.st-day b { position: relative; margin-top: 2.4mm; font: 800 12pt/1 var(--title); color: #B27A0C; }

.play-banner { display: inline-flex; align-items: center; gap: 2mm; padding: 2mm 5mm; border-radius: 6mm; background: var(--deep);
               color: #FFFFFF; font: 800 13pt/1.2 var(--title); white-space: nowrap; }
.play-banner .ico { width: 4.5mm; height: 4.5mm; color: #FFE7A3; }
.sheet.money { gap: 3mm; }
.notes { flex: 1.7; display: grid; grid-template-columns: 1fr 1fr; gap: 3mm 6mm; align-content: space-evenly; }
.note-cell { position: relative; padding: 1.5mm; border: 0.35mm dashed #8E93AB; border-radius: 6mm; }
.note { position: relative; width: 84mm; height: 40mm; margin: 0 auto; zoom: 0.93; }
.note .note-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.note-num { position: absolute; left: 7.2mm; top: 11.5mm; width: 18.5mm; text-align: center; font: 800 21pt/1 var(--title);
            color: #FFFFFF; padding-top: 1.5mm; }
.note-moon { position: absolute; left: 30mm; top: 7mm; width: 21mm; height: 21mm; border-radius: 50%; background: #FFFFFF;
             display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 0.7mm var(--nd); }
.note-moon .mascot { width: 16mm; height: 16mm; }
.note-text { position: absolute; right: 5mm; top: 6mm; display: flex; flex-direction: column; align-items: flex-end; }
.note-text b { font: 800 12pt/1.2 var(--title); color: var(--nd); }
.note-text span { font: 700 10pt/1.3 var(--body); color: var(--ink); }
.note-play { position: absolute; right: 5mm; bottom: 5mm; height: 6.4mm; padding: 0 3mm; border-radius: 3.2mm; background: var(--nd);
             color: #FFFFFF; font: 800 9.5pt/6.4mm var(--title); }
.scissors { position: absolute; top: -3.6mm; right: 4mm; width: 6.5mm; height: 6.5mm; background: var(--paper); color: #6F7590; }
.scissors .ico { width: 6.5mm; height: 6.5mm; }
.coins { flex: 1; display: grid; grid-template-columns: repeat(6, 1fr); gap: 3mm 0; justify-items: center;
         align-content: space-evenly; }
.coin-cell { width: 27mm; height: 27mm; border-radius: 50%; border: 0.35mm dashed #8E93AB; display: flex; align-items: center;
             justify-content: center; }
.coin { position: relative; width: 26mm; height: 26mm; zoom: 0.9; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.coin .coin-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.coin b { position: relative; font: 800 17pt/1 var(--title); color: #3D4262; margin-top: 3.2mm; }
.coin small { position: relative; font: 700 6.5pt/1.1 var(--body); color: #3D4262; }
.coin em { position: relative; font: 700 5.5pt/1.1 var(--body); font-style: normal; color: #3D4262; margin-top: 0.2mm; }
.cut-note { display: inline-flex; align-items: center; gap: 1.5mm; }
.price-tags { display: flex; flex-direction: column; gap: 2mm; }
.tags-row { display: flex; justify-content: space-between; }
.ptag-cell { padding: 1.6mm; border: 0.35mm dashed #8E93AB; border-radius: 4.5mm; }
.ptag { position: relative; width: 31mm; height: 17mm; border-radius: 3mm; background: #FFFFFF; border: 0.6mm solid var(--c);
        display: flex; flex-direction: column; justify-content: center; padding-inline: 8mm 2.5mm; gap: 0.6mm; }
.ptag-hole { position: absolute; left: 2.6mm; top: 50%; width: 3.4mm; height: 3.4mm; margin-top: -1.7mm; border-radius: 50%;
             border: 0.5mm solid var(--c); background: var(--tint); }
.ptag small { font: 700 8pt var(--body); color: var(--deep); }
.ptag-line { height: 4mm; border-bottom: 0.45mm dashed #CDBF9F; }
.ptag b { font: 800 8.5pt var(--title); color: var(--deep); align-self: flex-end; }
.cut-note .ico { width: 5mm; height: 5mm; }

/* ---- drawing */
.drawpg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.draw-card { position: relative; flex: 1; min-height: 0; border-style: dashed; border-color: #E6D6B6; }
.draw-circle { position: absolute; left: 50%; top: 50%; width: min(78%, 120mm); aspect-ratio: 1; transform: translate(-50%, -50%);
               border-radius: 50%; border: 0.8mm dashed var(--c); background: var(--tint); opacity: 0.55; }
.crayons { position: absolute; top: 3mm; inset-inline-start: 4mm; display: flex; gap: 0.5mm; }
.crayons i { width: 7mm; height: 7mm; color: var(--cc); }
.crayons .ico { width: 100%; height: 100%; }
.draw-kid { position: absolute; bottom: 2mm; inset-inline-end: 3mm; height: 46mm; }
.draw-caption { flex: none; display: flex; align-items: flex-end; gap: 2mm; }
.draw-caption .label { white-space: nowrap; }
.draw-caption .write-line { flex: 1; }
.tray-card { flex: none; padding: 4mm; display: flex; justify-content: center; }
.tray-art svg { width: 150mm; height: 78mm; }
.missing { display: flex; flex-direction: column; padding: 3.5mm 4.5mm; }
.missing-q { position: absolute; left: 50%; top: 55%; transform: translate(-50%, -50%); font: 800 90pt/1 var(--title);
             color: var(--tint); }

/* ---- counting: a tally chart per color, or two baskets to compare */
.countpg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.tally-card { flex: 1; min-height: 0; display: flex; justify-content: space-evenly; align-items: stretch; padding: 4mm 5mm 3mm; }
.tally-col { display: flex; flex-direction: column; align-items: center; gap: 1.5mm; width: 34mm; }
.tally-col.lvl2 { border: 0.5mm dashed #E8C77F; border-radius: 5mm; background: #FFFCF4; padding-top: 1mm; }
.col-level { height: 5mm; }
.col-level .stars { height: 4.6mm; width: auto; }
.tally-squares { flex: 1; display: flex; flex-direction: column-reverse; justify-content: flex-start; gap: 1.6mm; }
.tally-squares span { width: 18mm; height: 15.6mm; border: 0.6mm solid var(--pc); border-radius: 2.5mm; background: #FFFFFF; }
.paint { width: 16mm; height: 9.6mm; }
.tally-col b { font: 800 13pt/1.1 var(--title); color: var(--ink); }
.how-many { display: flex; align-items: center; gap: 1.2mm; }
.how-many small { font: 700 8.5pt var(--body); color: var(--muted); }
.how-many i, .cmp-count i, .cmp-diff i { width: 10mm; height: 10mm; border: 0.6mm solid var(--c); border-radius: 2.5mm;
          background: #FFFFFF; display: flex; align-items: center; justify-content: center; font: 800 13pt var(--title);
          font-style: normal; color: var(--answer); }
.tally-q { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 3mm 5mm; }
.tally-dots { display: flex; gap: 4mm; }
.tally-dots span { width: 11mm; height: 11mm; border-radius: 50%; background: var(--pc); box-shadow: 0 0 0 0.9mm #FFFFFF, 0 0 0 1.3mm var(--line); }
.cmp-row { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: space-around; padding: 3mm 5mm; }
.cmp-row.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.row-level { position: absolute; top: 2.5mm; inset-inline-start: 4mm; }
.row-level .stars { height: 4.6mm; width: auto; }
.cmp-basket { display: flex; flex-direction: column; align-items: center; gap: 2mm; }
.crate { width: 60mm; height: 34mm; border-radius: 4mm; background: #F7E6C8; border: 0.7mm solid #D9B27C;
         display: flex; align-items: center; justify-content: center; box-shadow: inset 0 -2.2mm 0 #EDD3A6; }
.crate svg { width: 54mm; height: 30mm; }
.cmp-under { display: flex; align-items: center; gap: 4mm; }
.cmp-count, .cmp-diff { display: flex; align-items: center; gap: 1.2mm; }
.cmp-count small, .cmp-diff small { font: 700 9pt var(--body); color: var(--muted); }
.cmp-star .mark-star { width: 10mm; height: 10mm; }
.cmp-star.on path { fill: #F7C84A; }
.cmp-vs { font: 800 16pt var(--title); color: var(--deep); background: var(--tint); border-radius: 50%; width: 13mm; height: 13mm;
          display: flex; align-items: center; justify-content: center; padding-top: 1mm; }
.cmp-mid { display: flex; flex-direction: column; align-items: center; gap: 3mm; }
.cmp-diff { flex-direction: column; gap: 0.6mm; }

/* ---- sorting: things on the right, their groups on the left, joined by the child's lines */
.sortpg { flex: 1; display: flex; gap: 0; min-height: 0; }
.sort-items { width: 62mm; flex: none; display: flex; flex-direction: column; justify-content: space-between; gap: 2.5mm; }
.sort-item { position: relative; flex: 1; max-height: 30mm; min-height: 0; display: flex; align-items: center; gap: 3mm;
             padding: 1.5mm 3mm; }
.sort-pic { height: 100%; max-height: 24mm; aspect-ratio: 1; flex: none; }
.sort-item small { font: 700 11pt var(--naskh); color: var(--ink); }
.sort-dot { position: absolute; top: 50%; width: 5mm; height: 5mm; margin-top: -2.5mm; border-radius: 50%; background: var(--c);
            box-shadow: 0 0 0 1mm #FFFFFF, 0 0 0 1.4mm var(--line); }
.sort-item .sort-dot { inset-inline-end: -2.5mm; }
.sort-group .sort-dot { inset-inline-start: -2.5mm; background: var(--gc); }
.sort-gap { flex: 1; position: relative; }
.sort-pencil { position: absolute; top: 50%; left: 50%; width: 9mm; height: 9mm; transform: translate(-50%, -50%); color: var(--line); }
.sort-groups { width: 64mm; flex: none; display: flex; flex-direction: column; justify-content: space-between; gap: 4mm; }
.sort-group { position: relative; flex: 1; max-height: 58mm; display: flex; flex-direction: column; align-items: center;
              justify-content: center; gap: 1.5mm; border-color: var(--gc); border-width: 0.7mm; }
.sort-mark svg { width: 32mm; height: 32mm; }
.sort-group b { font: 800 15pt/1.2 var(--title); color: var(--ink); }
.sort-basket { position: relative; width: 34mm; height: 34mm; }
.basket-chip { position: absolute; top: 0; inset-inline-end: -1mm; width: 11mm; height: 11mm; border-radius: 50%; background: var(--gc);
               color: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 0.8mm #FFFFFF; }
.basket-chip .group-ico { width: 7mm; height: 7mm; }

/* ---- the observation journal */
.journal { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.jr-top { flex: none; display: flex; align-items: center; gap: 3.5mm; padding: 3mm 5mm; }
.jr-icon { width: 17mm; height: 17mm; border-radius: 50%; background: var(--c); color: #FFFFFF; display: flex; align-items: center;
           justify-content: center; flex: none; box-shadow: 0 0 0 1.2mm var(--tint); }
.jr-icon .ico { width: 11mm; height: 11mm; }
.jr-lead { font: 800 14pt/1.3 var(--title); color: var(--deep); }
.jr-like { margin-inline-start: auto; font: 700 10.5pt var(--body); color: var(--muted); }
.jr-hints { display: flex; gap: 2mm; }
.jr-hint { display: flex; flex-direction: column; align-items: center; }
.jr-hint-pic { width: 14mm; height: 14mm; }
.jr-hint small { font: 600 8pt var(--naskh); color: var(--muted); }
.jr-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 4mm; }
.jr-entry { display: flex; flex-direction: column; gap: 1.5mm; padding: 2.5mm 3mm 3mm; min-height: 0; }
.jr-entry.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.jr-head { display: flex; align-items: center; justify-content: space-between; }
.jr-level .stars { height: 4.6mm; width: auto; }
.jr-draw { position: relative; flex: 1; min-height: 0; border-radius: 4mm; background: #FFFFFF; border: 0.4mm dashed #EADFC8; }
.jr-hint-ico { position: absolute; bottom: 1.5mm; inset-inline-end: 1.5mm; width: 5mm; height: 5mm; color: #D8CBB0; }
.jr-name { display: flex; align-items: flex-end; gap: 1.5mm; }
.jr-name small { font: 700 9pt var(--body); color: var(--muted); white-space: nowrap; padding-bottom: 1mm; }
.jr-name .write-line { flex: 1; height: 7mm; }
.jr-chips { display: flex; gap: 2mm; justify-content: center; }
.jr-chips span { padding: 0.8mm 3.5mm; border-radius: 3mm; border: 0.5mm solid var(--c); font: 700 9pt var(--body); color: var(--deep);
                 background: #FFFFFF; }
.jr-filler { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; min-height: 0; }
.jr-filler img { height: 78%; min-height: 0; }
.jr-say { position: relative; margin-bottom: 2mm; padding: 1.6mm 4mm; border-radius: 4mm; background: #FFFFFF; border: 0.5mm solid var(--c);
          font: 700 10.5pt var(--body); color: var(--deep); }

/* ---- conversation and role cards */
.talkpg { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }
.roles { flex: 1; display: flex; gap: 5mm; min-height: 0; }
.role { flex: 1; display: flex; flex-direction: column; gap: 3mm; padding: 4mm; min-height: 0; }
.role-head { display: flex; align-items: center; gap: 3mm; padding-bottom: 3mm; border-bottom: 0.5mm dashed var(--line); }
.role-pic { width: 22mm; height: 22mm; flex: none; }
.role-head b { font: 800 19pt/1.2 var(--title); color: var(--deep); }
.role-ico { margin-inline-start: auto; width: 10mm; height: 10mm; border-radius: 50%; background: var(--c); color: #FFFFFF;
            display: flex; align-items: center; justify-content: center; }
.role-ico .ico { width: 6mm; height: 6mm; }
.role-lines { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 3mm; }
.say-line { position: relative; padding: 3mm 4.5mm; border-radius: 5mm; background: var(--tint); font: 700 13pt/1.45 var(--body);
            color: var(--ink); }
.say-line::after { content: ""; position: absolute; bottom: -1.6mm; inset-inline-start: 6mm; width: 4mm; height: 4mm; background: var(--tint);
                   transform: rotate(45deg); }
.say-line.lvl2 { background: #FFFCF4; border: 0.5mm dashed #E8C77F; display: flex; align-items: center; gap: 2mm; }
.say-line.lvl2::after { display: none; }
.say-line .stars { height: 4.2mm; width: auto; flex: none; }
.swap { flex: none; align-self: center; display: inline-flex; align-items: center; gap: 2.5mm; padding: 2.5mm 7mm; border-radius: 7mm;
        background: var(--c); color: #FFFFFF; font: 800 14pt var(--title); box-shadow: 0 1mm 0 var(--deep); }
.swap .ico { width: 6mm; height: 6mm; }
.talk-cards { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
.talk-card { display: flex; flex-direction: column; gap: 2mm; padding: 5mm; }
.talk-card p { font: 700 14pt/1.5 var(--body); color: var(--ink); }

/* ---- price tags: color the Qamra money that makes each price */
.pricepg { flex: 1; display: flex; flex-direction: column; gap: 3.5mm; min-height: 0; }
.price-row { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; gap: 3mm; padding: 3mm 5mm 3mm 4mm; }
.price-row.lvl2 { border-style: dashed; border-color: #E8C77F; background: #FFFCF4; }
.price-items { display: flex; align-items: center; gap: 2mm; flex: none; }
.price-item { display: flex; flex-direction: column; align-items: center; gap: 1mm; }
.price-pic { width: 22mm; height: 22mm; }
.tag-price { position: relative; display: inline-flex; align-items: center; gap: 1.2mm; padding: 0.8mm 3mm 0.8mm 2.2mm;
             border-radius: 2mm; background: #FFF4D6; border: 0.5mm solid #E2A32A; font: 800 11pt var(--title); color: #8A5A08;
             white-space: nowrap; }
.tag-price i { width: 2.4mm; height: 2.4mm; border-radius: 50%; border: 0.45mm solid #E2A32A; background: #FFFFFF; }
.price-plus { font: 800 18pt var(--title); color: var(--deep); }
.price-arrow { width: 8mm; height: 8mm; color: var(--line); flex: none; }
.price-arrow .ico { width: 100%; height: 100%; }
.purse { flex: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.5mm 2mm; }
.piece.coin { width: 15mm; height: 15mm; }
.piece.note { width: 22mm; height: 11mm; }
.piece-num { font: 800 15px var(--title); }
.price-total { display: flex; flex-direction: column; align-items: center; gap: 0.5mm; }
.price-total i { width: 12mm; height: 12mm; border: 0.6mm solid #E2A32A; border-radius: 3mm; background: #FFFFFF; }
.price-total small { font: 700 8.5pt var(--body); color: #8A5A08; }

/* ---- the color hunt */
.swatch { display: inline-flex; align-items: center; gap: 1.2mm; font: 700 11pt var(--body); color: var(--ink); }
.swatch i { width: 7mm; height: 7mm; border-radius: 50%; background: var(--pc); }
.swatch.lvl2 { opacity: 0.8; }
.hunt-basket { width: 30mm; flex: none; }
.color-cols { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3.5mm; }
.color-col { display: flex; flex-direction: column; gap: 2.5mm; padding: 2.5mm; border-top: 3mm solid var(--pc); min-height: 0; }
.color-col.lvl2 { border-style: dashed; border-top-style: solid; border-color: #E8C77F; border-top-color: var(--pc); background: #FFFCF4; }
.color-head { display: flex; align-items: center; gap: 1.5mm; }
.color-head .blob { width: 6mm; height: 6mm; border-radius: 50%; background: var(--pc); }
.color-head b { font: 800 13pt/1.1 var(--title); color: var(--ink); }
.color-hint { width: 9mm; height: 9mm; margin-inline-start: auto; }
.color-head .find-level { margin-inline-start: 0; }
.color-box { position: relative; flex: 1; min-height: 0; border-radius: 4mm; border: 0.5mm dashed var(--pc); background: #FFFFFF; }
.color-box .check-box { position: absolute; top: 2mm; inset-inline-start: 2mm; width: 5.5mm; height: 5.5mm; border-color: var(--pc); }

/* a safety reminder for an outdoor activity (A7 §9) */
.safe-note { flex: none; display: flex; align-items: center; gap: 2mm; padding: 2mm 3.5mm; border-radius: 4mm; background: #FFF3EF;
             border: 0.5mm solid #F5B7AC; color: #7A2A20; }
.safe-note .ico { width: 6mm; height: 6mm; color: #E4675A; flex: none; }
.safe-note span { font: 700 9.5pt/1.4 var(--body); max-height: 9.5mm; overflow: hidden; }
.tray-card { position: relative; }
.tray-legend { position: absolute; top: 3mm; inset-inline-start: 4mm; display: flex; flex-direction: column; gap: 1mm; }
.tray-legend span { display: inline-flex; align-items: center; gap: 1.2mm; font: 800 11pt var(--title); color: #8A5A08; }
.tray-legend .stars { height: 4.4mm; width: auto; }
