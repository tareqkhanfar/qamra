/* ==== «قلبي يعرف الله» (Addendum 10): the Islamic education series. Loaded after the base CSS for product `islamic`;
   every rule is scoped to `.isl`, so nothing leaks into the other products. Vowelised text is Noto Naskh Arabic (it has
   every harakat mark and U+FDFA); verses are Amiri Quran (SIL OFL). ==== */
@font-face { font-family: "Amiri Quran"; src: url("{{ fonts }}/AmiriQuran-Regular.ttf") format("truetype"); }

.isl { --green: #1F5A46; --green-soft: #E3F0E8; --gold: #C9962B; --gold-soft: #FBF0D5; --cream: #FFF9EC; --shell: #FFFBF3;
       --kitab: "Noto Naskh Arabic", "IBM Plex Sans Arabic", serif; --ui: "IBM Plex Sans Arabic", "Noto Naskh Arabic", sans-serif;
       position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; font-family: var(--kitab); color: var(--ink); }
.page:has(.isl) { --shell: #FFFBF3; background: #FFFBF3; }
/* no lone word on a paragraph's last line («اللهُ.» after «إِنْ شَاءَ», a ﷺ under its name); a verse keeps the
   line breaks it was checked with */
.isl { text-wrap-style: pretty; }
.isl .sacred.quran .sacred-text { text-wrap-style: auto; }

/* the unit's ribbon at the top edge, the thumb tab on the outer edge */
.isl-ribbon { position: absolute; top: calc(-1 * var(--inset)); left: calc(-1 * var(--inset)); width: {{ g.page_w }}mm; height: calc(12mm + var(--bleed)); z-index: 0; }
.isl-ribbon svg { width: 100%; height: 100%; }
.isl-tabhost { position: absolute; top: calc(-1 * var(--inset)); left: calc(-1 * var(--inset)); width: {{ g.page_w }}mm; height: calc({{ g.page_h }}mm - var(--inset)); pointer-events: none; z-index: 3; }
.isl-tabhost .tab .ico { color: var(--c); }

/* header: the unit chip, the title, the instruction */
.isl-head { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 1.2mm; padding-top: 4mm; }
.isl-chip { align-self: flex-start; display: inline-flex; align-items: center; gap: 1.6mm; height: 8mm; padding: 0 3.4mm 0 1.4mm; border-radius: 4mm;
            background: #FFFFFF; box-shadow: 0 0 0 0.4mm var(--tint), 0 0.7mm 0 var(--tint); font: 700 10.5pt/1 var(--kitab); color: var(--deep); }
.isl-chip i { width: 5.6mm; height: 5.6mm; border-radius: 50%; background: var(--c); display: flex; align-items: center; justify-content: center; color: var(--on); }
.isl-chip i .ico { width: 3.6mm; height: 3.6mm; }
.isl-chip span { padding-top: 0.6mm; }
.isl-title { font: 700 27pt/1.75 var(--kitab); color: var(--deep); text-align: center; max-width: 178mm; white-space: nowrap; }
.isl-say { display: inline-flex; align-items: center; gap: 2.2mm; padding: 1.2mm 5mm 1.6mm 3mm; border-radius: 6mm; background: #FFFFFF;
           box-shadow: 0 0 0 0.45mm var(--c), 0 0.9mm 0 var(--tint); font: 700 15.5pt/1.7 var(--kitab); color: var(--ink); }
.isl-say i { width: 7mm; height: 7mm; border-radius: 50%; background: var(--c); color: var(--on); display: flex; align-items: center; justify-content: center; flex: none; }
.isl-say i .ico { width: 4.4mm; height: 4.4mm; }
.isl-body { position: relative; z-index: 1; flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 3.4mm; padding-top: 3mm; }

/* footer: the unit, the page number in a rosette, the imprint */
.isl-foot { position: relative; z-index: 1; flex: none; height: 11mm; margin-top: 1mm; display: flex; align-items: center; padding-inline: 1mm; }
.isl-foot-unit { font: 600 8.5pt var(--ui); color: var(--deep); }
.isl-folio { position: absolute; left: 50%; transform: translateX(-50%); min-width: 10mm; height: 10mm; padding: 0 2mm; border-radius: 5mm; background: var(--c); color: var(--on);
             display: flex; align-items: center; justify-content: center; font: 800 13pt/1 var(--title); box-shadow: 0 0 0 0.9mm #FFFFFF, 0 0 0 1.3mm var(--tint); }
.isl-folio span { padding-top: 1mm; }
.isl-end { margin-inline-start: auto; display: flex; align-items: center; gap: 3mm; }
.isl-brand { font: 800 9pt var(--title); color: var(--muted); letter-spacing: 0; }
.isl-legend { font: 500 6.5pt var(--ui); color: #B8741A; white-space: nowrap; }
.isl-legend b { display: inline-block; width: 1.8mm; height: 1.8mm; border-radius: 50%; background: #E8A317; margin-inline: 1mm; vertical-align: 0.1mm; }

/* shared pieces */
.card { background: #FFFFFF; border: 0.5mm solid var(--line); border-radius: 5mm; box-shadow: 0 0.9mm 0 var(--line-soft); }
.ai { position: relative; }
.isl[data-preview] .ai::after { content: ""; position: absolute; top: 1.2mm; inset-inline-start: -2.6mm; width: 1.7mm; height: 1.7mm; border-radius: 50%; background: #E8A317; }
.label { font: 700 11pt/1.3 var(--ui); color: var(--deep); display: inline-flex; align-items: center; gap: 1.6mm; }
.label .ico { width: 5mm; height: 5mm; color: var(--c); }
.tick { width: 8mm; height: 8mm; border: 0.7mm solid var(--c); border-radius: 50%; background: #FFFFFF; flex: none; }
.star-outline { width: 11mm; height: 11mm; }
.stars-row { display: flex; gap: 2mm; align-items: center; }
/* a line to write on: dark enough to print and to see (it was a pale beige dash that read as a footer rule),
   with room above the footer */
.write-line { flex: none; border-bottom: 0.5mm solid #9C8A66; height: 11mm; margin-inline: 4mm; }
.write-line:last-child { margin-bottom: 4mm; }
.pill { display: inline-flex; align-items: center; gap: 1.6mm; height: 7.4mm; padding: 0 3mm; border-radius: 3.7mm; background: var(--tint); color: var(--deep); font: 700 10pt/1 var(--ui); }
.pill .ico { width: 4.4mm; height: 4.4mm; color: var(--c); }

/* a block that prints a source's wording: a dignified frame for verses, a quiet one for hadith and dhikr, and a
   marked placeholder while there is no verified text */
.sacred { position: relative; margin: 0; text-align: center; }
.sacred-label { font: 700 11pt/1.5 var(--kitab); color: var(--green); margin-bottom: 1.4mm; }
.sacred-text { font: 400 20pt/2.05 var(--kitab); color: #14181F; }
.sacred-ref { margin-top: 1mm; font: 600 8.5pt var(--ui); color: var(--muted); direction: rtl; }
.sacred-credit { margin-top: .6mm; font: 500 7pt var(--ui); color: var(--muted); direction: rtl; opacity: .85; }
.sacred-tag { position: absolute; top: -2.6mm; inset-inline-end: 6mm; padding: 0.4mm 2.4mm; border-radius: 2mm; background: #FCEFD2; color: #9A620A; font: 700 7pt/1.4 var(--ui); }
.sacred.quran { background: #FFFBEE; border: 0.9mm solid var(--green); border-radius: 3.4mm; padding: 5.4mm 10mm 4.6mm;
                box-shadow: inset 0 0 0 1.5mm #FFFBEE, inset 0 0 0 2.1mm var(--gold); }
.sacred.quran .sacred-text { font: 400 25pt/2.3 "Amiri Quran", var(--kitab); }
.sacred.quran .corner { position: absolute; width: 7.4mm; height: 7.4mm; }
.sacred.quran .corner svg { width: 100%; height: 100%; }
.corner.tl { top: -3.5mm; left: -3.5mm; } .corner.tr { top: -3.5mm; right: -3.5mm; }
.corner.bl { bottom: -3.5mm; left: -3.5mm; } .corner.br { bottom: -3.5mm; right: -3.5mm; }
.ay-no { display: inline-flex; align-items: center; justify-content: center; min-width: 8mm; height: 8mm; margin-inline: 1.6mm; vertical-align: middle;
         border-radius: 50%; border: 0.5mm solid var(--gold); color: var(--green); background: #FFFFFF; font: 700 11pt/1 var(--kitab); padding-top: 0.8mm; }
.sacred.quote { background: var(--green-soft); border-radius: 4mm; padding: 4mm 7mm 3.4mm; border-inline-start: 1.8mm solid var(--green); }
.sacred.quote .sacred-text { font-size: 19pt; font-weight: 700; }
.sacred.is-placeholder { background: #FFF6E3; border: 0.7mm dashed #B8741A; border-radius: 3.4mm; padding: 4.4mm 7mm 4mm; box-shadow: none; }
/* a verse's placeholder keeps the dignified frame (so the page shows its design) and holds a dashed, marked panel */
.sacred.quran.is-placeholder { background: #FFFBEE; border: 0.9mm solid var(--green); border-radius: 3.4mm; padding: 5.4mm 8mm 5mm; box-shadow: inset 0 0 0 1.5mm #FFFBEE, inset 0 0 0 2.1mm var(--gold); }
.sacred.quran.is-placeholder .sacred-hole { border: 0.6mm dashed #B8741A; border-radius: 2.4mm; background: #FFF6E3; padding: 5mm 6mm; }
.sacred-hole { display: flex; flex-direction: column; align-items: center; gap: 1.2mm; }
.sacred-hole i { width: 8mm; height: 8mm; color: #B8741A; }
.sacred-hole i .ico { width: 100%; height: 100%; }
.sacred-hole p { font: 700 12.5pt/1.6 var(--kitab); color: #7A4A06; }
.sacred-hole small { font: 500 8.5pt/1.4 var(--ui); color: var(--muted); }

/* ---- the parent page */
.pg { gap: 4.6mm; padding-top: 6mm; }
/* the parent page: five cards, the care note and the references must clear the footer (they printed over the
   unit's name and under the folio on the longer pages); the cards share the room and their text fits */
.pg.pg-parent { gap: 3mm; padding-top: 3mm; }
.pg-parent .pg-card { padding-block: 2.4mm; }
.pg-parent .pg-text p { font-size: 12pt; line-height: 1.85; }
.pg-parent .isl-refs { margin-bottom: 1mm; }
.pg-card { display: flex; gap: 4mm; align-items: flex-start; background: #FFFFFF; border: 0.5mm solid var(--line); border-inline-start: 2.2mm solid var(--c);
           border-radius: 4mm; padding: 5mm 6mm 4.6mm 5mm; box-shadow: 0 0.8mm 0 var(--line-soft); }
.pg-ico { flex: none; width: 11mm; height: 11mm; border-radius: 50%; background: var(--c); color: var(--on); display: flex; align-items: center; justify-content: center; }
.pg-ico .ico { width: 6.4mm; height: 6.4mm; }
.pg-text h2 { font: 700 12.5pt/1.4 var(--kitab); color: var(--deep); margin-bottom: 0.6mm; }
.pg-text p { font: 500 13pt/2.05 var(--ui); color: var(--ink); }
.pg-care { margin-top: auto; display: flex; gap: 3.4mm; align-items: center; padding: 3mm 5mm; border: 0.5mm dashed #CDBF9F; border-radius: 4mm; background: var(--gold-soft); }
.pg-care-ico { flex: none; width: 8mm; height: 8mm; color: var(--deep); }
.pg-care-ico .ico { width: 100%; height: 100%; }
.pg-care p { font: 500 10.5pt/1.75 var(--ui); color: var(--ink-2); }
.isl-refs { flex: none; display: flex; flex-wrap: wrap; gap: 0 2.6mm; padding-inline: 1.2mm; font: 500 7.4pt/1.6 var(--ui); color: var(--muted); }
.isl-refs span { font-weight: 700; }

/* ---- the review page «ماذا أتذكّر؟» */
.ur-sub { position: relative; z-index: 1; text-align: center; font: 700 14pt/1.6 var(--kitab); color: var(--ink-2); margin-top: -0.5mm; }
.ur { gap: 4.4mm; padding-top: 2mm; }
.ur-block { display: flex; flex-direction: column; gap: 2.6mm; }
.ur-label { font: 700 13pt/1.3 var(--kitab); color: var(--deep); display: flex; align-items: center; gap: 2mm; }
.ur-label .ico { width: 6mm; height: 6mm; color: var(--c); }
.tf-row { display: flex; align-items: center; gap: 4mm; padding: 3.2mm 4.6mm; }
.tf-n { flex: none; width: 9mm; height: 9mm; border-radius: 50%; background: var(--tint); color: var(--deep); font: 800 13pt/1 var(--title); display: flex; align-items: center; justify-content: center; padding-top: 1mm; }
.tf-text { flex: 1; font: 700 16.5pt/1.75 var(--kitab); color: var(--ink); }
.tf-btns { flex: none; display: flex; gap: 2.4mm; }
.tf-btn { display: inline-flex; align-items: center; justify-content: center; gap: 1.2mm; width: 22mm; height: 12mm; border-radius: 6mm; background: #FFFFFF; border: 0.7mm solid var(--line);
          font: 700 12pt/1 var(--kitab); padding-top: 0.8mm; }
.tf-btn .ico { width: 5.4mm; height: 5.4mm; margin-top: -0.8mm; }
.tf-btn.yes { border-color: #2FA36B; color: #17643F; } .tf-btn.yes .ico { color: #2FA36B; }
.tf-btn.no { border-color: #E27D63; color: #962C22; } .tf-btn.no .ico { color: #E27D63; }
.ur-choose { padding: 3mm 5mm 3.4mm; display: flex; flex-direction: column; gap: 2.4mm; }
.ur-q { font: 700 17pt/1.7 var(--kitab); color: var(--ink); }
.ur-choices { display: flex; flex-direction: column; gap: 2.2mm; }
.ur-choice { display: flex; align-items: center; gap: 3.4mm; font: 700 17pt/1.6 var(--kitab); padding: 1mm 3.4mm; border-radius: 4mm; background: var(--cream); }
.ur-stars { display: flex; align-items: center; justify-content: space-between; padding: 4.4mm 7mm; }
.ur-stars p { font: 700 16pt/1.6 var(--kitab); color: var(--ink); }
.star-outline.big { width: 15mm; height: 15mm; color: #E2A32A; }

/* the compact header: the chip beside the title, for the dense pages */
.isl-head.compact { padding-top: 1.5mm; min-height: 15mm; justify-content: center; }
.isl-head.compact .isl-chip { position: absolute; top: 3mm; inset-inline-start: 0; }
.isl-head.compact .isl-title { font-size: 23pt; line-height: 1.7; padding-inline: 34mm; max-width: none; }

/* ---- a prophet's story */
.st { gap: 2.6mm; padding-top: 1.5mm; --vh: 46mm; --th: 30mm; }
.st-narr { display: flex; align-items: center; gap: 3mm; height: 27mm; padding: 1mm 5mm; border-radius: 5mm; background: var(--tint); flex: none; }
.st-cast { flex: none; width: 56mm; height: 26mm; }
.st-bubble { position: relative; flex: 1; background: #FFFFFF; border-radius: 4.5mm; padding: 2mm 5mm 2.2mm; box-shadow: 0 0.8mm 0 rgba(28,33,64,0.1); }
.st-bubble::after { content: ""; position: absolute; top: 50%; inset-inline-start: -1.8mm; width: 3.6mm; height: 3.6mm; background: #FFFFFF; transform: translateY(-50%) rotate(45deg); }
.st-bubble p { font: 700 12pt/1.9 var(--kitab); color: var(--ink); }
.st-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; flex: none; }
.st-cell { position: relative; height: 44mm; display: flex; flex-direction: column; border-radius: 4mm; overflow: hidden; box-shadow: 0 0 0 0.5mm var(--c), 0 0.9mm 0 var(--tint); margin: 0; background: #FFFFFF; }
.st-img { position: relative; flex: 1; min-height: 0; }
.st-img svg.st-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.st-n { position: absolute; z-index: 2; top: 1.6mm; inset-inline-start: 1.6mm; width: 7mm; height: 7mm; border-radius: 50%; background: var(--c); color: var(--on); font: 800 11pt/1 var(--title);
        display: flex; align-items: center; justify-content: center; padding-top: 0.9mm; box-shadow: 0 0 0 0.7mm #FFFFFF; }
.st-cap { flex: none; background: #FFFFFF; padding: 0.4mm 3.4mm 0.8mm; font: 700 11.5pt/1.75 var(--kitab); color: var(--ink); height: 13.4mm; display: flex; align-items: center; border-top: 0.4mm solid var(--tint); }
.st-lesson { flex: none; display: flex; align-items: center; gap: 3.4mm; padding: 1.4mm 5mm; background: var(--gold-soft); border-color: #F0D58A; }
.st-lesson i { flex: none; width: 9mm; height: 9mm; border-radius: 50%; background: #FFFFFF; color: #B8741A; display: flex; align-items: center; justify-content: center; }
.st-lesson i .ico { width: 5.6mm; height: 5.6mm; }
.st-lesson b { font: 700 10pt/1.2 var(--ui); color: #9A620A; }
.st-lesson p { font: 700 13.5pt/1.85 var(--kitab); color: var(--ink); }
.st-q { flex: none; padding: 1.6mm 5mm 2.2mm; display: flex; flex-direction: column; gap: 1mm; }
.st-qt { display: flex; align-items: center; gap: 2.4mm; font: 700 15pt/1.7 var(--kitab); color: var(--ink); }
.st-qt i { width: 7mm; height: 7mm; border-radius: 50%; background: var(--c); color: var(--on); display: flex; align-items: center; justify-content: center; flex: none; }
.st-qt i .ico { width: 4.4mm; height: 4.4mm; }
.st-choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.6mm; }
.st-choice { display: flex; align-items: center; gap: 2.2mm; background: var(--cream); border-radius: 3.4mm; padding: 1.4mm 2.6mm; font: 700 12pt/1.6 var(--kitab); min-height: 12mm; }
.st-choice .tick { width: 6.4mm; height: 6.4mm; }

/* ---- the dhikr page */
.dk { gap: 3mm; padding-top: 2mm; }
.dk-when { flex: none; display: flex; align-items: center; justify-content: center; gap: 4mm; }
.dk-when-l { display: inline-flex; align-items: center; gap: 1.6mm; height: 9mm; padding: 0 4mm; border-radius: 4.5mm; background: var(--c); color: var(--on); font: 800 12pt/1 var(--kitab); padding-top: 0.8mm; }
.dk-when-l .ico { width: 5.2mm; height: 5.2mm; margin-top: -0.8mm; }
.dk-when-t { font: 700 20pt/1.7 var(--kitab); color: var(--deep); }
.dk-scene { flex: 1 0 80mm; position: relative; min-height: 80mm; max-height: 104mm; margin: 0; border-radius: 5mm; overflow: hidden; box-shadow: 0 0 0 0.5mm var(--c), 0 0.9mm 0 var(--tint); }
.dk-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.dk-say { flex: none; position: relative; padding-top: 3.6mm; }
.dk-say-l { position: absolute; z-index: 2; top: 0; inset-inline-start: 6mm; height: 8mm; padding: 0 5mm; border-radius: 4mm; background: var(--green); color: #FFFFFF; font: 800 12pt/1 var(--kitab); display: flex; align-items: center; padding-top: 0.8mm; }
.dk-say .sacred.quote { padding-top: 6mm; }
.dk-say .sacred-text { font-size: 32pt; line-height: 1.95; font-weight: 700; }
.dk-two { flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; }
.dk-card { padding: 2.6mm 4.6mm 3mm; }
.dk-card h2 { display: flex; align-items: center; gap: 1.8mm; font: 700 11.5pt/1.4 var(--kitab); color: var(--deep); }
.dk-card h2 .ico { width: 5mm; height: 5mm; color: var(--c); }
.dk-card p { font: 700 13pt/1.9 var(--kitab); color: var(--ink); }
.dk-home { flex: none; display: grid; grid-template-columns: 44mm 1fr; gap: 3mm; }
.dk-home.no-qr { grid-template-columns: 1fr; }
.dk-qr { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.4mm; padding: 2.4mm; }
.dk-qr-code { width: 25mm; height: 25mm; }
.dk-qr-code svg { width: 100%; height: 100%; }
.dk-qr span { display: inline-flex; align-items: center; gap: 1.2mm; font: 700 10.5pt/1.3 var(--kitab); color: var(--deep); }
.dk-qr span .ico { width: 5mm; height: 5mm; color: var(--c); }
.dk-week { padding: 2.4mm 4.6mm 2.6mm; display: flex; flex-direction: column; gap: 0.8mm; }
.dk-week h2 { display: flex; align-items: center; gap: 1.8mm; font: 700 11.5pt/1.4 var(--kitab); color: var(--deep); }
.dk-week h2 .ico { width: 5mm; height: 5mm; color: var(--c); }
.dk-week p { font: 700 12pt/1.8 var(--kitab); }
.dk-days { display: flex; gap: 1.6mm; margin-top: 0.6mm; }
.dk-days span { position: relative; width: 11mm; height: 11mm; }
.dk-days .star-outline { width: 11mm; height: 11mm; color: #E2A32A; }
.dk-days i { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 800 8pt/1 var(--title); color: #B8741A; font-style: normal; padding-top: 1.4mm; }

/* ---- «ماذا كنت ستفعل؟» */
.wy { gap: 3mm; padding-top: 2mm; }
.wy-scenario { flex: none; position: relative; background: #FFFFFF; border: 0.6mm solid var(--c); border-radius: 6mm; padding: 2.6mm 7mm 3mm; box-shadow: 0 0.9mm 0 var(--tint); text-align: center; }
.wy-scenario p { font: 700 17pt/1.85 var(--kitab); color: var(--ink); }
.wy-scene { flex: 1 0 78mm; position: relative; min-height: 78mm; max-height: 104mm; margin: 0; border-radius: 5mm; overflow: hidden; box-shadow: 0 0 0 0.5mm var(--c), 0 0.9mm 0 var(--tint); }
.wy-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.wy-choices { flex: none; display: flex; flex-direction: column; gap: 2.2mm; }
.wy-choice { display: flex; align-items: center; gap: 4mm; padding: 1.8mm 5mm 2mm; }
.wy-t { font: 700 16pt/1.7 var(--kitab); color: var(--ink); }
.wy-f { display: flex; align-items: center; gap: 1.6mm; font: 500 10.5pt/1.5 var(--kitab); color: var(--muted); }
.wy-f .ico { width: 4.4mm; height: 4.4mm; color: var(--c); flex: none; }
.wy-role { flex: none; display: flex; align-items: center; gap: 3mm; }
.wy-role p { font: 700 13.5pt/1.7 var(--kitab); color: var(--ink); }

/* ---- «ماذا أفعل لو…؟» */
.wd { gap: 4.4mm; padding-top: 3mm; }
.wd-intro { flex: none; text-align: center; font: 700 14.5pt/1.8 var(--kitab); color: var(--ink-2); padding-inline: 8mm; }
.wd-grid { flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; align-items: stretch; }
.wd-step { position: relative; display: grid; grid-template-columns: 30mm 1fr; align-items: center; gap: 2mm 3mm; padding: 4mm 4mm 4mm 4mm; }
.wd-n { position: absolute; top: -2.6mm; inset-inline-start: 4mm; width: 8mm; height: 8mm; border-radius: 50%; background: var(--c); color: var(--on); font: 800 12pt/1 var(--title);
        display: flex; align-items: center; justify-content: center; padding-top: 1mm; box-shadow: 0 0 0 0.8mm #FFFFFF; }
.wd-pic-box { width: 30mm; height: 30mm; }
.wd-pic-box .wd-pic { width: 100%; height: 100%; }
.wd-t { font: 700 15.5pt/1.85 var(--kitab); color: var(--ink); }
.wd-dua { grid-column: 1 / -1; }
.wd-step:not(:has(.wd-pic-box)) { grid-template-columns: 1fr; }
.wd-dua .sacred { margin: 0; }
.wd-dua .sacred.is-placeholder { padding: 2mm 3mm 1.8mm; }
.wd-dua .sacred-hole { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 1mm 2mm; }
.wd-dua .sacred-hole i { width: 5mm; height: 5mm; }
.wd-dua .sacred-hole p { font-size: 10.5pt; line-height: 1.5; }
.wd-dua .sacred-hole small { width: 100%; text-align: center; font-size: 7.5pt; }
.wd-dua .sacred.quote .sacred-text { font-size: 17pt; line-height: 1.8; }
.wd-mean { flex: none; display: flex; align-items: center; gap: 3.4mm; padding: 2.4mm 5mm; background: var(--gold-soft); border-color: #F0D58A; }
.wd-mean i { flex: none; width: 9mm; height: 9mm; border-radius: 50%; background: #FFFFFF; color: #B8741A; display: flex; align-items: center; justify-content: center; }
.wd-mean i .ico { width: 5.6mm; height: 5.6mm; }
.wd-mean p { font: 700 15pt/1.9 var(--kitab); }
.wd-track { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 2.4mm 5mm; }
.wd-track p { font: 700 14.5pt/1.7 var(--kitab); color: var(--ink); max-width: 66mm; }

/* ---- the instruction pill under a compact header */
.isl-head.compact .isl-say { margin-top: 0.4mm; }

/* ---- the wudu cards */
.wu { gap: 3.4mm; padding-top: 3mm; }
.wu-grid { flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 6mm 3.6mm; padding-top: 3mm; }
.wu-card { position: relative; display: flex; align-items: center; gap: 3mm; height: 40mm; padding: 2.4mm 4mm 2.4mm 4mm; }
.wu-slot { position: absolute; top: -3.4mm; inset-inline-start: 3.6mm; width: 10mm; height: 10mm; border-radius: 50%; border: 0.8mm dashed var(--c); background: #FFFFFF; }
.wu-art { flex: none; width: 27mm; height: 27mm; }
.wu-art svg { width: 100%; height: 100%; }
.wu-t { flex: 1; font: 700 15pt/1.75 var(--kitab); color: var(--ink); }
/* a card without a picture: the text takes the whole card (it was squeezed into half, breaking a dhikr) */
.wu-card:not(:has(.wu-art)) { justify-content: center; text-align: center; padding-inline: 6mm; }
.wu-times { position: absolute; bottom: 2mm; inset-inline-end: 3mm; min-width: 11mm; height: 6.4mm; padding: 0 2mm; border-radius: 3.2mm; background: var(--tint); color: var(--deep);
            font: 800 10pt/6.4mm var(--title); text-align: center; }
.wu-card.flag { box-shadow: 0 0 0 0.7mm #E8A317, 0 0.9mm 0 var(--line-soft); }
.wu-parent { flex: none; display: flex; align-items: center; gap: 3mm; padding: 2.4mm 5mm; border: 0.5mm dashed #CDBF9F; border-radius: 4mm; background: var(--gold-soft); }
.wu-parent b { flex: none; display: inline-flex; align-items: center; gap: 1.4mm; font: 800 11pt/1 var(--kitab); color: #9A620A; }
.wu-parent b .ico { width: 5mm; height: 5mm; }
.wu-parent p { font: 600 12pt/1.8 var(--kitab); color: var(--ink-2); }

/* ---- the blessings hunt */
.hn { gap: 3mm; padding-top: 2mm; }
.hn-scene { flex: none; position: relative; height: 112mm; margin: 0; border-radius: 5mm; overflow: hidden; box-shadow: 0 0 0 0.5mm var(--c), 0 0.9mm 0 var(--tint); }
.hn-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.hn-scene svg.hunt-rings { z-index: 2; }
.hn-list { flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.4mm; }
.hn-item { display: flex; align-items: center; gap: 1.6mm; height: 15mm; padding: 0 2.4mm; border-radius: 3.4mm; }
.hn-item svg.hunt-pic { flex: none; width: 9.5mm; height: 9.5mm; }
.hn-item span { flex: 1; font: 700 12.5pt/1.3 var(--kitab); color: var(--ink); white-space: nowrap; }
.hn-item .tick { width: 5.2mm; height: 5.2mm; border-width: 0.6mm; }
.hn-close { flex: none; padding: 1.6mm 5mm; background: var(--green-soft); border-color: #BFDCCB; text-align: center; }
.hn-close p { font: 700 13pt/1.8 var(--kitab); color: #1B4A39; }
.hn-draw { flex: none; display: flex; align-items: center; gap: 3mm; }
.hn-box { flex: 1; height: 24mm; border: 0.7mm dashed var(--c); border-radius: 4mm; background: #FFFFFF; }

/* ---- the colouring page */
.col { padding-top: 2mm; }
.col-frame { position: relative; flex: 1; min-height: 0; margin: 0; background: #FFFFFF; border: 0.6mm solid var(--line); border-radius: 5mm; }
.col-frame svg { position: absolute; inset: 3mm; width: calc(100% - 6mm); height: calc(100% - 6mm); }
/* a text that pulls a source's wording in: underlined while it is a candidate, a marked hole while it is missing */
.isl[data-preview] .cand { border-bottom: 0.45mm dotted #E8A317; }
.hole { color: #7A4A06; background: #FFF1D4; border: 0.3mm dashed #B8741A; border-radius: 1.4mm; padding: 0 1.6mm; font: 600 0.78em/1.6 var(--ui); }
.opt-tag { margin-inline-start: auto; font: 700 7pt/1 var(--ui); color: #9A620A; background: #FCEFD2; border-radius: 2mm; padding: 0.8mm 2mm; font-style: normal; white-space: nowrap; }
.ur-ct { flex: 1; }

/* ---- the passport */
.pp { gap: 4.4mm; padding-top: 3mm; }
.pp-card { flex: none; border-radius: 6mm; background: #FFFFFF; border: 0.7mm solid var(--green); overflow: hidden; box-shadow: 0 1.2mm 0 #BFD8CB; }
.pp-band { height: 15mm; background: var(--green); display: flex; align-items: center; gap: 3.4mm; padding-inline: 5mm; }
.pp-emblem svg { width: 9mm; height: 9mm; }
.pp-band-t { display: flex; flex-direction: column; line-height: 1.2; }
.pp-band-t b { font: 800 14pt/1.3 var(--kitab); color: #FFE7A3; }
.pp-band-t small { font: 700 8pt var(--title); color: #CFE6D8; }
.pp-body { display: flex; gap: 6mm; padding: 4.6mm 6mm 4.4mm; }
.pp-photo { flex: none; position: relative; width: 36mm; height: 44mm; border-radius: 4mm; overflow: hidden; background: var(--gold-soft); border: 0.8mm solid var(--gold); }
.pp-photo img { position: absolute; left: 50%; top: 2mm; width: 44mm; transform: translateX(-50%); }
.pp-fields { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 2.6mm; }
.pf dt { font: 700 9pt var(--ui); color: var(--muted); }
.pf dd { font: 800 19pt/1.5 var(--kitab); color: var(--green); border-bottom: 0.45mm solid var(--line); min-height: 10mm; white-space: nowrap; overflow: hidden; }
.pf.sign dd { height: 11mm; border-bottom: 0.5mm solid #9C8A66; }
.pp-strip { height: 6.4mm; background: #EEF5F0; display: flex; align-items: center; justify-content: space-around; border-top: 0.4mm dashed #BFD8CB; padding-inline: 4mm; }
.pp-strip .ico { width: 3.6mm; height: 3.6mm; color: #8FB9A8; }
.pp-block { flex: none; display: flex; flex-direction: column; gap: 2.4mm; }
.pp-h { font: 800 13pt/1.3 var(--kitab); color: var(--deep); display: flex; align-items: center; gap: 2mm; }
.pp-h .ico { width: 6mm; height: 6mm; color: var(--c); }
.pp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; }
.pp-stamp { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.6mm; }
.pp-stamp .stamp-art { width: 32mm; height: 32mm; }
.pp-stn { position: absolute; top: 0; inset-inline-start: 2mm; min-width: 6.4mm; height: 6.4mm; padding: 0 1.2mm; border-radius: 3.2mm; font: 800 9pt/6.4mm var(--title); text-align: center; z-index: 1; box-shadow: 0 0 0 0.6mm #FFFFFF; }
.pp-stt { font: 700 10.5pt/1.5 var(--kitab); text-align: center; color: var(--ink); white-space: nowrap; }
.pp-stars { display: flex; justify-content: space-between; padding-inline: 1mm; }
.pp-star { position: relative; width: 17mm; height: 17mm; }
.pp-star .star-outline { width: 17mm; height: 17mm; color: #E2A32A; }
.pp-star i { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 800 9pt/1 var(--title); font-style: normal; color: #B8741A; padding-top: 1.8mm; }

/* ---- the certificate */
.ic { z-index: 0; }
.ic-frame { position: absolute; inset: 0; pointer-events: none; }
.ic-line { position: absolute; display: block; }
.ic-line.a { inset: 6.5mm; border: 1.5mm solid var(--green); border-radius: 7mm; background: #FFFFFF; }
.ic-line.b { inset: 10.6mm; border: 0.55mm solid var(--gold); border-radius: 4.4mm; }
.ic-corner { position: absolute; width: 13mm; height: 13mm; }
.ic-corner svg { width: 100%; height: 100%; }
.ic-corner.tl { left: 0; top: 0; } .ic-corner.tr { right: 0; top: 0; }
.ic-corner.bl { left: 0; bottom: 0; } .ic-corner.br { right: 0; bottom: 0; }
.ic-body { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; padding: 16mm 16mm 18mm; gap: 2.2mm; }
.ic-top { display: flex; align-items: center; gap: 3.4mm; }
.ic-top svg { width: 7mm; height: 7mm; }
.ic-top b { font: 800 13pt/1.4 var(--kitab); color: var(--green); }
.ic-title { font: 800 34pt/1.55 var(--kitab); color: var(--green); text-align: center; white-space: nowrap; max-width: 160mm; }
.ic-give { font: 600 13.5pt/1.6 var(--kitab); color: var(--ink-2); }
.ic-name { margin-top: 0.6mm; background: var(--green); border-radius: 8mm; padding: 0.6mm 14mm 1.4mm; box-shadow: 0 1.2mm 0 #123D2F; max-width: 150mm; }
.ic-name span { display: block; font: 800 31pt/1.6 var(--kitab); color: #FFFFFF; white-space: nowrap; text-align: center; }
.ic-hero { position: relative; flex: none; width: 130mm; height: 98mm; margin-top: 3mm; display: flex; justify-content: center; align-items: flex-end; }
.ic-ring { position: absolute; left: 50%; bottom: 0; width: 96mm; height: 96mm; transform: translateX(-50%); border-radius: 50%; background: #FFF3D4; box-shadow: 0 0 0 1.4mm #FFFFFF, 0 0 0 2.1mm #F0D58A; }
.ic-hero img { position: relative; height: 96mm; }
.ic-statement { margin-top: 3mm; font: 800 21pt/1.95 var(--kitab); color: var(--ink); text-align: center; max-width: 152mm; }
.ic-sign { margin-top: auto; display: flex; gap: 14mm; width: 100%; justify-content: center; }
.ic-sign > div { display: flex; flex-direction: column; align-items: center; gap: 0.8mm; min-width: 62mm; }
.ic-label { font: 700 9.5pt var(--ui); color: var(--muted); }
.ic-value { font: 700 14pt/1.7 var(--kitab); color: var(--ink); border-bottom: 0.4mm solid var(--line); min-width: 62mm; text-align: center; min-height: 9mm; }
.ic-value.blank { border-bottom: 0.5mm solid #9C8A66; }

/* ---- the surah page */
.su { gap: 3.4mm; padding-top: 4mm; --vh: 92mm; --th: 76mm; }
.su-verse { flex: none; padding: 3mm 3mm 1mm; }
.sacred-text.stacked .ayah { display: block; }
.sacred-text .ayah.basmala { display: block; font-size: 0.82em; }
.su-verse .sacred.is-placeholder .sacred-hole { min-height: 70mm; justify-content: center; }
.su-meaning { flex: none; padding: 2.6mm 5mm 2.8mm; }
.su-meaning h2 { display: flex; align-items: center; gap: 1.8mm; font: 700 11.5pt/1.4 var(--kitab); color: var(--deep); }
.su-meaning h2 .ico { width: 5mm; height: 5mm; color: var(--c); }
.su-meaning p { font: 700 14pt/1.9 var(--kitab); }
.su-row { flex: none; display: grid; grid-template-columns: 44mm 1fr; gap: 3mm; }
.su-row.no-qr { grid-template-columns: 1fr; }
.su-qr { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.4mm; padding: 2.4mm; }
.su-qr-code { width: 25mm; height: 25mm; }
.su-qr-code svg { width: 100%; height: 100%; }
.su-qr span { display: inline-flex; align-items: center; gap: 1.2mm; font: 700 10.5pt/1.3 var(--kitab); color: var(--deep); }
.su-qr span .ico { width: 5mm; height: 5mm; color: var(--c); }
.su-track { padding: 2.4mm 4mm 2.4mm; }
.su-track h2 { display: flex; align-items: center; gap: 1.8mm; font: 700 11.5pt/1.4 var(--kitab); color: var(--deep); margin-bottom: 0.8mm; }
.su-track h2 .ico { width: 5mm; height: 5mm; color: var(--c); }
.su-grid { display: grid; grid-template-columns: 16mm repeat(var(--days), 1fr); align-items: center; text-align: center; row-gap: 0.4mm; }
.su-corner { font: 700 7.5pt var(--ui); color: var(--muted); }
.su-day { font: 800 8pt/1.4 var(--title); color: var(--muted); }
.su-ay { font: 800 10.5pt/1 var(--title); color: var(--deep); padding-top: 1mm; }
.su-cell { display: flex; justify-content: center; }
.su-cell .star-outline { width: 7.6mm; height: 7.6mm; color: #E2A32A; }
.su-care { margin-top: 0; }
/* a verse block of fixed height: its text shrinks to fit (down to 14 pt), so the page does not move when the verified text replaces the placeholder */
.sacred.fixed { height: var(--vh, 46mm); display: flex; flex-direction: column; justify-content: center; align-items: center; }
.sacred.fixed .sacred-text { max-height: var(--th, 28mm); overflow: hidden; flex: none; }
.sacred.fixed.quran { padding-block: 3.2mm 2.6mm; }
.sacred.fixed .sacred-ref, .sacred.fixed .sacred-credit { margin-top: 0.4mm; line-height: 1.3; }
.sacred.fixed.quran .sacred-text { line-height: 2.1; }
/* the ayah's number stays with its last word (it dropped alone onto a line, Al-Asr 3); the reference keeps
   clear of the low marks of the last line (the kasratan of «فَجٍّ» sat on «٢٢:٢٧») */
.ay-end { white-space: nowrap; }
.sacred.quran .sacred-ref { margin-top: 2.2mm; }
.sacred.fixed.quran .sacred-ref { margin-top: 1.8mm; }
.sacred.fixed .sacred-hole { width: 100%; }
.pp-how, .pp-h { padding-inline: 1.4mm; }
.pp-how { font: 600 11pt/1.6 var(--kitab); color: var(--ink-2); }
/* ---- the thin pages: a pillar, a day, a unit's endings, the final assessment */
.pl-pillar { display: flex; align-items: center; gap: 4mm; padding: 4mm 6mm; }
.pl-pillar i { width: 14mm; height: 14mm; border-radius: 50%; background: var(--c); color: var(--on); display: flex; align-items: center; justify-content: center; }
.pl-pillar i .ico { width: 8.4mm; height: 8.4mm; }
.pl-pillar h2 { font: 800 22pt/1.6 var(--kitab); color: var(--deep); }
.pl-idea { padding: 4mm 6mm; } .pl-idea p { font: 700 17pt/2 var(--kitab); }
.dy { gap: 2.6mm; padding-top: 3mm; }
.dy-row { display: flex; align-items: center; gap: 3.4mm; padding: 1.6mm 3mm; background: #FFFFFF; border: 0.5mm solid var(--line); border-inline-start: 2.2mm solid var(--c); border-radius: 4mm; }
.dy-n { flex: none; width: 8mm; height: 8mm; border-radius: 50%; background: var(--c); color: var(--on); font: 800 11pt/1 var(--title); display: flex; align-items: center; justify-content: center; padding-top: 1mm; }
.dy-pic-box { flex: none; width: 17mm; height: 17mm; } .dy-pic-box .dy-pic { width: 100%; height: 100%; }
.dy-t b { font: 700 10pt var(--ui); color: var(--deep); } .dy-t p { font: 700 14pt/1.7 var(--kitab); }
.uc-list { list-style: none; display: flex; flex-direction: column; gap: 0.6mm; } .uc-list li { font: 700 14pt/1.8 var(--kitab); }
.uc-dhikr { position: relative; padding-top: 3.6mm; }
.fa-row { display: flex; align-items: center; justify-content: space-between; gap: 4mm; padding: 3mm 5mm; }
.fa-t b { font: 800 12pt var(--ui); color: var(--deep); } .fa-t p { font: 700 14.5pt/1.8 var(--kitab); }
.fa-stars { display: flex; flex-direction: column; align-items: center; gap: 0.6mm; } .fa-stars small { font: 600 7.5pt var(--ui); color: var(--muted); }
{% include "islamic-pages2.css.j2" %}
/* @@END@@ */
