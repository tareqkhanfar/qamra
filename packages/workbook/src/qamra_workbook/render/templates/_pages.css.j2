/* ---- odd one out */
.odd { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 4mm; }
.odd-row { display: flex; align-items: center; gap: 2mm; padding: 3.5mm 4mm; background: var(--card);
           border: 0.5mm solid var(--line); border-radius: 7mm; box-shadow: 0 0.9mm 0 var(--line-soft); }
.odd-row.is-example { background: var(--paper); border: 0.5mm dashed var(--line); padding: 2mm 4mm; box-shadow: none; }
.row-mark { width: 15mm; flex: none; display: flex; justify-content: center; }
.num { width: 9.5mm; height: 9.5mm; border-radius: 50%; background: var(--tint); color: var(--deep);
       font: 800 14pt/1 var(--title); display: flex; align-items: center; justify-content: center; padding-top: 0.8mm; }
.num.mark { padding-top: 0; } .num.mark .ico { width: 5.5mm; height: 5.5mm; color: var(--c); }
.odd-cells { flex: 1; display: flex; justify-content: space-around; align-items: center; }
.odd-cell { position: relative; width: 34mm; height: 34mm; }
.odd-row.five .odd-cell { width: 29mm; height: 29mm; }
.is-example .odd-cell { width: 24mm; height: 24mm; }
.ring { position: absolute; left: -3.5mm; top: -3.5mm; width: calc(100% + 7mm); height: calc(100% + 7mm); }

/* ---- full-work-area drawings (mazes, drills, maps): scale to the space left, keep the aspect */
.fill { position: relative; flex: 1; min-height: 0; }
.fill > svg, .scene-card > svg, .spot-scene > svg, .finger-card > svg.finger {
  position: absolute; inset: 0; width: 100%; height: 100%; }

/* ---- quantity first */
.qty { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 4mm; }
.qty-row { display: flex; align-items: center; gap: 3mm; padding: 3mm 4mm; background: var(--card);
           border: 0.5mm solid var(--line); border-radius: 7mm; box-shadow: 0 0.9mm 0 var(--line-soft); }
.qty-row.is-example { background: var(--paper); border-style: dashed; box-shadow: none; }
.qty-group { width: 54mm; height: 40mm; flex: none; background: #FFF6F2; border-radius: 5mm; display: flex;
             align-items: center; justify-content: center; }
.qty-group svg { width: 52mm; height: 37mm; }
.qty-arrow { width: 7mm; color: #D7C6A5; flex: none; }
.qty-arrow svg { width: 7mm; height: 3.5mm; }
.qty-cards { flex: 1; display: flex; justify-content: space-evenly; min-width: 0; }
.qty-card { position: relative; width: 27mm; height: 27mm; border: 0.6mm solid var(--line); border-radius: 4mm;
            background: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.qty-card svg.dots { width: 23mm; height: 23mm; }
.is-example .qty-group { height: 34mm; } .is-example .qty-card { width: 24mm; height: 24mm; }
.is-example .qty-card svg.dots { width: 20mm; height: 20mm; }
/* numeral cards (once the numerals are met): one big numeral in the page's numerals, ١٢٣ or 123 */
.qty-card .numeral { font: 800 44pt/1 var(--title); color: var(--deep); padding-top: 2mm; }
.is-example .qty-card .numeral { font-size: 38pt; }

/* ---- listen and choose */
.listen { flex: 1; display: flex; flex-direction: column; gap: 6mm; }
.listen .qr-card { align-self: center; padding-inline-end: 6mm; }
.listen .qr-card .label { max-width: 78mm; }
.listen-grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 6mm; }
.listen-card { position: relative; background: var(--card); border: 0.5mm solid var(--line); border-radius: 8mm;
               box-shadow: 0 0.9mm 0 var(--line-soft);
               display: flex; align-items: center; justify-content: center; }
.listen-card .pic { width: 62mm; height: 62mm; }
.listen-card .ring { left: 50%; top: 50%; width: 78mm; height: 78mm; transform: translate(-50%, -50%); }

/* ---- finger trace */
.finger-page { flex: 1; display: flex; flex-direction: column; gap: 5mm; }
.finger-card { position: relative; flex: 1; min-height: 0; background: var(--card); border: 0.5mm solid var(--line);
               border-radius: 8mm; }
.finger-card > svg.finger { inset: 12mm 8mm 6mm; width: calc(100% - 16mm); height: calc(100% - 18mm); }
.finger-hint { position: absolute; top: 4mm; inset-inline-start: 5mm; display: flex; align-items: center; gap: 1.5mm;
               font: 600 9.5pt var(--body); color: var(--go); }
.finger-hint .ico { width: 5mm; height: 5mm; }
.finger-bottom { display: flex; gap: 5mm; align-items: stretch; height: 44mm; }
.word-card { flex: 1; display: flex; align-items: center; gap: 5mm; padding: 3mm 6mm; background: var(--card);
             border: 0.5mm solid var(--line); border-radius: 6mm; }
.word-pic { width: 36mm; height: 36mm; flex: none; }
.word-text { font: 700 40pt/1.3 var(--naskh); color: var(--night); }
.finger-bottom .qr-card { width: 84mm; }

/* ---- English letter */
.en-page { flex: 1; display: flex; flex-direction: column; gap: 4mm; }
.en-top { display: flex; gap: 4mm; height: 64mm; }
.en-model-card { flex: 1.5; background: var(--card); border: 0.5mm solid var(--line); border-radius: 6mm; padding: 4mm 6mm;
                 display: flex; align-items: center; justify-content: center; }
.en-model-card svg { width: 100%; height: 100%; }
.en-word-card { flex: 1; background: var(--card); border: 0.5mm solid var(--line); border-radius: 6mm;
                display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5mm; }
.en-word-card .word-pic { width: 30mm; height: 30mm; }
.en-word { font: 800 22pt/1.1 var(--title); color: var(--night); }
.en-word-ar { font: 700 12pt var(--naskh); color: var(--muted); }
.en-qr { width: 34mm; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5mm;
         background: var(--card); border: 0.5mm solid var(--line); border-radius: 6mm; padding: 2mm; }
.en-qr > svg { width: 26mm; height: 26mm; }
.en-qr span { display: flex; align-items: center; gap: 1mm; font: 600 8.5pt var(--body); color: var(--muted); }
.en-qr .ico { width: 4mm; height: 4mm; color: var(--c); }
.en-rows { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; background: var(--card);
           border: 0.5mm solid var(--line); border-radius: 6mm; padding: 2mm 5mm; }
.en-row svg { width: 100%; height: auto; }

/* ---- journey map */
.stop-text { font: 700 4.1px var(--title); fill: #1C2140; }
.stop-num { font: 800 3.4px var(--title); fill: #FFFFFF; }

/* ---- certificate */
.cert { position: relative; flex: 1; }
.cert-border, .cert-stars { position: absolute; inset: 0; width: 100%; height: 100%; }
.cert-body { position: absolute; inset: 9mm 12mm 7mm; display: flex; flex-direction: column; align-items: center; }
.cert-ribbon { position: relative; width: 104mm; height: 19mm; display: flex; align-items: center; justify-content: center; }
.cert-ribbon svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.cert-ribbon span { position: relative; font: 800 17pt/1 var(--title); color: #FFFFFF; margin-top: -2.2mm; }
.cert-heading { display: flex; align-items: center; gap: 3mm; margin-top: 5mm; }
.cert-heading h1 { font: 800 36pt/1.1 var(--title); color: var(--night); }
.cert-heading .cap { width: 15mm; height: 15mm; color: var(--night); }
.cert-line { font: 600 15pt/1.5 var(--body); color: var(--ink-2); margin-top: 1mm; }
.cert-hero { position: relative; width: 120mm; height: 100mm; margin-top: 3mm; display: flex; justify-content: center; }
.cert-burst { position: absolute; left: 50%; top: 0; width: 100mm; height: 100mm; transform: translateX(-50%); }
.cert-child { position: relative; height: 94mm; margin-top: 4mm; }
.cert-medal { position: absolute; left: 4mm; bottom: 4mm; width: 30mm; height: 38mm; }
.cert-medal svg { width: 100%; height: 100%; }
.cert-name { margin-top: -3mm; position: relative; z-index: 2; padding: 1mm 16mm 2mm; border-radius: 9mm; background: var(--night);
             box-shadow: 0 1.2mm 0 #0E1530; }
.cert-name span { font: 800 34pt/1.25 var(--title); color: #FFFFFF; }
.cert-stops { display: flex; gap: 2.2mm; margin-top: 6mm; align-items: center; }
.cert-stop { width: 10.5mm; height: 10.5mm; border-radius: 50%; display: flex; align-items: center; justify-content: center;
             color: #FFFFFF; box-shadow: 0 0 0 0.6mm #FFFFFF, 0 0 0 1mm #EFE5D2; }
.cert-stop .ico { width: 6mm; height: 6mm; }
.cert-done { width: 10.5mm; height: 10.5mm; border-radius: 50%; background: var(--go); color: #FFFFFF; display: flex;
             align-items: center; justify-content: center; }
.cert-done .ico { width: 7mm; height: 7mm; }
.cert-sign { display: flex; gap: 12mm; margin-top: 7mm; width: 100%; justify-content: center; }
.cert-sign > div { display: flex; flex-direction: column; align-items: center; gap: 1mm; min-width: 58mm; }
.cert-label { font: 600 9.5pt var(--body); color: var(--muted); }
.cert-value { font: 700 14pt var(--body); color: var(--ink); border-bottom: 0.4mm solid var(--line); min-width: 58mm;
              text-align: center; padding-bottom: 1mm; }
.cert-blank { height: 9mm; }
.cert-say { margin-top: auto; }
.cert-say .mascot { width: 15mm; height: 15mm; }
.cert-say .bubble { font-size: 13pt; padding: 1.5mm 5mm 2mm; }

/* ---- patterns */
.pattern { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: 5mm; }
.pat-row { display: flex; align-items: center; gap: 2mm; padding: 4.5mm 4mm; background: var(--card);
           border: 0.5mm solid var(--line); border-radius: 7mm; box-shadow: 0 0.9mm 0 var(--line-soft); }
.pat-row.is-example { background: var(--paper); border-style: dashed; box-shadow: none; }
.pat-items { flex: 1; display: grid; grid-template-columns: repeat(var(--slots), 1fr); gap: 2.5mm; align-items: center; }
.pat-cell { aspect-ratio: 1; max-height: 31mm; display: flex; align-items: center; justify-content: center; position: relative; }
.pat-cell .pic { width: 88%; height: 88%; }
.pat-cell.blank { border: 0.7mm dashed var(--c); border-radius: 5mm; background: #FFFFFF; }
.pat-hint { position: absolute; bottom: 1.2mm; inset-inline-end: 1.4mm; display: flex; gap: 0.6mm; color: var(--line); }
.pat-hint .ico { width: 4mm; height: 4mm; }
.pat-answer { width: 80%; height: 80%; opacity: 0.9; }
.pat-answer .pic { width: 100%; height: 100%; }

/* ---- smart coloring */
.coloring { flex: 1; display: flex; flex-direction: column; gap: 4mm; }
.model-card { align-self: center; display: flex; align-items: center; gap: 4mm; padding: 2.5mm 6mm; background: var(--card);
              border: 0.5mm solid var(--line); border-radius: 6mm; }
.model-label { display: flex; align-items: center; gap: 1.5mm; font: 700 11pt var(--body); color: var(--deep); }
.model-label .ico { width: 5.5mm; height: 5.5mm; color: var(--c); }
.model-shapes svg { width: 42mm; height: 18.4mm; }
.model-note { font: 600 10pt var(--body); color: var(--muted); }
.scene-card { position: relative; flex: 1; min-height: 0; background: #FFFFFF; border: 0.5mm solid var(--line);
              border-radius: 7mm; }
.scene-card > svg { inset: 5mm; width: calc(100% - 10mm); height: calc(100% - 10mm); }

/* ---- spot the difference */
.spot { flex: 1; display: flex; flex-direction: column; gap: 4mm; align-items: center; }
.spot-scene { position: relative; flex: 1; min-height: 0; width: 100%; }
.tally { display: flex; align-items: center; gap: 3mm; padding: 2mm 5mm; border-radius: 7mm; background: var(--card);
         border: 0.5mm solid var(--line); }
.tally-label { display: flex; align-items: center; gap: 1.5mm; font: 700 11.5pt var(--body); color: var(--deep); margin-inline-end: 2mm; }
.tally-label .ico { width: 5mm; height: 5mm; color: var(--c); }
.tally-dot { width: 9mm; height: 9mm; border-radius: 50%; border: 0.7mm solid var(--c); background: #FFFFFF; display: flex;
             align-items: center; justify-content: center; color: var(--answer); }
.tally-dot .ico { width: 6mm; height: 6mm; }
