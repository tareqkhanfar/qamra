{#- full-bleed-cloud: the whole illustration; the text on a painted watercolor wash that sits in the reserved
    calm area (top / bottom / outer side). The wash fits its text: no fixed-size box. -#}
{% import "_macros.html.j2" as m %}
{% macro page(p) -%}
{% set area = p.panel.area if p.panel else 'top' %}
<section class="page lay-cloud{{ ' qr-' ~ p.side if p.qr_url and qr }}" style="{{ ink_vars(p) }}" data-faces="{{ faces_attr(p) }}" data-kind="story" data-layout="full-bleed-cloud" data-number="{{ p.number }}">
  <img class="bleed-img" src="{{ img(p.image) }}" alt="">
  {% if p.text %}
  <div class="cloud-box {{ area }}" data-area="{{ area }}" data-panel="{{ p.number }}">
    {{ m.wash(spec, t, orn, p) }}
    {{ m.story_body(p, s, hero) }}
  </div>
  {% endif %}
  {{ m.badge(spec, p, t, orn) }}
  {{ m.voice_qr(spec, s, p, qr) }}
  {{ m.watermark(spec, s) }}
</section>
{%- endmacro %}
