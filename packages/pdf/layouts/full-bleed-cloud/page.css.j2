/* full-bleed-cloud: the painted wash (.ink-shape) hugs the box; the motif and flourish sit on its edge */
.cloud-box { position: absolute; z-index: 2; isolation: isolate; display: flex; flex-direction: column; justify-content: center; padding: 4.5mm 10mm 5.5mm; width: max-content; }
.cloud-box.top, .cloud-box.bottom { left: 0; right: 0; margin: 0 auto; max-width: 166mm; max-height: 70mm; }
.cloud-box.top { top: calc(var(--safe) + 3mm); }
.cloud-box.bottom { bottom: calc(var(--bleed) + 25mm); }
.cloud-box.left, .cloud-box.right { top: calc(var(--safe) + 4mm); max-width: 84mm; max-height: 168mm; padding: 6mm 9mm; }
.cloud-box.left { left: calc(var(--safe) + 2mm); } .cloud-box.right { right: calc(var(--safe) + 2mm); }
.cloud-box .story-text { position: relative; }
