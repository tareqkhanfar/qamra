{#- full-bleed-fade: the whole illustration; the text sits on a soft gradient that fades into the art from
    the top or bottom edge (a soft halo on a side) — no box. Dark text areas get a night fade. -#}
{% import "_macros.html.j2" as m %}
{% macro page(p) -%}
{% set area = p.panel.area if p.panel else 'top' %}
{% set tone = p.panel.tone if p.panel else 'light' %}
<section class="page lay-fade{{ ' qr-' ~ p.side if p.qr_url and qr }}" style="{{ ink_vars(p) }}" data-faces="{{ faces_attr(p) }}" data-kind="story" data-layout="full-bleed-fade" data-number="{{ p.number }}">
  <img class="bleed-img" src="{{ img(p.image) }}" alt="">
  {% if p.text %}
  <div class="fade-box {{ area }} tone-{{ tone }}" style="--o: {{ p.panel.opacity if p.panel else 0.9 }}" data-panel="{{ p.number }}" data-area="{{ area }}" data-guard="text">
    {{ m.story_body(p, s, hero) }}
    {{ m.flourish_mark(spec, t, orn, p, 'text-flourish in-flow', '#FFE7A6' if tone == 'dark' else None) }}
  </div>
  {% endif %}
  {{ m.badge(spec, p, t, orn) }}
  {{ m.voice_qr(spec, s, p, qr) }}
  {{ m.watermark(spec, s) }}
</section>
{%- endmacro %}
