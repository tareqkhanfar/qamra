/* dialogue */
.dlg-box { position: absolute; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 6mm; }
.dlg-box.top, .dlg-box.bottom { left: calc(var(--safe) + 2mm); right: calc(var(--safe) + 2mm); max-height: 82mm; }
.dlg-box.top { top: calc(var(--safe) + 1mm); } .dlg-box.bottom { bottom: calc(var(--bleed) + 25mm); }
.dlg-box.left, .dlg-box.right { top: calc(var(--safe) + 2mm); width: 88mm; max-height: 170mm; }
.dlg-box.left { left: calc(var(--safe) + 1mm); } .dlg-box.right { right: calc(var(--safe) + 1mm); }
.dlg-caption { background: rgba(var(--cream-rgb), var(--o)); border-radius: 6mm; padding: 2.5mm 8mm; box-shadow: 0 .8mm 2.4mm rgba(22,32,74,.2); max-width: 100%; }
.bubble { position: relative; background: #FFFFFF; border: .9mm solid #1C2140; border-radius: 13mm; padding: 3mm 10mm; max-width: 150mm; box-shadow: 0 1.2mm 0 rgba(28,33,64,.22); }
.dlg-box.left .bubble, .dlg-box.right .bubble { max-width: 86mm; }
.bubble .story-text { font-family: "Naskh SemiBold", "Noto Naskh Arabic", serif; }
.bubble .tail { position: absolute; width: 9mm; height: 7mm; bottom: -6.3mm; left: 26%; }
.dlg-box.bottom .bubble .tail { bottom: auto; top: -6.3mm; transform: scaleY(-1); }
.side-left .bubble { align-self: flex-end; margin-right: 6mm; } .side-right .bubble { align-self: flex-start; margin-left: 6mm; }
.side-left .bubble .tail { left: auto; right: 26%; transform: scaleX(-1); }
.dlg-box.bottom.side-left .bubble .tail { transform: scale(-1, -1); }
