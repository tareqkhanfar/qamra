/* ornament-text */
.lay-ornament .orn-corner { position: absolute; width: 24mm; height: 24mm; }
.lay-ornament .orn-corner svg { width: 100%; height: 100%; }
.lay-ornament .orn-corner.tl { top: calc(var(--bleed) + 6mm); left: calc(var(--bleed) + 6mm); }
.lay-ornament .orn-corner.tr { top: calc(var(--bleed) + 6mm); right: calc(var(--bleed) + 6mm); transform: scaleX(-1); }
.lay-ornament .orn-corner.bl { bottom: calc(var(--bleed) + 6mm); left: calc(var(--bleed) + 6mm); transform: scaleY(-1); }
.lay-ornament .orn-corner.br { bottom: calc(var(--bleed) + 6mm); right: calc(var(--bleed) + 6mm); transform: scale(-1, -1); }
.lay-ornament .orn-arch { position: absolute; left: 0; right: 0; margin: 0 auto; width: 118mm; height: 104mm; overflow: hidden;
  border-radius: 59mm 59mm 4mm 4mm / 50mm 50mm 4mm 4mm; background: var(--paper);
  box-shadow: 0 0 0 1.3mm var(--cream), 0 0 0 2.1mm var(--gold), 0 0 0 3.2mm var(--cream), 0 0 0 3.6mm rgba(185,122,18,.55), 0 2mm 5mm 2mm rgba(22,32,74,.18); }
.lay-ornament .orn-arch img { width: 100%; height: 100%; object-fit: cover; }
.lay-ornament.text-top .orn-arch { bottom: calc(var(--bleed) + 14mm); }
.lay-ornament.text-top .orn-arch img { object-position: 50% 100%; }
.lay-ornament.text-bottom .orn-arch { top: calc(var(--bleed) + 14mm); }
.lay-ornament.text-bottom .orn-arch img { object-position: 50% 0%; }
.lay-ornament .orn-text { position: absolute; left: calc(var(--safe) + 14mm); right: calc(var(--safe) + 14mm); max-height: 74mm; display: flex; flex-direction: column; justify-content: center; }
.lay-ornament.text-top .orn-text { top: calc(var(--safe) + 6mm); }
.lay-ornament.text-bottom .orn-text { bottom: calc(var(--safe) + 13mm); }
.lay-ornament .story-text { text-align: start; text-align-last: center; }
.lay-ornament .drop { float: right; font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-size: 2.05em; line-height: 1.12; color: var(--accent); margin: .5mm 0 0 3mm; }
[dir="ltr"] .lay-ornament .drop { float: left; margin: .5mm 3mm 0 0; }
.lay-ornament .drop .hero-name { font-family: inherit; font-weight: inherit; } /* the display face has one weight: a synthetic bold prints as Type 3 */
.lay-ornament .orn-divider { display: flex; align-items: center; justify-content: center; gap: 2.5mm; margin-top: 2mm; }
.lay-ornament .orn-divider span { width: 26mm; border-top: .45mm solid rgba(213,154,42,.7); }
