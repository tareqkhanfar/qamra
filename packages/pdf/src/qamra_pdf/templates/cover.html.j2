{% import "_cover_parts.html.j2" as cv with context %}
{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="{{ spec.lang }}" dir="ltr">
{#- The wrap is laid out left → right as the printer sees the flat sheet. Arabic books are bound on the right,
    so the front panel is on the LEFT: [front | spine | back]. English books: [back | spine | front]. -#}
<head><meta charset="utf-8"><title>{{ spec.title }} — cover</title>
<style>
{% include "_base.css.j2" %}
{% include "_shared.css.j2" %}
{% include "_book_cover.css.j2" %}
@page { size: {{ spec.wrap_width_mm }}mm {{ spec.page_mm }}mm; margin: 0; }
.wrap { position: relative; width: {{ spec.wrap_width_mm }}mm; height: var(--page); overflow: hidden; background: {{ cover.reading.deep }}; }
.left-panel { left: 0; } .right-panel { left: {{ spec.trim_mm + spec.bleed_mm + spec.spine_mm }}mm; }
</style></head>
<body>
<section class="page wrap" data-kind="cover-wrap" style="width: {{ spec.wrap_width_mm }}mm">
  {% set front_left = spec.lang == 'ar' %}
  <div dir="{{ spec.dir }}" style="position:absolute;inset:0">
    <div class="{{ 'left-panel' if front_left else 'right-panel' }}" style="position:absolute;top:0;width:{{ spec.trim_mm + spec.bleed_mm }}mm;height:100%">{{ cv.front_panel('left' if front_left else 'right') }}</div>
    <div class="{{ 'right-panel' if front_left else 'left-panel' }}" style="position:absolute;top:0;width:{{ spec.trim_mm + spec.bleed_mm }}mm;height:100%">{{ cv.back_panel('right' if front_left else 'left') }}</div>
  </div>
  {{ cv.spine_strip() }}
  {{ m.watermark(spec, s) }}
</section>
</body></html>
