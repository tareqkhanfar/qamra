{% import "_book.html.j2" as book with context %}
{% import "_cover_parts.html.j2" as cv with context %}
{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="{{ spec.lang }}" dir="{{ spec.dir }}">
{#- Web proof: front cover, the interior in reading order, back cover. Small images; not for print. -#}
<head><meta charset="utf-8"><title>{{ spec.title }} — proof</title>
<style>
{% include "_base.css.j2" %}
{{ book.styles() }}
{% include "_book_cover.css.j2" %}
.proof-cover .front, .proof-cover .back { left: 0; width: var(--page); }
.proof-cover .front .trim, .proof-cover .back .trim { left: var(--bleed); }
</style></head>
<body>
<section class="page proof-cover" data-kind="front-cover" dir="ltr"><div dir="{{ spec.dir }}">{{ cv.front_panel('left') }}</div>{{ m.watermark(spec, s) }}</section>
{{ book.pages() }}
<section class="page proof-cover" data-kind="back-cover" dir="ltr"><div dir="{{ spec.dir }}">{{ cv.back_panel('right') }}</div></section>
</body></html>
