<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<title>{{ spec.number }}</title>
<style>
@font-face { font-family: "Baloo Bhaijaan 2"; src: url("{{ fonts }}/BalooBhaijaan2-ExtraBold.ttf") format("truetype"); font-weight: 700 900; }
@font-face { font-family: "IBM Plex Sans Arabic"; src: url("{{ fonts }}/IBMPlexSansArabic-Regular.ttf") format("truetype"); font-weight: 400 500; }
@font-face { font-family: "IBM Plex Sans Arabic"; src: url("{{ fonts }}/IBMPlexSansArabic-SemiBold.ttf") format("truetype"); font-weight: 600 900; }
@page { size: A4; margin: 0; }
* { box-sizing: border-box; }
body { margin: 0; font-family: "IBM Plex Sans Arabic", sans-serif; color: #16204A; font-size: 10.5pt; }
.sheet { width: 210mm; min-height: 297mm; padding: 16mm 16mm 14mm; display: flex; flex-direction: column; gap: 8mm; }
header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1.2mm solid #F2B33D; padding-bottom: 5mm; }
.brand { font-family: "Baloo Bhaijaan 2", sans-serif; font-size: 26pt; font-weight: 800; line-height: 1; }
.muted { color: #5B6385; }
.title { text-align: left; }
.title h1 { margin: 0; font-size: 18pt; }
.num { font-weight: 600; direction: ltr; unicode-bidi: isolate; }
.parties { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm; }
.box h2 { margin: 0 0 2mm; font-size: 10pt; color: #5B6385; font-weight: 600; }
table { width: 100%; border-collapse: collapse; }
th { text-align: right; font-weight: 600; color: #5B6385; font-size: 9.5pt; border-bottom: 0.4mm solid #D9D3C4; padding: 2.5mm 2mm; }
td { padding: 3mm 2mm; border-bottom: 0.2mm solid #ECE6D8; vertical-align: top; }
td.n, th.n { text-align: left; white-space: nowrap; }
.detail { color: #5B6385; font-size: 9pt; }
.totals { width: 75mm; margin-inline-start: auto; }
.totals div { display: flex; justify-content: space-between; padding: 1.5mm 0; }
.totals .grand { border-top: 0.5mm solid #16204A; margin-top: 1mm; padding-top: 2.5mm; font-weight: 700; font-size: 13pt; }
footer { margin-top: auto; border-top: 0.2mm solid #ECE6D8; padding-top: 4mm; font-size: 9pt; color: #5B6385; display: flex; justify-content: space-between; }
</style>
</head>
<body>
<main class="sheet">
  <header>
    <div>
      <div class="brand">{{ spec.company }}</div>
      {% for line in spec.company_details %}<div class="muted"{% if line[:1] in "+0123456789" %} dir="ltr" style="text-align: right"{% endif %}>{{ line }}</div>{% endfor %}
    </div>
    <div class="title">
      <h1>فاتورة</h1>
      <div class="num">{{ spec.number }}</div>
      <div class="muted">{{ spec.issued.strftime("%d/%m/%Y") }}</div>
    </div>
  </header>

  <section class="parties">
    <div class="box">
      <h2>إلى</h2>
      <div><strong>{{ spec.customer }}</strong></div>
      {% for line in spec.customer_details %}<div{% if line[:1] in "+0123456789" %} dir="ltr" style="text-align: right"{% endif %}>{{ line }}</div>{% endfor %}
    </div>
    <div class="box">
      <h2>الطلب</h2>
      <div class="num">{{ spec.order_code }}</div>
      <div>{{ spec.payment }}</div>
    </div>
  </section>

  <table>
    <thead>
      <tr><th>البند</th><th class="n">الكمية</th><th class="n">سعر الوحدة</th><th class="n">المجموع</th></tr>
    </thead>
    <tbody>
      {% for line in spec.lines %}
      <tr>
        <td>{{ line.name }}{% if line.detail %}<div class="detail">{{ line.detail }}</div>{% endif %}</td>
        <td class="n">{{ line.qty }}</td>
        <td class="n">{{ money(line.unit_price, spec.currency) }}</td>
        <td class="n">{{ money(line.total, spec.currency) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="totals">
    <div><span>المجموع الفرعي</span><span>{{ money(spec.subtotal, spec.currency) }}</span></div>
    {% if spec.discount > 0 %}<div><span>الخصم</span><span>{{ money(spec.discount, spec.currency) }}</span></div>{% endif %}
    <div><span>التوصيل</span><span>{{ money(spec.delivery, spec.currency) }}</span></div>
    <div class="grand"><span>المستحق</span><span>{{ money(spec.total, spec.currency) }}</span></div>
  </div>

  <footer>
    <span>شكرًا لأنكم جعلتم طفلكم بطل حكايته 🌙</span>
    <span class="num">{{ spec.order_code }}</span>
  </footer>
</main>
</body>
</html>
