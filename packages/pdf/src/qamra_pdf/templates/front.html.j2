{% import "_cover_parts.html.j2" as cv with context %}
<!doctype html>
<html lang="{{ spec.lang }}" dir="{{ spec.dir }}">
{#- The front cover alone (catalog cards, phone-thumbnail checks): same markup as the proof's first page. -#}
<head><meta charset="utf-8"><title>{{ spec.title }} — front</title>
<style>
{% include "_base.css.j2" %}
{% include "_shared.css.j2" %}
{% include "_book_cover.css.j2" %}
@page { size: {{ spec.page_mm }}mm {{ spec.page_mm }}mm; margin: 0; }
.proof-cover .front { left: 0; width: var(--page); }
.proof-cover .front .trim { left: var(--bleed); }
</style></head>
<body>
<section class="page proof-cover" data-kind="front-cover" dir="ltr"><div dir="{{ spec.dir }}">{{ cv.front_panel('left') }}</div></section>
</body></html>
