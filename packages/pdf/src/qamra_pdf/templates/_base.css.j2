/* Static font instances only: Chromium embeds variable fonts as Type 3, which print RIPs dislike. */
@font-face { font-family: "Baloo Bhaijaan 2"; src: url("{{ fonts }}/BalooBhaijaan2-Medium.ttf") format("truetype"); font-weight: 400 600; }
@font-face { font-family: "Baloo Bhaijaan 2"; src: url("{{ fonts }}/BalooBhaijaan2-ExtraBold.ttf") format("truetype"); font-weight: 700 900; }
@font-face { font-family: "Noto Naskh Arabic"; src: url("{{ fonts }}/NotoNaskhArabic-Regular.ttf") format("truetype"); font-weight: 400 600; }
@font-face { font-family: "Noto Naskh Arabic"; src: url("{{ fonts }}/NotoNaskhArabic-Bold.ttf") format("truetype"); font-weight: 700 900; }
@font-face { font-family: "IBM Plex Sans Arabic"; src: url("{{ fonts }}/IBMPlexSansArabic-Regular.ttf") format("truetype"); font-weight: 400 500; }
@font-face { font-family: "IBM Plex Sans Arabic"; src: url("{{ fonts }}/IBMPlexSansArabic-SemiBold.ttf") format("truetype"); font-weight: 600 900; }

/* tokens.json (CMYK-friendly subset) */
:root {
  --night-950: #0E1530; --night-900: #16204A; --night-800: #22306A;
  --moon: #F2B33D; --moon-glow: #FCEFD2; --moon-deep: #9A620A;
  --paper: #FBF6EC; --paper-raised: #FFFDF8; --line: #E4D6BC;
  --ink: #1C2140; --ink-muted: #585C72;
  --page: {{ spec.page_mm }}mm; --bleed: {{ spec.bleed_mm }}mm;
  --safe: {{ spec.bleed_mm + spec.safe_mm }}mm; /* from the page edge incl. bleed */
}
@page { size: {{ spec.page_mm }}mm {{ spec.page_mm }}mm; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: var(--paper); color: var(--ink); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font-family: "Noto Naskh Arabic", "IBM Plex Sans Arabic", serif; }
.page { position: relative; width: var(--page); height: var(--page); overflow: hidden; page-break-after: always; break-after: page; background: var(--paper); }
.page:last-child { page-break-after: auto; break-after: auto; }
.bleed-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.safe { position: absolute; inset: var(--safe); }
.display { font-family: "Baloo Bhaijaan 2", "IBM Plex Sans Arabic", sans-serif; }
.textbox {
  position: absolute; top: var(--safe); inset-inline: var(--safe);
  background: rgba(255, 253, 248, 0.92); border-radius: 7mm; padding: 6mm 9mm;
  box-shadow: 0 2mm 6mm rgba(22, 32, 74, 0.18);
  font-size: 21pt; line-height: 2.05; text-align: center; color: var(--ink);
}
[dir="ltr"] .textbox { font-family: "Baloo Bhaijaan 2", sans-serif; font-weight: 500; line-height: 1.6; }
.folio { position: absolute; bottom: calc(var(--safe) - 4mm); inset-inline: 0; text-align: center; font: 600 10pt "IBM Plex Sans Arabic", sans-serif; color: var(--paper-raised); text-shadow: 0 0 2mm rgba(14,21,48,.6); }
.watermark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.watermark span { transform: rotate(-30deg); font: 800 44pt "Baloo Bhaijaan 2", sans-serif; color: rgba(255,253,248,.55); text-shadow: 0 0 3mm rgba(14,21,48,.35); white-space: nowrap; }
.moon-mark { width: 26mm; height: 26mm; }
