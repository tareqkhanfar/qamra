/* Cover panels (design: BookCover, BookBack). The front never carries the logo (Addendum 3 §4). */
.front, .back { position: absolute; top: 0; width: {{ spec.trim_mm + spec.bleed_mm }}mm; height: var(--page); overflow: hidden; }
.front .cover-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(14,21,48,.45), rgba(14,21,48,.12) 30%, rgba(14,21,48,0) 45%); }
.front .cover-title { position: absolute; top: var(--safe); inset-inline: {{ spec.safe_mm }}mm; text-align: center; }
.front .cover-name { font-size: 50pt; line-height: 1.15; font-weight: 800; color: var(--paper-raised); text-shadow: 0 .6mm 2.5mm rgba(14,21,48,.55), 0 0 1mm rgba(14,21,48,.35); }
.front .cover-sub { font-size: 24pt; line-height: 1.35; font-weight: 800; color: var(--moon); text-shadow: 0 .5mm 2mm rgba(14,21,48,.6); }
.back { background: var(--night-900); color: var(--paper-raised); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8mm; padding: var(--safe); text-align: center; }
.back .blurb { font-size: 15pt; line-height: 1.95; max-width: 150mm; color: var(--paper-raised); }
.back .back-brand { display: flex; flex-direction: column; align-items: center; gap: 1mm; }
.back .back-name { font-size: 14pt; font-weight: 800; color: var(--moon-glow); }
.back .qr-row { display: flex; align-items: center; gap: 4mm; }
.back .qr { width: 24mm; height: 24mm; background: var(--paper-raised); border-radius: 2mm; padding: 2mm; display: flex; align-items: center; justify-content: center; }
.back .qr svg { width: 100%; height: 100%; }
.back .qr-caption { font: 500 9.5pt "IBM Plex Sans Arabic", sans-serif; color: #B9BEDA; max-width: 60mm; text-align: start; line-height: 1.6; }
.back .back-domain { position: absolute; bottom: var(--safe); inset-inline: 0; font: 600 10pt "IBM Plex Sans Arabic", sans-serif; letter-spacing: .5mm; color: #B9BEDA; direction: ltr; }
.back .stars span { background: var(--moon-glow); }
