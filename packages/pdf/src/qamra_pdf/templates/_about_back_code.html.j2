{#- The book code, small, near the bottom of the back cover (qamra_pdf.imprint.back_code_html). -#}
<div class="qab-back-code{{ ' ' ~ cls if cls }}" data-book-code="{{ im.code }}" dir="{{ 'rtl' if im.lang == 'ar' else 'ltr' }}" style="flex:none;display:inline-flex;align-items:baseline;gap:1.4mm;font:600 7.2pt 'IBM Plex Sans Arabic',sans-serif;color:{{ ink }};white-space:nowrap"><em style="font-style:normal;opacity:.8">{{ im.text('back_code') }}</em><b style="direction:ltr;unicode-bidi:isolate;font:700 8.4pt 'IBM Plex Sans Arabic',sans-serif;letter-spacing:.5mm">{{ im.code }}</b></div>
