/* Story book interior: front and back matter (Addendum 11 §5). Story pages come from packages/pdf/layouts. */
@page { size: {{ spec.page_mm }}mm {{ spec.page_mm }}mm; margin: 0; }

/* Title + dedication */
.title-page .tp-stars svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.title-page .tp-frame { position: absolute; inset: calc(var(--bleed) + 9mm); border: .6mm solid rgba(213,154,42,.75); border-radius: 3mm;
  box-shadow: inset 0 0 0 1.6mm rgba(255,253,248,.0), inset 0 0 0 2mm rgba(213,154,42,.45); }
.title-page .tp-content { position: absolute; inset: calc(var(--safe) + 6mm) calc(var(--safe) + 10mm); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 2.4mm; }
.title-page .tp-name { font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-weight: 400; font-size: 40pt; line-height: 1.35; color: var(--title-ink); }
.title-page .tp-subtitle { font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-size: 24pt; line-height: 1.4; color: var(--accent); }
.title-page .tp-made-for { font: 500 11pt "IBM Plex Sans Arabic", sans-serif; color: var(--ink-muted); }
.title-page .moon-portrait { margin: 3mm 0 0; }
.title-page .tp-label { display: flex; align-items: center; gap: 3mm; font: 600 10.5pt "IBM Plex Sans Arabic", sans-serif; color: var(--moon-deep); margin-top: 1mm; }
.title-page .tp-label span { width: 16mm; border-top: .45mm solid rgba(213,154,42,.7); }
.title-page .tp-dedication { font-family: "Aref Ruqaa", "Noto Naskh Arabic", serif; font-weight: 700; font-size: 21pt; line-height: 1.75; color: #3B2A55; max-width: 146mm; }
[dir="ltr"] .title-page .tp-dedication { font-family: "Noto Naskh Arabic", serif; font-style: italic; font-weight: 400; font-size: 17pt; }

/* «وهكذا وُلد صاحبي» */
.keepsake .frame-border { position: absolute; inset: var(--safe); border: .7mm solid var(--moon-deep); border-radius: 5mm; padding: 9mm 8mm; display: flex; flex-direction: column; align-items: center; text-align: center; box-shadow: inset 0 0 0 1.6mm var(--paper), inset 0 0 0 2mm var(--line); }
.keepsake h2 { font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-weight: 400; font-size: 28pt; line-height: 1.4; color: var(--title-ink); }
.keepsake .pair { display: flex; align-items: center; justify-content: center; gap: 6mm; margin-top: 8mm; }
.keepsake figure { display: flex; flex-direction: column; align-items: center; }
.keepsake .paper-sheet { position: relative; width: 62mm; height: 62mm; background: var(--paper-raised); padding: 3mm; box-shadow: 0 1.5mm 4mm rgba(22,32,74,.2); transform: rotate(3deg); display: flex; align-items: center; justify-content: center; }
.keepsake .paper-sheet img { max-width: 100%; max-height: 100%; object-fit: contain; }
.keepsake .paper-sheet .tape { position: absolute; top: -4mm; left: 50%; width: 22mm; height: 6.5mm; margin-left: -11mm; transform: rotate(-4deg); }
.keepsake .circle { width: 58mm; height: 58mm; border-radius: 50%; background: var(--night-900); overflow: hidden; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1.2mm var(--paper-raised), 0 0 0 1.8mm var(--gold); }
.keepsake .circle img { width: 92%; height: 92%; object-fit: contain; }
.keepsake figcaption { margin-top: 4mm; font: 600 11pt "IBM Plex Sans Arabic", sans-serif; color: var(--night-900); }
.keepsake .note { margin-top: 9mm; font-size: 16pt; line-height: 1.9; font-weight: 700; color: var(--ink); }
.keepsake .date { margin-top: 2mm; font: 500 10.5pt "IBM Plex Sans Arabic", sans-serif; color: var(--moon-deep); }

/* «للأهل»: two cards with icons, soft color blocks, the hero in a corner */
.parents .pa-blob { position: absolute; border-radius: 50%; }
.parents .pa-blob.b1 { width: 120mm; height: 92mm; top: -30mm; right: -34mm; background: {{ t.soft }}; opacity: .9; }
.parents .pa-blob.b2 { width: 104mm; height: 80mm; bottom: -28mm; left: -30mm; background: rgba(127,163,138,.22); }
.parents .pa-blob.b3 { width: 36mm; height: 30mm; top: 44mm; left: 14mm; background: rgba(242,179,61,.16); }
.parents .pa-head { position: absolute; top: calc(var(--safe) + 6mm); inset-inline: calc(var(--safe) + 4mm); display: flex; align-items: center; gap: 4mm; }
.parents .pa-head h2 { font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-weight: 400; font-size: 38pt; line-height: 1.3; color: var(--title-ink); }
.parents .pa-cards { position: absolute; top: calc(var(--safe) + 38mm); inset-inline: calc(var(--safe) + 2mm); display: grid; grid-template-columns: 1fr 1fr; gap: 7mm; align-items: stretch; }
.parents .pa-card { position: relative; background: rgba(255,253,248,.94); border-radius: 6mm; padding: 13mm 7mm 8mm; box-shadow: 0 1.2mm 3.5mm rgba(22,32,74,.12); border-top: 1.6mm solid var(--sage); }
.parents .pa-card.questions { border-top-color: var(--accent); }
.parents .pa-icon { position: absolute; top: -8.5mm; inset-inline-start: 7mm; width: 17mm; height: 17mm; }
.parents .pa-icon svg { width: 100%; height: 100%; }
.parents .pa-label { font: 600 13pt/1.6 "IBM Plex Sans Arabic", sans-serif; color: var(--title-ink); margin-bottom: 3mm; }
.parents .pa-lesson { font-size: 17pt; line-height: 1.9; color: var(--ink); }
.parents ol { list-style: none; display: flex; flex-direction: column; gap: 3mm; }
.parents li { display: flex; gap: 2.5mm; align-items: baseline; font-size: 17pt; line-height: 1.9; }
.parents .q-num { flex: none; width: 7.5mm; height: 7.5mm; border-radius: 50%; background: var(--accent); color: #FFFDF8; display: inline-flex; align-items: center; justify-content: center; font: 700 9.5pt "IBM Plex Sans Arabic", sans-serif; }
.parents .pa-hero { position: absolute; bottom: calc(var(--safe) + 2mm); inset-inline-end: calc(var(--safe) + 4mm); }
.parents .pa-hero::before { content: ""; position: absolute; inset: -8mm -12mm -6mm -10mm; border-radius: 50%; background: rgba(242,179,61,.16); }
.parents .pa-made-by { position: absolute; bottom: calc(var(--safe) + 16mm); inset-inline-start: calc(var(--safe) + 8mm); display: flex; align-items: center; gap: 2mm; font: 500 9.5pt "IBM Plex Sans Arabic", sans-serif; color: var(--ink-muted); }

/* «ارسم/ارسمي أجمل لحظة» */
.activity .ac-doodles, .activity .ac-doodles svg, .activity .ac-doodles img { position: absolute; inset: 0; width: 100%; height: 100%; }
.activity .ac-doodles img { object-fit: contain; opacity: .9; }
.activity .ac-title { position: absolute; top: calc(var(--safe) + 1mm); inset-inline: calc(var(--safe) + 4mm); text-align: center; font-family: "Marhey", "Baloo Bhaijaan 2", sans-serif; font-weight: 400; font-size: 21pt; line-height: 1.6; color: var(--title-ink); }
.activity .ac-frame { position: absolute; left: 23mm; top: 62mm; width: 170mm; height: 132mm; }
.activity .ac-frame .wavy-frame { position: absolute; inset: 0; width: 100%; height: 100%; }
.activity .ac-peek { position: absolute; top: -29mm; inset-inline-end: 8mm; width: 42mm; height: 34mm; display: flex; align-items: flex-end; justify-content: center; }
.activity .ac-peek img { max-width: 100%; max-height: 100%; object-fit: contain; object-position: bottom; }
.activity .ac-peek svg { width: 100%; height: 100%; }
.activity .ac-bubble { position: absolute; top: -22mm; inset-inline-end: 54mm; background: #FFFFFF; border: .7mm solid var(--title-ink); border-radius: 8mm; padding: 1.4mm 6mm; font: 600 14pt/1.8 "IBM Plex Sans Arabic", sans-serif; color: var(--title-ink); white-space: nowrap; }
.activity .ac-bubble::after { content: ""; position: absolute; top: 50%; inset-inline-end: -2.6mm; width: 4mm; height: 4mm; margin-top: -2mm; background: #FFFFFF; border-top: .7mm solid var(--title-ink); border-inline-end: .7mm solid var(--title-ink); transform: rotate(45deg); }
[dir="rtl"] .activity .ac-bubble::after { transform: rotate(-45deg) scaleX(-1); }

/* «ذكرياتنا»: two polaroids with tape, date lines and a memory prompt */
.memories .me-stars svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.memories .me-title { position: absolute; top: calc(var(--safe) + 2mm); inset-inline: 0; text-align: center; font-family: "Lalezar", "Baloo Bhaijaan 2", sans-serif; font-weight: 400; font-size: 30pt; line-height: 1.4; color: var(--title-ink); }
.memories .me-row { position: absolute; top: calc(var(--safe) + 25mm); inset-inline: calc(var(--safe) + 2mm); display: flex; justify-content: space-around; }
.memories .polaroid { position: relative; width: 80mm; background: #FFFFFF; padding: 4.5mm 4.5mm 3mm; box-shadow: 0 1.6mm 4mm rgba(22,32,74,.22); }
.memories .pol-photo { height: 74mm; background: #ECE7DE; display: flex; align-items: center; justify-content: center; }
.memories .pol-img { width: 100%; height: auto; display: block; }
.memories .polaroid .tape { position: absolute; top: -4mm; left: 50%; width: 30mm; height: 9mm; margin-left: -15mm; transform: rotate(-3deg); }
.memories figcaption { display: flex; flex-direction: column; align-items: center; padding-top: 2mm; }
.memories .pol-caption { font-family: "Aref Ruqaa", "Noto Naskh Arabic", serif; font-weight: 700; font-size: 18pt; line-height: 1.6; color: #3B2A55; }
.memories .pol-date { display: flex; align-items: baseline; gap: 2mm; font: 500 9.5pt "IBM Plex Sans Arabic", sans-serif; color: var(--ink-muted); }
.memories .pol-date i { width: 30mm; border-bottom: .35mm dotted var(--moon-deep); }
.memories .me-note { position: absolute; bottom: calc(var(--safe) + 14mm); inset-inline: calc(var(--safe) + 8mm); }
.memories .me-prompt { font-family: "Aref Ruqaa", "Noto Naskh Arabic", serif; font-weight: 700; font-size: 16pt; line-height: 1.6; color: var(--accent); }
.memories .me-lines { display: flex; flex-direction: column; gap: 8mm; margin-top: 4mm; }
.memories .me-lines span { border-bottom: .4mm dotted var(--moon-deep); height: 1px; }

/* «صوت أهلي» (design BookQR): an 18 mm code + 2 mm quiet zone on a paper card with 3 mm corners, never printed
   straight on the art, in the outer bottom corner with its edges on the 10 mm safe line. */
.voice-qr { position: absolute; bottom: var(--safe); width: 22mm; padding: 2mm; background: var(--paper-raised); border-radius: 3mm; display: flex; flex-direction: column; align-items: center; gap: .8mm; z-index: 6; }
.qr-left .voice-qr { left: var(--safe); } .qr-right .voice-qr { right: var(--safe); }
.voice-qr .code { width: 18mm; height: 18mm; }
.voice-qr .code svg { width: 100%; height: 100%; display: block; }
.voice-qr .caption { display: flex; align-items: center; gap: .8mm; font: 700 8pt/1 "IBM Plex Sans Arabic", sans-serif; color: var(--night-900); white-space: nowrap; }
.qr-left .cloud-box.left, .qr-right .cloud-box.right, .qr-left .dlg-box.left, .qr-right .dlg-box.right { max-height: 140mm; }
