{# Line icons on a 24-unit grid, one stroke weight, round caps — drawn for RTL (forward = left, binding on the right). #}
{% macro icon(kind, color='#F2B33D', width=1.5) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="{{ color }}" stroke-width="{{ width }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if kind == 'book' %}
  <path d="M12 6.4C10 4.9 7 4.4 3.5 4.8V18c3.5-.4 6.5.1 8.5 1.6 2-1.5 5-2 8.5-1.6V4.8C17 4.4 14 4.9 12 6.4Z"/>
  <path d="M12 6.4v13.2"/>
{% elif kind == 'spiral' %}
  <rect x="4" y="3" width="13.5" height="18" rx="2"/>
  <path d="M16 6.2h3.5M16 9.4h3.5M16 12.6h3.5M16 15.8h3.5"/>
  <path d="M7.5 8h5.5M7.5 11.5h5.5M9.5 15h3.5"/>
{% elif kind == 'cap' %}
  <path d="M12 4.5 2.5 9 12 13.5 21.5 9Z"/>
  <path d="M6.5 11v4.2c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3V11"/>
  <path d="M21.5 9v5.2"/>
{% elif kind == 'steps' %}
  <rect x="4" y="4" width="16" height="17" rx="2.2"/>
  <path d="M9 4V3h6v1"/>
  <path d="M13.2 9.7l1.3 1.3 2.3-2.4M13.2 15.7l1.3 1.3 2.3-2.4"/>
  <path d="M7.5 10h3M7.5 16h3"/>
{% elif kind == 'truck' %}
  <path d="M9.5 16.5V6.5h11v10"/>
  <path d="M9.5 9.5H5.8L3 13v3.5h2"/>
  <path d="M9.5 16.5h5.5M20.5 16.5h-1"/>
  <circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
{% elif kind == 'tag' %}
  <path d="M3.5 12.1V4.5a1 1 0 0 1 1-1h7.6a1 1 0 0 1 .7.3l8 8a1 1 0 0 1 0 1.4l-7.6 7.6a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7Z"/>
  <circle cx="8" cy="8" r="1.6"/>
{% endif %}
</svg>
{%- endmacro %}
