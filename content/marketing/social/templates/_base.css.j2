/* Qamra social kit — tokens from apps/web/src/app/globals.css (design/tokens.json). Two typefaces in the layout:
   Baloo Bhaijaan 2 (headlines, labels) and IBM Plex Sans Arabic (body, buttons). Noto Naskh Arabic appears only
   inside a book page (the vowelized story text), as in the printed books. All fonts are SIL OFL. */
@font-face { font-family: "Baloo"; src: url("{{ fonts }}/BalooBhaijaan2-ExtraBold.ttf") format("truetype"); font-weight: 700 900; }
@font-face { font-family: "Baloo"; src: url("{{ fonts }}/BalooBhaijaan2-Medium.ttf") format("truetype"); font-weight: 400 600; }
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSansArabic-Regular.ttf") format("truetype"); font-weight: 400 500; }
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSansArabic-SemiBold.ttf") format("truetype"); font-weight: 600 900; }
@font-face { font-family: "Naskh"; src: url("{{ fonts }}/NotoNaskhArabic-Regular.ttf") format("truetype"); font-weight: 400 600; }
@font-face { font-family: "Naskh"; src: url("{{ fonts }}/NotoNaskhArabic-Bold.ttf") format("truetype"); font-weight: 700 900; }

:root {
  --night-950: #0E1530; --night-900: #16204A; --night-800: #22306A; --night-700: #33458F; --night-500: #5B6FC0; --night-100: #E4E8F7;
  --amber-700: #9A620A; --amber-600: #DB9A1F; --amber-500: #F2B33D; --amber-300: #F5C465; --amber-100: #FCEFD2;
  --paper: #FBF6EC; --paper-raised: #FFFDF8; --paper-sunk: #F3EAD8; --line: #E4D6BC;
  --ink: #1C2140; --ink-muted: #585C72; --ink-dark: #F6EFDF; --ink-dark-muted: #B9BEDA; --line-dark: #2B3872;
  --sage-700: #3E6B4D; --sage-500: #7FA38A; --sage-300: #A9C7B1; --coral-700: #A7432D; --coral-500: #E9826B; --coral-300: #F4B3A2;
  --lav-700: #5A4A9C; --lav-300: #CBC1EA;
  --m: 88px;            /* outer margin: 11 × 8 px */
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: {{ W }}px; height: {{ H }}px; overflow: hidden; }
body { font-family: "Plex", sans-serif; color: var(--ink); background: var(--paper);
  -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision; font-kerning: normal; }
img { display: block; }
svg { display: block; overflow: visible; }

/* ------------------------------------------------------------------ backgrounds */
.canvas { position: relative; width: {{ W }}px; height: {{ H }}px; overflow: hidden; }
.paper-tex::before { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0; opacity: .55; mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='360' height='360'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .42  0 0 0 0 .33  0 0 0 0 .18  0 0 0 .09 0'/></filter><rect width='360' height='360' filter='url(%23n)'/></svg>"); }
.bg-night { background: radial-gradient(120% 70% at 50% 108%, #2B3B80 0%, rgba(43,59,128,0) 60%), linear-gradient(180deg, #0E1530 0%, #16204A 48%, #1C2A5E 100%); color: var(--paper-raised); }
.bg-deep { background: radial-gradient(90% 60% at 50% 70%, #22306A 0%, rgba(34,48,106,0) 70%), linear-gradient(180deg, #0B1128 0%, #0E1530 60%, #131C40 100%); color: var(--paper-raised); }
.bg-paper { background: var(--paper); }
.bg-sage { background: linear-gradient(180deg, #EDF2EA 0%, #E2ECE1 100%); }
.bg-glow { background: radial-gradient(80% 55% at 50% 72%, #FFF6E2 0%, rgba(255,246,226,0) 70%), linear-gradient(180deg, #FCEFD2 0%, #F9E6BF 100%); }
.bg-blush { background: radial-gradient(80% 55% at 50% 72%, #FFF3EE 0%, rgba(255,243,238,0) 70%), linear-gradient(180deg, #FBE7DF 0%, #F7DCD1 100%); }
.bg-sky { background: linear-gradient(180deg, #EEF1FA 0%, #E4E8F7 100%); }
.dark { color: var(--paper-raised); }

/* ------------------------------------------------------------------ the layout grid */
.layer { position: absolute; inset: 0; }
.frame { position: absolute; inset: 0; display: flex; flex-direction: column; padding: var(--m); z-index: 2; }
.top { display: flex; align-items: center; justify-content: space-between; height: 72px; flex: none; }

.logo { display: flex; align-items: center; gap: 16px; direction: rtl; }
.logo svg { width: 68px; height: 68px; }
.logo .word { font: 800 54px/1 "Baloo", sans-serif; color: var(--night-900); padding-top: 10px; }
.dark .logo .word { color: var(--paper-raised); }

.pill { display: inline-flex; align-items: center; gap: 12px; height: 60px; padding: 0 28px; border-radius: 30px;
  font: 600 27px/1 "Plex", sans-serif; color: var(--night-900); background: rgba(22,32,74,.07); white-space: nowrap; }
.pill i { width: 10px; height: 10px; border-radius: 50%; background: var(--amber-500); display: block; flex: none; }
.dark .pill { color: var(--amber-300); background: rgba(255,253,248,.07); box-shadow: inset 0 0 0 2px rgba(245,196,101,.32); }

.copy { flex: none; margin-top: 64px; }
.headline { font: 800 92px/1.24 "Baloo", sans-serif; color: var(--night-900); letter-spacing: 0; }
.headline .line { display: block; white-space: nowrap; }
.dark .headline { color: var(--paper-raised); }
.headline em { font-style: normal; color: var(--amber-700); }
.dark .headline em { color: var(--amber-500); }
.sub { margin-top: 24px; font: 400 36px/1.6 "Plex", sans-serif; color: var(--ink-muted); max-width: 904px; text-wrap: balance; }
.dark .sub { color: var(--ink-dark-muted); }

.visual { position: relative; flex: 1 1 auto; min-height: 0; margin: 40px 0; }
.stage { position: absolute; left: 50%; top: 50%; transform-origin: 50% 50%; }

.foot { flex: none; display: flex; flex-direction: column; gap: 24px; }
.note { display: flex; align-items: center; gap: 14px; font: 400 29px/1.4 "Plex", sans-serif; color: var(--ink-muted); }
.note svg { width: 30px; height: 30px; flex: none; }
.dark .note { color: var(--ink-dark-muted); }
.cta-row { display: flex; align-items: center; justify-content: space-between; height: 96px; }
.cta { display: inline-flex; align-items: center; gap: 18px; height: 96px; padding: 0 44px 0 40px; border-radius: 48px;
  background: var(--amber-500); color: var(--night-950); font: 600 36px/1 "Plex", sans-serif; white-space: nowrap;
  box-shadow: 0 10px 28px rgba(154,98,10,.22), inset 0 -3px 0 rgba(154,98,10,.18); }
.dark .cta { box-shadow: 0 10px 34px rgba(242,179,61,.38), inset 0 -3px 0 rgba(154,98,10,.25); }
.cta svg { width: 34px; height: 34px; }
.domain { direction: ltr; font: 600 34px/1 "Plex", sans-serif; color: var(--night-700); letter-spacing: .5px; }
.dark .domain { color: var(--amber-100); }

/* ------------------------------------------------------------------ book: square hardcover, spine on the right */
.hc { position: absolute; perspective: 2400px; }
.hc-body { position: absolute; inset: 0; transform-style: preserve-3d; }
.hc-face { position: absolute; left: 0; top: 0; backface-visibility: hidden; }
.hc-front { width: var(--s); height: var(--s); transform: translateZ(calc(var(--d) / 2)); border-radius: 4px 7px 7px 4px; overflow: hidden; }
.hc-front::before { content: ""; position: absolute; inset: 0; z-index: 9; pointer-events: none; border-radius: inherit; box-shadow: inset 2px 0 0 rgba(255,255,255,.22), inset 0 2px 0 rgba(255,255,255,.16), inset 0 -2px 0 rgba(0,0,0,.18); }
.hc-front .cover { position: absolute; left: 0; top: 0; width: 600px; height: 600px; transform-origin: 0 0; transform: scale(calc(var(--s) / 600px)); }
.hc-front::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 8;
  background:
    linear-gradient(to left, rgba(0,0,0,.34) 0, rgba(0,0,0,.08) 5px, rgba(255,255,255,.16) 9px, rgba(0,0,0,.20) 15px, rgba(0,0,0,0) 30px),
    linear-gradient(118deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,0) 38%, rgba(0,0,0,0) 62%, rgba(0,0,0,.14) 100%); }
.hc-back { width: var(--s); height: var(--s); transform: translateZ(calc(var(--d) / -2)) rotateY(180deg); background: var(--board); border-radius: 8px 3px 3px 8px; }
.hc-spine { width: var(--d); height: var(--s); left: calc(var(--s) - var(--d) / 2); transform: rotateY(90deg);
  background: linear-gradient(to right, var(--board-dark) 0%, var(--board) 30%, var(--board-light) 52%, var(--board) 72%, var(--board-dark) 100%); border-radius: 6px; }
.hc-top { width: var(--s); height: var(--d); top: calc(var(--d) / -2); transform: rotateX(90deg);
  background: linear-gradient(to bottom, var(--board) 0 4px, #EFE6D2 4px, #FBF6EC 30%, #EFE6D2 60%, #FBF6EC 85%, var(--board) calc(100% - 4px));
  border-radius: 3px; }
.hc-top::after { content: ""; position: absolute; inset: 4px 8px 4px 4px; background: repeating-linear-gradient(to bottom, rgba(120,100,70,.0) 0 2px, rgba(120,100,70,.10) 2px 3px); }
.hc-left { width: var(--d); height: var(--s); left: calc(var(--d) / -2); transform: rotateY(-90deg);
  background: linear-gradient(to right, var(--board) 0 4px, #F6EEDC 4px, #FBF6EC 50%, #F1E7D3 calc(100% - 4px), var(--board) calc(100% - 4px)); }
.hc-shadow { position: absolute; left: 6%; right: 2%; bottom: calc(var(--s) * -0.06); height: calc(var(--s) * 0.12);
  background: radial-gradient(closest-side, rgba(10,14,35,.42), rgba(10,14,35,0)); filter: blur(6px); }
.on-dark .hc-shadow { background: radial-gradient(closest-side, rgba(0,0,0,.6), rgba(0,0,0,0)); }

/* ------------------------------------------------------------------ book cover art (600 × 600 units) */
.cover { position: relative; overflow: hidden; direction: rtl; }
.cover .sky { position: absolute; inset: 0; }
.cover.night .sky { background: radial-gradient(70% 55% at 30% 18%, #2B3B80 0%, rgba(43,59,128,0) 70%), linear-gradient(180deg, #0E1530 0%, #1A2659 70%, #22306A 100%); }
.cover.dawn .sky { background: linear-gradient(180deg, #C9D3F0 0%, #E6E3EC 38%, #F8E3C6 70%, #FCEFD2 100%); }
.cover .title { position: absolute; top: 46px; left: 0; right: 0; text-align: center; font-family: "Baloo", sans-serif; font-weight: 800; z-index: 3; }
.cover .title span { display: block; white-space: nowrap; }
.cover .title .big { font-size: 112px; line-height: 1.02; }
.cover .title .small { font-size: 50px; line-height: 1.2; }
.cover .title.with-cap { top: 84px; }
.cover .title.with-cap .big { font-size: 104px; }
.cover.night .title .big { color: var(--amber-500); }
.cover.night .title .small { color: var(--paper-raised); }
.cover.dawn .title .big { color: var(--night-900); }
.cover.dawn .title .small { color: var(--night-800); }
.cover .kid { position: absolute; bottom: 58px; left: 50%; height: 318px; transform: translateX(-50%); z-index: 2; filter: drop-shadow(0 6px 8px rgba(10,14,35,.25)); }
.cover .brand { position: absolute; bottom: 20px; left: 26px; display: flex; align-items: center; gap: 6px; z-index: 3;
  font: 800 26px/1 "Baloo", sans-serif; }
.cover.night .brand { color: var(--paper-raised); }
.cover.dawn .brand { color: var(--night-900); }
.cover .brand svg { width: 30px; height: 30px; }

/* ------------------------------------------------------------------ spiral activity book, wire on the right */
.spiral { position: absolute; }
.spiral .sheet { position: absolute; inset: 0; border-radius: 6px 3px 3px 6px; background: #FFFDF8; box-shadow: 0 1px 2px rgba(22,32,74,.12); }
.spiral .sheet.s2 { transform: translate(-7px, 7px); background: #F6F0E3; }
.spiral .sheet.s3 { transform: translate(-13px, 13px); background: #ECE4D2; box-shadow: 0 18px 40px rgba(22,32,74,.22), 0 2px 6px rgba(22,32,74,.12); }
.spiral .front { position: absolute; inset: 0; border-radius: 6px 3px 3px 6px; overflow: hidden; background: #fff; }
.spiral .front img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
.spiral .front::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, rgba(255,255,255,.10), rgba(255,255,255,0) 45%, rgba(0,0,0,.05)); }
.spiral .wire { position: absolute; top: 0; bottom: 0; right: -12px; width: 40px; z-index: 3; }

.page-card { position: absolute; border-radius: 6px; overflow: hidden; background: #fff;
  box-shadow: 0 16px 36px rgba(22,32,74,.20), 0 2px 5px rgba(22,32,74,.10); }
.page-card img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }

/* photo slots (incoming images) */
.photo-frame { position: absolute; inset: 0; border-radius: 32px; overflow: hidden; box-shadow: 0 18px 44px rgba(22,32,74,.22); }
.photo-frame > img { width: 100%; height: 100%; object-fit: cover; }
.mock-cover { position: absolute; left: 0; top: 0; transform-origin: 0 0; mix-blend-mode: multiply; }
