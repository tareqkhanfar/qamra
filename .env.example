# Copy to .env and fill in. Never commit .env.

# ---- Brand (Addendum 1 — rename without touching code)
BRAND_NAME_AR=قمرة
BRAND_NAME_EN=Qamra
BRAND_DOMAIN=qamra.app

# ---- Stack (docker compose). Defaults work for local dev; set real secrets anywhere else.
QAMRA_ENV=dev
POSTGRES_PASSWORD=qamra
# openssl rand -hex 32  (required in prod)
JWT_SECRET=
# true behind HTTPS
COOKIE_SECURE=false
WEB_BASE_URL=http://localhost:3000
S3_ACCESS_KEY_ID=qamra-dev
S3_SECRET_ACCESS_KEY=qamra-dev-secret-change-me
# SSE-S3 (SeaweedFS supports it). On Cloudflare R2 set none: R2 encrypts every object at rest itself.
S3_SSE=AES256
# public entry (nginx "edge"). 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network
QAMRA_BIND=127.0.0.1
QAMRA_WEB_PORT=3000
# debug ports, always bound to 127.0.0.1
QAMRA_API_PORT=8000
QAMRA_PG_PORT=5433
QAMRA_REDIS_PORT=6380
QAMRA_S3_PORT=8333

# Encrypts admin-managed secrets (AI keys, SMTP password…) in the database. Required in prod.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEYS=

# NOTE: prices, contact details, AI keys/models, notifications and site switches are managed in the
# admin panel (/admin/settings), not here.

# ---- Tests: a database whose name ends in _test (compose creates qamra_test)
TEST_DATABASE_URL=postgresql+psycopg://qamra:qamra@127.0.0.1:5433/qamra_test

# ---- Observability (optional)
SENTRY_DSN=

# ---- CLI prototype only (scripts/prototype.py). The web app reads these from the admin panel.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

# Text (Claude)
TEXT_MODEL=claude-opus-5
TEXT_MODEL_FAST=claude-opus-5
TEXT_SERVER_FALLBACKS=true

# Images: gemini | flux | openai | fake
IMAGE_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K
FLUX_IMAGE_MODEL=fal-ai/flux-2-pro/edit
FLUX_IMAGE_PX=2048
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_PX=2048
IMAGE_CONCURRENCY=4
IMAGE_MAX_ATTEMPTS=3
PAGE_MAX_REGENERATIONS=1
